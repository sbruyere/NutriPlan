<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* @Assets fingerprinte l'URL : le navigateur recharge le CSS à chaque nouvelle version
       au lieu de servir une copie en cache. *@
    <link rel="stylesheet" href="@Assets["tailwind.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["NutriPlan.styles.css"]" />
    <ImportMap />
    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
    <link href="https://fonts.bunny.net/css?family=archivo:500,600,700,800|work-sans:400,500,600,700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* PWA : installable comme application (Android via le manifest, iOS via les meta Apple) *@
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#101315" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="NutriPlan" />
    <HeadOutlet />
</head>

<body class="bg-canvas text-gray-900 min-h-screen">
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <ReconnectModal />
    <script src="@Assets["site.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
