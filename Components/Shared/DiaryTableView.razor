@rendermode InteractiveServer
@inject DiaryService DiaryService

<div class="overflow-x-auto rounded-2xl border border-gray-200 shadow-sm bg-white">
    <table class="min-w-[900px] w-full text-sm border-collapse">
        <thead>
            <!-- Ligne 1 : groupes de colonnes -->
            <tr class="text-xs font-semibold text-gray-700">
                <th rowspan="2"
                    class="border border-gray-200 px-3 py-2 bg-orange-50 text-left align-bottom w-32">
                    Repas
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-orange-100 text-center" colspan="1">
                    Évaluer ses sensations
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-orange-500 text-white text-center" colspan="3">
                    Repas pris
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-amber-100 text-center" colspan="2">
                    Évaluation des sensations
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-blue-100 text-center">
                    Hydratation
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-purple-100 text-center">
                    Émotions&nbsp;/ Stress
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-green-100 text-center">
                    Sport&nbsp;/ Activité physique
                </th>
            </tr>
            <!-- Ligne 2 : sous-colonnes -->
            <tr class="text-xs text-gray-500">
                <th class="border border-gray-200 px-3 py-2 bg-orange-50 text-center align-top w-28">
                    De faim<br />
                    <span class="font-normal text-gray-400">(avant le repas)<br />de 1 à 10</span>
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-orange-50 text-center align-top">
                    Aliments ou préparations consommés
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-orange-50 text-center align-top w-32">
                    Quantité<br />
                    <span class="font-normal text-gray-400">(càc, càs, g, ¼ assiette…)</span>
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-orange-50 text-center align-top w-36">
                    Mode de préparation et/ou cuisson et/ou d'assaisonnement
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-amber-50 text-center align-top w-28">
                    De rassasiement<br />
                    <span class="font-normal text-gray-400">(après le repas)<br />de 1 à 10</span>
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-amber-50 text-center align-top w-40">
                    Perçues entre les repas<br />
                    <span class="font-normal text-gray-400">(inconfort digestif, nausée, gêne, ballonnements…)</span>
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-blue-50 text-center align-top w-32">
                    Eau, thé, tisanes, café, autre<br />
                    <span class="font-normal text-gray-400">(verres ou ml)</span>
                </th>
                <th class="border border-gray-200 px-3 py-2 bg-purple-50 align-top w-32"></th>
                <th class="border border-gray-200 px-3 py-2 bg-green-50 align-top w-32"></th>
            </tr>
        </thead>
        <tbody>
            @{
                var totalRows = MealDefinitions.Sum(m =>
                    Math.Max(1, DailyLog?.MealLogs.FirstOrDefault(ml => ml.MealType == m.Type)?.FoodEntries.Count ?? 0));
                var globalRow = 0;
            }

            @foreach (var mealDef in MealDefinitions)
            {
                var meal = DailyLog?.MealLogs.FirstOrDefault(m => m.MealType == mealDef.Type);
                var entries = meal?.FoodEntries.OrderBy(e => e.CreatedAt).ToList() ?? [];
                var mealRowCount = Math.Max(1, entries.Count);
                var mealType = mealDef.Type;

                @for (int rowIdx = 0; rowIdx < mealRowCount; rowIdx++)
                {
                    var ri = rowIdx;
                    var gri = globalRow;
                    var entry = ri < entries.Count ? entries[ri] : null;
                    var isFirstInMeal = ri == 0;
                    var isFirstInDay = gri == 0;
                    var isLastInDay = gri == totalRows - 1;

                    <tr class="hover:bg-gray-50 transition-colors @(isLastInDay ? "" : "")">

                        @* Repas (rowspan = nb lignes du repas) *@
                        @if (isFirstInMeal)
                        {
                            <td rowspan="@mealRowCount"
                                class="border border-gray-200 px-3 py-2 bg-orange-50 font-medium text-gray-700 text-xs align-top">
                                <div class="flex items-center gap-1">
                                    <span>@mealDef.Icon</span>
                                    <span>@mealDef.Label</span>
                                </div>
                            </td>

                            @* Faim avant (rowspan) *@
                            <td rowspan="@mealRowCount"
                                class="border border-gray-200 px-2 py-2 bg-orange-50/50 text-center align-middle">
                                <InlineScoreCell
                                    Value="@(meal?.HungerBefore)"
                                    OnChange="@(async v => await SetHunger(mealType, v))" />
                            </td>
                        }

                        @* Aliment *@
                        <td class="border border-gray-200 px-2 py-1.5 align-middle min-w-[140px]">
                            @if (entry != null)
                            {
                                <div class="flex items-center justify-between gap-1 group">
                                    <span class="text-gray-800 text-xs">@entry.FoodName</span>
                                    <button @onclick="async () => await DeleteEntry(entry.Id)"
                                            class="opacity-0 group-hover:opacity-100 text-red-400 hover:text-red-600 text-base leading-none transition-opacity flex-shrink-0">×</button>
                                </div>
                            }
                            @if (isFirstInMeal)
                            {
                                <button @onclick="() => OpenAddModal(mealType)"
                                        class="text-xs text-primary-500 hover:text-primary-700 mt-0.5 @(entries.Count > 0 ? "opacity-0 hover:opacity-100" : "") transition-opacity">
                                    + ajouter
                                </button>
                            }
                        </td>

                        @* Quantité *@
                        <td class="border border-gray-200 px-2 py-1.5 align-middle">
                            @if (entry != null)
                            {
                                <span class="text-xs text-gray-500">@entry.Quantity</span>
                            }
                        </td>

                        @* Mode de préparation *@
                        <td class="border border-gray-200 px-2 py-1.5 align-middle">
                            @if (entry != null)
                            {
                                <span class="text-xs text-gray-400 italic">@entry.PreparationMethod</span>
                            }
                        </td>

                        @if (isFirstInMeal)
                        {
                            @* Rassasiement après (rowspan) *@
                            <td rowspan="@mealRowCount"
                                class="border border-gray-200 px-2 py-2 bg-amber-50/50 text-center align-middle">
                                <InlineScoreCell
                                    Value="@(meal?.SatietyAfter)"
                                    OnChange="@(async v => await SetSatiety(mealType, v))" />
                            </td>

                            @* Sensations entre repas (rowspan) *@
                            <td rowspan="@mealRowCount"
                                class="border border-gray-200 px-2 py-2 bg-amber-50/30 align-top">
                                <InlineTextCell
                                    Value="@(meal?.BetweenMealSensations ?? "")"
                                    Placeholder="Inconfort, nausée…"
                                    OnSave="@(async v => await SetSensations(mealType, v))" />
                            </td>
                        }

                        @if (isFirstInDay)
                        {
                            @* Hydratation (rowspan jour entier) *@
                            <td rowspan="@totalRows"
                                class="border border-gray-200 px-2 py-2 bg-blue-50/40 align-top">
                                <InlineTextCell
                                    Value="@(DailyLog?.Hydration ?? "")"
                                    Placeholder="Ex: 6 verres, 1,5L…"
                                    OnSave="@(async v => await SetDayField("hydration", v))" />
                            </td>

                            @* Émotions / Stress (rowspan jour entier) *@
                            <td rowspan="@totalRows"
                                class="border border-gray-200 px-2 py-2 bg-purple-50/40 align-top">
                                <InlineTextCell
                                    Value="@(DailyLog?.Emotions ?? "")"
                                    Placeholder="Comment vous sentez-vous ?"
                                    OnSave="@(async v => await SetDayField("emotions", v))" />
                            </td>

                            @* Sport / Activité physique (rowspan jour entier) *@
                            <td rowspan="@totalRows"
                                class="border border-gray-200 px-2 py-2 bg-green-50/40 align-top">
                                <InlineTextCell
                                    Value="@(DailyLog?.PhysicalActivity ?? "")"
                                    Placeholder="Type, durée, intensité…"
                                    OnSave="@(async v => await SetDayField("sport", v))" />
                            </td>
                        }
                    </tr>

                    globalRow++;
                }
            }
        </tbody>
    </table>
</div>

@* Modal ajout aliment *@
@if (addModalMeal.HasValue)
{
    <div class="fixed inset-0 bg-black/40 flex items-end sm:items-center justify-center z-50 p-4">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-5">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-semibold text-gray-800">
                    Ajouter un aliment — @MealDefinitions.First(m => m.Type == addModalMeal).Label
                </h3>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-600 text-xl">×</button>
            </div>
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">Aliment ou préparation *</label>
                    <input @bind="newFood" type="text" placeholder="ex: Yaourt nature, Poulet rôti…"
                           class="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Quantité</label>
                        <input @bind="newQty" type="text" placeholder="ex: 200g, ½ assiette…"
                               class="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" />
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">Mode de préparation</label>
                        <input @bind="newPrep" type="text" placeholder="ex: Vapeur, Grillé…"
                               class="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(addError))
                {
                    <p class="text-red-500 text-xs">@addError</p>
                }
                <div class="flex gap-3 pt-1">
                    <button @onclick="CloseModal"
                            class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 py-2.5 rounded-xl text-sm font-medium transition-colors">
                        Annuler
                    </button>
                    <button @onclick="SubmitFood"
                            class="flex-1 bg-primary-600 hover:bg-primary-700 text-white py-2.5 rounded-xl text-sm font-medium transition-colors">
                        Ajouter
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public DailyLog? DailyLog { get; set; }
    [Parameter, EditorRequired] public int DiaryId { get; set; }
    [Parameter, EditorRequired] public DateOnly Date { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    static readonly (MealType Type, string Label, string Icon)[] MealDefinitions =
    [
        (MealType.PetitDejeuner,      "Petit-déjeuner",       "☕"),
        (MealType.CollationMatin,     "Collation matin",      "🍎"),
        (MealType.Dejeuner,           "Déjeuner",             "🍽️"),
        (MealType.CollationApresMidi, "Collation après-midi", "🫐"),
        (MealType.Diner,              "Dîner",                "🌙"),
        (MealType.CollationSoir,      "Collation soir",       "🌛"),
    ];

    MealType? addModalMeal;
    string newFood = "", newQty = "", newPrep = "", addError = "";

    void OpenAddModal(MealType type)
    {
        addModalMeal = type;
        newFood = newQty = newPrep = addError = "";
    }

    void CloseModal() => addModalMeal = null;

    async Task SubmitFood()
    {
        if (string.IsNullOrWhiteSpace(newFood)) { addError = "Champ obligatoire."; return; }
        var log = DailyLog ?? await DiaryService.GetOrCreateDailyLogAsync(DiaryId, Date);
        var meal = await DiaryService.GetOrCreateMealLogAsync(log.Id, addModalMeal!.Value);
        await DiaryService.AddFoodEntryAsync(meal.Id, new FoodEntry
        {
            FoodName = newFood.Trim(),
            Quantity = string.IsNullOrWhiteSpace(newQty) ? null : newQty.Trim(),
            PreparationMethod = string.IsNullOrWhiteSpace(newPrep) ? null : newPrep.Trim()
        });
        addModalMeal = null;
        await OnChanged.InvokeAsync();
    }

    async Task DeleteEntry(int id)
    {
        await DiaryService.DeleteFoodEntryAsync(id);
        await OnChanged.InvokeAsync();
    }

    async Task SetHunger(MealType type, int? value)
    {
        var log = DailyLog ?? await DiaryService.GetOrCreateDailyLogAsync(DiaryId, Date);
        var meal = await DiaryService.GetOrCreateMealLogAsync(log.Id, type);
        var current = DailyLog?.MealLogs.FirstOrDefault(m => m.MealType == type);
        await DiaryService.UpdateMealLogAsync(meal.Id, value, current?.SatietyAfter, current?.BetweenMealSensations);
        await OnChanged.InvokeAsync();
    }

    async Task SetSatiety(MealType type, int? value)
    {
        var log = DailyLog ?? await DiaryService.GetOrCreateDailyLogAsync(DiaryId, Date);
        var meal = await DiaryService.GetOrCreateMealLogAsync(log.Id, type);
        var current = DailyLog?.MealLogs.FirstOrDefault(m => m.MealType == type);
        await DiaryService.UpdateMealLogAsync(meal.Id, current?.HungerBefore, value, current?.BetweenMealSensations);
        await OnChanged.InvokeAsync();
    }

    async Task SetSensations(MealType type, string value)
    {
        var log = DailyLog ?? await DiaryService.GetOrCreateDailyLogAsync(DiaryId, Date);
        var meal = await DiaryService.GetOrCreateMealLogAsync(log.Id, type);
        var current = DailyLog?.MealLogs.FirstOrDefault(m => m.MealType == type);
        await DiaryService.UpdateMealLogAsync(meal.Id, current?.HungerBefore, current?.SatietyAfter, string.IsNullOrWhiteSpace(value) ? null : value);
        await OnChanged.InvokeAsync();
    }

    async Task SetDayField(string field, string value)
    {
        var log = DailyLog ?? await DiaryService.GetOrCreateDailyLogAsync(DiaryId, Date);
        var h = field == "hydration" ? value : (DailyLog?.Hydration ?? "");
        var e = field == "emotions" ? value : (DailyLog?.Emotions ?? "");
        var s = field == "sport" ? value : (DailyLog?.PhysicalActivity ?? "");
        await DiaryService.UpdateDailyLogSummaryAsync(log.Id, h, e, s, DailyLog?.GeneralNotes);
        await OnChanged.InvokeAsync();
    }
}
