@inject DiaryService DiaryService

@if (lightboxUrl != null)
{
    <div class="fixed inset-0 z-50 bg-black/85 flex items-center justify-center cursor-zoom-out print:hidden"
         role="dialog" aria-modal="true"
         @onclick="() => lightboxUrl = null">
        <img src="@lightboxUrl" alt="Photo du repas (agrandie)" class="max-w-[92vw] max-h-[90vh] object-contain rounded-2xl shadow-2xl" />
        <button class="absolute top-4 right-5 p-2 text-snow text-3xl opacity-70 hover:opacity-100"
                aria-label="Fermer la photo"
                @onclick="() => lightboxUrl = null">✕</button>
    </div>
}

@* En-tête visible uniquement à l'impression *@
<div class="hidden print:block mb-3">
    <p class="font-display text-base font-bold text-gray-900">NutriPlan — Journée du <span class="capitalize">@Date.ToString("dddd", FrCulture)</span> @Date.ToString("d MMMM yyyy", FrCulture)</p>
</div>

<div class="overflow-x-auto rounded-xl shadow-[0_1px_0_rgba(20,26,31,.06),0_10px_18px_-12px_rgba(20,26,31,.35)] bg-white print:overflow-visible print:border-0 print:shadow-none print:rounded-none">
<table class="w-full min-w-[700px] print:min-w-0 text-sm bg-white border-collapse" aria-label="Journal alimentaire du jour">
    <thead>
        <tr class="bg-carbon text-[9px] font-extrabold uppercase tracking-[.14em] text-[#8a949d] print:bg-white print:text-gray-400 print:border-b-2 print:border-gray-200">
            <th scope="col" class="px-4 py-2.5 text-left" style="width:200px">Repas / Activité</th>
            <th scope="col" class="px-2 py-2.5 text-center" style="width:52px" title="Faim avant le repas"><span aria-hidden="true">Faim</span><span class="sr-only">Faim avant le repas</span></th>
            <th scope="col" class="px-4 py-2.5 text-left">Aliments</th>
            <th scope="col" class="px-4 py-2.5 text-left" style="width:200px">Hydratation</th>
            <th scope="col" class="px-2 py-2.5 text-center" style="width:60px" title="Rassasiement après / durée"><span aria-hidden="true">Rass.</span><span class="sr-only">Rassasiement après / durée</span></th>
            <th scope="col" class="px-4 py-2.5 text-left" style="width:220px">Sensations / Émotions</th>
            <th scope="col" class="px-3 py-2.5 text-left" style="width:100px">Photos</th>
        </tr>
    </thead>
    <tbody>
        @for (int si = 0; si < DiaryService.MealSlots.Length; si++)
        {
            int slotIdx = si;
            var slot = DiaryService.MealSlots[slotIdx];
            var meal = GetMealSlotEvent(slotIdx);
            var concurrent = GetConcurrentActivities(slotIdx);
            bool isMain = slotIdx % 2 == 0;

            @if (isMain && slotIdx > 0)
            {
                <tr><td colspan="7" class="p-0 h-[2px] bg-[#dde3e9]"></td></tr>
            }

            <tr class="@MealRowBg(isMain) print:bg-white">
                <td class="py-3 px-4 align-top border-l-[3px] @(isMain ? "border-l-[#b9c1c9]" : "border-l-[#dde3e9]") print:border-l-0">
                    <div class="flex items-start gap-2">
                        @* Losange de la frise : volt = saisi, gris = jalon vide *@
                        <span class="w-1.5 h-1.5 rotate-45 mt-[6px] flex-shrink-0 @(meal != null ? "bg-volt print:bg-gray-500" : "bg-[#c3ccd4] print:bg-gray-300")" aria-hidden="true"></span>
                        <div>
                            @{
                                // Nom personnalisé saisi par le patient (ex. « Brunch ») sinon libellé du créneau.
                                var mealTitle = !string.IsNullOrWhiteSpace(meal?.Label) ? meal!.Label : slot.Label;
                            }
                            <span class="text-[8px] font-extrabold uppercase tracking-[.14em] text-gray-400 leading-none">@(isMain ? "Repas" : "Collation")</span>
                            <p class="@(isMain ? "font-display font-extrabold text-carbon text-sm" : "font-display font-bold text-[#4a545e] text-[13px]") leading-tight">@mealTitle</p>
                            @if (mealTitle != slot.Label)
                            {
                                <p class="text-[9px] text-gray-400 leading-none mt-0.5">(@slot.Label)</p>
                            }
                            <p class="text-[10.5px] text-gray-400 font-mono tabular-nums mt-0.5">@(meal?.Time?.ToString("HH:mm") ?? slot.DefaultTime.ToString("HH:mm"))</p>
                        </div>
                    </div>
                </td>
                <td class="px-2 py-3 text-center align-top">
                    @if (meal?.HungerBefore.HasValue == true)
                    { <span class="font-display text-sm font-extrabold text-carbon">@meal.HungerBefore</span><span class="text-[9px] text-gray-400">/10</span> }
                    else { <span class="text-gray-300" aria-hidden="true">—</span> }
                </td>
                <td class="px-4 py-3 align-top">
                    @if (meal == null)
                    { <span class="text-gray-400 text-xs italic">Aucune saisie.</span> }
                    else
                    { @FoodList(meal.FoodEntries) }
                </td>
                <td class="px-4 py-3 align-top">
                    @if (meal != null && meal.DrinkEntries.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1">
                            @foreach (var (dname, dcount) in DrinkGroups(meal.DrinkEntries))
                            {
                                <span class="bg-[#eff3f6] text-[#5b6570] text-[11px] font-semibold px-1.5 py-0.5 rounded-[5px] whitespace-nowrap print:bg-transparent print:px-0">
                                    💧 @(dcount > 1 ? $"{dcount}× " : "")@dname
                                </span>
                            }
                        </div>
                    }
                    else { <span class="text-gray-300 text-xs" aria-hidden="true">—</span> }
                </td>
                <td class="px-2 py-3 text-center align-top">
                    @if (meal?.SatietyAfter.HasValue == true)
                    { <span class="font-display text-sm font-extrabold text-carbon">@meal.SatietyAfter</span><span class="text-[9px] text-gray-400">/10</span> }
                    else { <span class="text-gray-300" aria-hidden="true">—</span> }
                </td>
                <td class="px-4 py-3 align-top">
                    @if (!string.IsNullOrEmpty(meal?.Sensations) || !string.IsNullOrEmpty(meal?.Emotions))
                    {
                        @if (!string.IsNullOrEmpty(meal?.Sensations))
                        { <p class="text-xs text-gray-600 leading-snug mb-0.5"><span class="font-bold text-[9px] uppercase tracking-[.08em] text-gray-400">Sensations </span>@meal.Sensations</p> }
                        @if (!string.IsNullOrEmpty(meal?.Emotions))
                        { <p class="text-xs text-gray-600 leading-snug"><span class="font-bold text-[9px] uppercase tracking-[.08em] text-gray-400">Émotions </span>@meal.Emotions</p> }
                    }
                    else { <span class="text-gray-300 text-xs" aria-hidden="true">—</span> }
                </td>
                <td class="px-3 py-3 align-top">
                    @if (meal?.Photos.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1">
                            @foreach (var ph in meal.Photos)
                            {
                                var p = ph;
                                <button type="button" @onclick="() => lightboxUrl = p.FilePath"
                                        aria-label="Agrandir la photo — @slot.Label" class="block rounded-lg">
                                    <img src="@p.FilePath" alt="Photo — @slot.Label"
                                         class="w-10 h-10 object-cover rounded-lg cursor-pointer hover:opacity-80 transition-opacity" />
                                </button>
                            }
                        </div>
                    }
                    else { <span class="text-gray-300 text-xs" aria-hidden="true">—</span> }
                </td>
            </tr>

            @foreach (var act in concurrent)
            {
                var a = act;
                <tr class="text-xs bg-[#f4f6f8] print:bg-white border-t border-[#e2e7ec]">
                    <td class="py-2 align-top border-l-[3px] border-l-[#9aa4ad] print:border-l-0" style="padding-left:2.5rem">
                        <div class="flex items-start gap-2">
                            <span class="text-gray-300 text-sm leading-none mt-0.5 flex-shrink-0" aria-hidden="true">└</span>
                            <div>
                                <div class="flex items-center gap-1.5 mb-0.5">
                                    <span class="bg-carbon text-volt text-[8px] font-extrabold uppercase tracking-[.12em] px-1.5 py-0.5 rounded-[4px] leading-none print:bg-transparent print:text-gray-500 print:px-0">Activité</span>
                                    @if (a.Time.HasValue) { <span class="text-gray-400 font-mono tabular-nums text-[10px]">@a.Time.Value.ToString("HH:mm")</span> }
                                </div>
                                <p class="font-display font-bold text-[#2a3138] leading-tight">@a.Label</p>
                                @if (a.DurationMinutes.HasValue || !string.IsNullOrEmpty(a.Intensity))
                                {
                                    <p class="text-[10px] text-[#5b6570] font-semibold mt-0.5">
                                        @if (a.DurationMinutes.HasValue) { @($"{a.DurationMinutes} min") }
                                        @if (!string.IsNullOrEmpty(a.Intensity)) { <span> · @a.Intensity</span> }
                                    </p>
                                }
                                @if (ActivityMetrics(a) is { Length: > 0 } cm)
                                {
                                    <p class="text-[10px] text-[#5b6570] font-semibold mt-0.5">@cm</p>
                                }
                            </div>
                        </div>
                    </td>
                    <td class="px-2 py-2 text-center text-gray-300 align-top"><span aria-hidden="true">—</span></td>
                    <td class="px-4 py-2 align-top">@FoodList(a.FoodEntries)</td>
                    <td class="px-4 py-2 align-top">
                        @if (a.DrinkEntries.Count > 0)
                        { <div class="flex flex-wrap gap-1">@foreach (var (dn, dc) in DrinkGroups(a.DrinkEntries)) { <span class="bg-[#eff3f6] text-[#5b6570] text-[11px] font-semibold px-1.5 py-0.5 rounded-[5px] print:bg-transparent print:px-0">💧 @(dc > 1 ? $"{dc}× " : "")@dn</span> }</div> }
                        else { <span class="text-gray-300" aria-hidden="true">—</span> }
                    </td>
                    <td class="px-2 py-2 align-top text-center text-gray-300"><span aria-hidden="true">—</span></td>
                    <td class="px-4 py-2 align-top">
                        @if (!string.IsNullOrEmpty(a.ActivityNotes)) { <p class="text-xs text-gray-500 leading-snug italic">@a.ActivityNotes</p> }
                        else { <span class="text-gray-300" aria-hidden="true">—</span> }
                    </td>
                    <td class="px-3 py-2 align-top">@ActivityPhotos(a)</td>
                </tr>
            }

            @foreach (var act in GetActivitiesAfterSlot(slotIdx))
            {
                var a = act;
                <tr class="text-xs border-t border-[#e2e7ec] bg-[#f4f6f8] print:bg-white">
                    <td class="px-4 py-2 align-top border-l-[3px] border-l-carbon print:border-l-0">
                        <div class="flex items-start gap-2">
                            <span class="w-1.5 h-1.5 rotate-45 mt-[5px] flex-shrink-0 bg-carbon print:bg-gray-500" aria-hidden="true"></span>
                            <div>
                                <span class="bg-carbon text-volt text-[8px] font-extrabold uppercase tracking-[.12em] px-1.5 py-0.5 rounded-[4px] leading-none inline-block print:bg-transparent print:text-gray-500 print:px-0">Activité</span>
                                <p class="font-display font-extrabold text-carbon text-sm leading-tight mt-0.5">@a.Label</p>
                                @if (a.Time.HasValue) { <p class="text-gray-400 font-mono tabular-nums text-[10.5px] mt-0.5">@a.Time.Value.ToString("HH:mm")</p> }
                                @if (ActivityMetrics(a) is { Length: > 0 } m)
                                {
                                    <p class="text-[10px] text-[#4a545e] font-bold mt-0.5">@m</p>
                                }
                            </div>
                        </div>
                    </td>
                    <td class="px-2 py-2 text-center text-gray-300 align-top"><span aria-hidden="true">—</span></td>
                    <td class="px-4 py-2 align-top">@FoodList(a.FoodEntries)</td>
                    <td class="px-4 py-2 align-top">
                        @if (a.DrinkEntries.Count > 0)
                        { <div class="flex flex-wrap gap-1">@foreach (var (dn, dc) in DrinkGroups(a.DrinkEntries)) { <span class="bg-[#eff3f6] text-[#5b6570] text-[11px] font-semibold px-1.5 py-0.5 rounded-[5px] print:bg-transparent print:px-0">💧 @(dc > 1 ? $"{dc}× " : "")@dn</span> }</div> }
                        else { <span class="text-gray-300" aria-hidden="true">—</span> }
                    </td>
                    <td class="px-2 py-2 align-top text-center">
                        @if (a.DurationMinutes.HasValue || !string.IsNullOrEmpty(a.Intensity))
                        {
                            <div class="text-xs">
                                @if (a.DurationMinutes.HasValue) { <p class="font-display font-extrabold text-carbon">@a.DurationMinutes min</p> }
                                @if (!string.IsNullOrEmpty(a.Intensity)) { <span class="inline-block mt-0.5 px-1.5 py-0.5 rounded-[4px] bg-[#eff3f6] text-[#5b6570] text-[10px] font-bold print:bg-transparent print:px-0">@a.Intensity</span> }
                            </div>
                        }
                        else { <span class="text-gray-300" aria-hidden="true">—</span> }
                    </td>
                    <td class="px-4 py-2 align-top">
                        @if (!string.IsNullOrEmpty(a.ActivityNotes)) { <p class="text-xs text-gray-600 leading-snug">@a.ActivityNotes</p> }
                        else { <span class="text-gray-300" aria-hidden="true">—</span> }
                    </td>
                    <td class="px-3 py-2 align-top">@ActivityPhotos(a)</td>
                </tr>
            }
        }
    </tbody>
    @if (HasSummary)
    {
        var log = DailyLog!;
        var allDrinks = AllDrinks();
        var drinkCount = allDrinks.Count;
        var hydrationMl = DiaryService.EstimateHydrationMl(allDrinks);
        var activityMin = TotalActivityMinutes();
        <tfoot>
            <tr class="bg-[#f7f9fb] print:bg-white border-t-2 border-[#dde3e9]">
                <td colspan="7" class="px-4 py-3">
                    <div class="flex flex-wrap gap-x-6 gap-y-1 text-xs text-gray-600">
                        @if (drinkCount > 0)
                        {
                            <span><span class="text-[9px] font-extrabold uppercase tracking-[.1em] text-gray-400">Hydratation </span><span class="font-display font-extrabold text-carbon">@FormatHydration(hydrationMl)</span> <span class="text-gray-400">(@drinkCount prise@(drinkCount > 1 ? "s" : ""))</span></span>
                        }
                        @if (activityMin > 0)
                        {
                            <span><span class="text-[9px] font-extrabold uppercase tracking-[.1em] text-gray-400">Activité </span><span class="font-display font-extrabold text-carbon">@FormatDuration(activityMin)</span></span>
                        }
                        @if (!string.IsNullOrWhiteSpace(log.Emotions))
                        {
                            <span><span class="text-[9px] font-extrabold uppercase tracking-[.1em] text-gray-400">Émotions </span>@log.Emotions</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(log.GeneralNotes))
                        {
                            <span><span class="text-[9px] font-extrabold uppercase tracking-[.1em] text-gray-400">Notes </span>@log.GeneralNotes</span>
                        }
                    </div>
                </td>
            </tr>
        </tfoot>
    }
</table>
</div>

@code {
    [Parameter, EditorRequired] public DailyLog? DailyLog { get; set; }
    [Parameter, EditorRequired] public int DiaryId { get; set; }
    [Parameter, EditorRequired] public DateOnly Date { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    string? lightboxUrl;

    static readonly System.Globalization.CultureInfo FrCulture = new("fr-FR");

    // ── Bilan de la journée (pied de tableau) ────────────────────────────────

    List<DrinkEntry> AllDrinks()
        => (DailyLog?.Events ?? []).SelectMany(e => e.DrinkEntries).ToList();

    int TotalActivityMinutes()
        => (DailyLog?.Events ?? [])
            .Where(e => e.EventType == DayEventType.Activity)
            .Sum(e => e.DurationMinutes ?? 0);

    bool HasSummary
        => DailyLog != null
           && (AllDrinks().Count > 0
               || TotalActivityMinutes() > 0
               || !string.IsNullOrWhiteSpace(DailyLog.Emotions)
               || !string.IsNullOrWhiteSpace(DailyLog.GeneralNotes));

    static string FormatHydration(int ml) => ml >= 1000
        ? string.Format(FrCulture, "≈ {0:0.#} L", ml / 1000.0)
        : $"≈ {ml} ml";

    static string FormatDuration(int minutes) => minutes >= 60
        ? $"{minutes / 60}h{minutes % 60:00}"
        : $"{minutes} min";

    DayEvent? GetMealSlotEvent(int slotIndex)
        => DailyLog?.Events.FirstOrDefault(e => e.MealSlot == slotIndex);

    // Affectation UNIQUE des activités autonomes : chaque activité est rattachée au
    // dernier jalon (trié par heure réelle) dont l'heure est ≤ la sienne. Contrairement
    // à un découpage par intervalles indépendants, aucune activité n'est dupliquée si
    // les heures des jalons ne sont pas monotones, ni masquée si elle n'a pas d'heure
    // (sans heure → premier jalon de la journée).
    Dictionary<int, List<DayEvent>> standaloneBuckets = [];

    protected override void OnParametersSet() => standaloneBuckets = BuildStandaloneBuckets();

    Dictionary<int, List<DayEvent>> BuildStandaloneBuckets()
    {
        var buckets = new Dictionary<int, List<DayEvent>>();
        var slotTimes = Enumerable.Range(0, DiaryService.MealSlots.Length)
            .Select(i => (SlotIdx: i, Time: GetMealSlotEvent(i)?.Time ?? DiaryService.MealSlots[i].DefaultTime))
            .OrderBy(s => s.Time)
            .ToList();
        var standalone = (DailyLog?.Events ?? [])
            .Where(e => e.EventType == DayEventType.Activity
                     && e.ActivityAfterSlot == null
                     && !e.ConcurrentWithMealSlot.HasValue);
        foreach (var act in standalone)
        {
            var target = slotTimes[0].SlotIdx;
            if (act.Time.HasValue)
            {
                foreach (var s in slotTimes)
                {
                    if (s.Time <= act.Time.Value) target = s.SlotIdx;
                    else break;
                }
            }
            if (!buckets.TryGetValue(target, out var list)) buckets[target] = list = [];
            list.Add(act);
        }
        return buckets;
    }

    IEnumerable<DayEvent> GetActivitiesAfterSlot(int slotIdx)
    {
        var linked = (DailyLog?.Events ?? [])
            .Where(e => e.EventType == DayEventType.Activity
                     && e.ActivityAfterSlot == slotIdx
                     && !e.ConcurrentWithMealSlot.HasValue);
        IEnumerable<DayEvent> standalone = standaloneBuckets.TryGetValue(slotIdx, out var list) ? list : [];
        return linked.Concat(standalone).OrderBy(e => e.Time).ThenBy(e => e.CreatedAt);
    }

    IReadOnlyList<DayEvent> GetConcurrentActivities(int slotIdx)
        => (DailyLog?.Events ?? [])
            .Where(e => e.EventType == DayEventType.Activity && e.ConcurrentWithMealSlot == slotIdx)
            .OrderBy(e => e.Time).ThenBy(e => e.CreatedAt)
            .ToList();

    RenderFragment FoodList(ICollection<FoodEntry> entries) => @<div>
        @{
            var ungrouped = entries.Where(f => string.IsNullOrEmpty(f.GroupName)).OrderBy(f => f.SortOrder).ThenBy(f => f.CreatedAt);
            @* Groupes et aliments dans l'ordre choisi par le patient (SortOrder), pas alphabétique. *@
            var groups = entries.Where(f => !string.IsNullOrEmpty(f.GroupName))
                .GroupBy(f => f.GroupName!).OrderBy(g => g.Min(f => f.SortOrder));
        }
        @if (!entries.Any())
        { <span class="text-gray-300 text-xs" aria-hidden="true">—</span> }
        else
        {
            <ul class="space-y-0.5">
                @foreach (var f in ungrouped)
                {
                    var qty = FormatQty(f);
                    <li class="flex items-baseline gap-1.5 text-xs text-gray-700 leading-snug">
                        <span class="text-gray-300 flex-shrink-0" aria-hidden="true">•</span>
                        <span class="font-medium">@f.FoodName</span>
                        @if (!string.IsNullOrEmpty(qty)) { <span class="text-gray-400">@qty</span> }
                        @if (!string.IsNullOrEmpty(f.PreparationMethod)) { <span class="text-gray-400 italic">@f.PreparationMethod</span> }
                    </li>
                }
            </ul>
            @foreach (var grp in groups)
            {
                <div class="mt-1">
                    <p class="text-xs font-semibold text-gray-500">🍽 @grp.Key</p>
                    <ul class="ml-3 space-y-0.5">
                        @foreach (var f in grp.OrderBy(x => x.SortOrder).ThenBy(x => x.CreatedAt))
                        {
                            var qty = FormatQty(f);
                            <li class="flex items-baseline gap-1.5 text-xs text-gray-600 leading-snug">
                                <span class="text-gray-300 flex-shrink-0" aria-hidden="true">└</span>
                                <span>@f.FoodName</span>
                                @if (!string.IsNullOrEmpty(qty)) { <span class="text-gray-400">@qty</span> }
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </div>;

    // Métriques d'activité saisies par le patient (ou importées de Strava).
    static string ActivityMetrics(DayEvent a)
    {
        var parts = new List<string>();
        if (a.CaloriesBurned is > 0) parts.Add($"−{a.CaloriesBurned} kcal");
        if (a.DistanceKm is > 0) parts.Add(string.Format(FrCulture, "{0:0.#} km", a.DistanceKm));
        if (a.ElevationM is > 0) parts.Add($"D+ {a.ElevationM} m");
        return string.Join(" · ", parts);
    }

    RenderFragment ActivityPhotos(DayEvent a) => @<div>
        @if (a.Photos.Count > 0)
        {
            <div class="flex flex-wrap gap-1">
                @foreach (var ph in a.Photos)
                {
                    var p = ph;
                    <button type="button" @onclick="() => lightboxUrl = p.FilePath"
                            aria-label="Agrandir la photo — @a.Label" class="block rounded-lg">
                        <img src="@p.FilePath" alt="Photo — @a.Label"
                             class="w-10 h-10 object-cover rounded-lg cursor-pointer hover:opacity-80 transition-opacity" />
                    </button>
                }
            </div>
        }
        else { <span class="text-gray-300 text-xs" aria-hidden="true">—</span> }
    </div>;

    static string FormatQty(FoodEntry f)
    {
        if (!string.IsNullOrEmpty(f.QuantityUnit))
            return string.Join(" ", new[] { f.Quantity, f.QuantityUnit }.Where(s => !string.IsNullOrEmpty(s)));
        return f.Quantity ?? "";
    }

    static IEnumerable<(string Name, int Count)> DrinkGroups(ICollection<DrinkEntry> entries) =>
        entries.GroupBy(d => d.DrinkName).Select(g => (g.Key, g.Count()));

    static string MealRowBg(bool isMain) => isMain ? "bg-white hover:bg-[#f7f9fb]" : "bg-[#fbfcfd] hover:bg-[#f4f6f8]";
}
