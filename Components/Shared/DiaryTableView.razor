@inject DiaryService DiaryService

<!-- Lightbox photo (niveau composant) -->
@if (lightboxUrl != null)
{
    <div class="fixed inset-0 z-50 bg-black/85 flex items-center justify-center cursor-zoom-out"
         @onclick="() => lightboxUrl = null">
        <img src="@lightboxUrl" class="max-w-[92vw] max-h-[90vh] object-contain rounded-2xl shadow-2xl" />
        <button class="absolute top-4 right-5 text-white text-3xl opacity-70 hover:opacity-100"
                @onclick="() => lightboxUrl = null">✕</button>
    </div>
}

<!-- Conteneur pleine largeur (full-bleed hors du max-w-4xl du layout) -->
<div class="shadow-sm border border-gray-100 rounded-2xl overflow-hidden bg-white"
     style="width:100vw;margin-left:calc(-50vw + 50%)">
<div class="overflow-x-auto">
<table class="w-full text-sm bg-white border-collapse">
    <thead>
        <tr class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-400 border-b-2 border-gray-100">
            <th class="px-4 py-3 text-left" style="width:200px">Repas / Activité</th>
            <th class="px-2 py-3 text-center" style="width:52px" title="Faim avant">Faim</th>
            <th class="px-4 py-3 text-left">Aliments</th>
            <th class="px-4 py-3 text-left" style="width:200px">Hydratation</th>
            <th class="px-2 py-3 text-center" style="width:60px" title="Rassasiement / Durée">Rass.</th>
            <th class="px-4 py-3 text-left" style="width:220px">Sensations / Émotions</th>
            <th class="px-3 py-3 text-left" style="width:100px">📷</th>
            <th class="px-2 py-3" style="width:52px"></th>
        </tr>
    </thead>
    <tbody>
        @for (int si = 0; si < DiaryService.MealSlots.Length; si++)
        {
            int slotIdx = si;
            var slot = DiaryService.MealSlots[slotIdx];
            var meal = GetMealSlotEvent(slotIdx);
            var concurrent = GetConcurrentActivities(slotIdx);
            bool isMain = slotIdx % 2 == 0; // 0=Petit-dej, 2=Déjeuner, 4=Dîner

            <!-- ── Séparateur épais avant chaque repas principal (sauf le 1er) ── -->
            @if (isMain && slotIdx > 0)
            {
                <tr>
                    <td colspan="8" class="p-0 h-1 bg-slate-300"></td>
                </tr>
            }

            <!-- ── Ligne repas / collation ─────────────────────────────── -->
            <tr class="transition-colors @MealRowBg(isMain, slotIdx)">
                <!-- Repas — avec accent gauche selon type -->
                <td class="py-3 px-4 align-top @(isMain ? "border-l-[6px] border-l-indigo-500 bg-indigo-50/50" : "border-l-[6px] border-l-orange-400 bg-orange-50")">
                    <div class="flex items-start gap-2">
                        <span class="text-xl mt-0.5 flex-shrink-0">@slot.Icon</span>
                        <div>
                            @if (isMain)
                            {
                                <span class="text-[9px] font-bold uppercase tracking-widest text-indigo-400 leading-none">Repas</span>
                                <p class="font-bold text-gray-800 text-sm leading-tight">@slot.Label</p>
                            }
                            else
                            {
                                <span class="text-[9px] font-bold uppercase tracking-widest text-orange-400 leading-none">Collation</span>
                                <p class="font-semibold text-gray-600 text-xs leading-tight">@slot.Label</p>
                            }
                            <p class="text-xs text-gray-400 font-mono mt-0.5">@(meal?.Time?.ToString("HH:mm") ?? slot.DefaultTime.ToString("HH:mm"))</p>
                        </div>
                    </div>
                </td>
                <!-- Faim -->
                <td class="px-2 py-3 text-center align-top">
                    @if (meal?.HungerBefore.HasValue == true)
                    {
                        <span class="inline-block px-1.5 py-0.5 rounded-md text-xs font-bold @ScoreBg(meal.HungerBefore.Value)">@meal.HungerBefore</span>
                    }
                    else { <span class="text-gray-200">—</span> }
                </td>
                <!-- Aliments -->
                <td class="px-4 py-3 align-top">
                    @if (meal == null)
                    {
                        <div class="flex items-center gap-2">
                            <span class="text-gray-300 text-xs italic">Aucune saisie.</span>
                            <button @onclick="() => StartMealSlot(slotIdx)"
                                    class="text-primary-600 hover:text-primary-800 text-xs border border-primary-200 hover:border-primary-400 px-2 py-0.5 rounded-lg transition-colors">
                                + Saisir
                            </button>
                        </div>
                    }
                    else
                    {
                        @FoodList(meal.FoodEntries)
                    }
                </td>
                <!-- Hydratation -->
                <td class="px-4 py-3 align-top">
                    @if (meal != null && meal.DrinkEntries.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1">
                            @foreach (var (dname, dcount) in DrinkGroups(meal.DrinkEntries))
                            {
                                <span class="bg-blue-50 text-blue-600 text-xs px-1.5 py-0.5 rounded-full whitespace-nowrap">
                                    @(dcount > 1 ? $"{dcount}× " : "")@dname
                                </span>
                            }
                        </div>
                    }
                    else { <span class="text-gray-200 text-xs">—</span> }
                </td>
                <!-- Rassasiement -->
                <td class="px-2 py-3 text-center align-top">
                    @if (meal?.SatietyAfter.HasValue == true)
                    {
                        <span class="inline-block px-1.5 py-0.5 rounded-md text-xs font-bold @ScoreBg(meal.SatietyAfter.Value)">@meal.SatietyAfter</span>
                    }
                    else { <span class="text-gray-200">—</span> }
                </td>
                <!-- Sensations / Émotions -->
                <td class="px-4 py-3 align-top">
                    @if (!string.IsNullOrEmpty(meal?.Sensations) || !string.IsNullOrEmpty(meal?.Emotions))
                    {
                        @if (!string.IsNullOrEmpty(meal?.Sensations))
                        {
                            <p class="text-xs text-amber-700 leading-snug mb-0.5">
                                <span class="font-medium text-amber-500">Sensations : </span>@meal.Sensations
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(meal?.Emotions))
                        {
                            <p class="text-xs text-purple-700 leading-snug">
                                <span class="font-medium text-purple-500">Émotions : </span>@meal.Emotions
                            </p>
                        }
                    }
                    else { <span class="text-gray-200 text-xs">—</span> }
                </td>
                <!-- Photos -->
                <td class="px-3 py-3 align-top">
                    @if (meal?.Photos.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1">
                            @foreach (var ph in meal.Photos)
                            {
                                var p = ph;
                                <img src="@p.FilePath" alt="Photo"
                                     class="w-10 h-10 object-cover rounded-lg border border-gray-100 cursor-pointer hover:opacity-80 transition-opacity"
                                     @onclick="() => lightboxUrl = p.FilePath" />
                            }
                        </div>
                    }
                    else { <span class="text-gray-200 text-xs">—</span> }
                </td>
                <!-- Actions -->
                <td class="px-2 py-3 text-center align-top">
                    @if (meal != null)
                    {
                        <button @onclick="() => ToggleExpand(slotIdx)"
                                class="text-gray-300 hover:text-primary-500 transition-colors text-sm leading-none"
                                title="@(expandedSlot == slotIdx ? "Replier" : "Modifier")">
                            @(expandedSlot == slotIdx ? "▲" : "▼")
                        </button>
                    }
                </td>
            </tr>

            <!-- ── Ligne d'édition expandée ───────────────────────────── -->
            @if (expandedSlot == slotIdx && meal != null)
            {
                <tr class="@(isMain ? "bg-indigo-50/50" : "bg-orange-50/60")">
                    <td colspan="8" class="px-6 py-4 @(isMain ? "border-l-[6px] border-l-indigo-500" : "border-l-[6px] border-l-orange-400")">
                        <EventCard Event="meal" ConcurrentActivities="@concurrent" OnChanged="Reload" OnDelete="DeleteEvent" />
                    </td>
                </tr>
            }

            <!-- ── Activités simultanées — sous-lignes visuellement liées au parent ── -->
            @foreach (var act in concurrent)
            {
                var a = act;
                <tr class="text-xs @ConcurrentRowBg(isMain) border-t @(isMain ? "border-indigo-100" : "border-orange-100")">
                    <!-- Cellule nom : indent + connecteur + badge sport -->
                    <td class="py-2 align-top border-l-[6px] @ConcurrentBorder(isMain)" style="padding-left:2.5rem">
                        <div class="flex items-start gap-2">
                            <span class="text-gray-300 text-sm leading-none mt-0.5 flex-shrink-0">└</span>
                            <div>
                                <div class="flex items-center gap-1.5 mb-0.5">
                                    <span class="bg-emerald-100 text-emerald-700 text-[9px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded leading-none">🏃 Sport</span>
                                    @if (a.Time.HasValue)
                                    {
                                        <span class="text-gray-400 font-mono text-[10px]">@a.Time.Value.ToString("HH:mm")</span>
                                    }
                                </div>
                                <p class="font-semibold text-gray-700 leading-tight">@a.Label</p>
                            </div>
                        </div>
                    </td>
                    <td class="px-2 py-2 text-center text-gray-200 align-top">—</td>
                    <td class="px-4 py-2 align-top">@FoodList(a.FoodEntries)</td>
                    <td class="px-4 py-2 align-top">
                        @if (a.DrinkEntries.Count > 0)
                        {
                            <div class="flex flex-wrap gap-1">
                                @foreach (var (dn, dc) in DrinkGroups(a.DrinkEntries))
                                { <span class="bg-blue-50 text-blue-600 text-xs px-1.5 py-0.5 rounded-full">@(dc > 1 ? $"{dc}× " : "")@dn</span> }
                            </div>
                        }
                        else { <span class="text-gray-200">—</span> }
                    </td>
                    <td class="px-2 py-2 align-top text-center">
                        @if (a.DurationMinutes.HasValue || !string.IsNullOrEmpty(a.Intensity))
                        {
                            <div class="text-xs">
                                @if (a.DurationMinutes.HasValue) { <p class="font-semibold text-emerald-700">@a.DurationMinutes min</p> }
                                @if (!string.IsNullOrEmpty(a.Intensity)) { <span class="inline-block mt-0.5 px-1 py-0.5 rounded @IntensityClass(a.Intensity)">@a.Intensity</span> }
                            </div>
                        }
                        else { <span class="text-gray-200">—</span> }
                    </td>
                    <td class="px-4 py-2 align-top">
                        @if (!string.IsNullOrEmpty(a.ActivityNotes))
                        { <p class="text-xs text-gray-500 leading-snug italic">@a.ActivityNotes</p> }
                        else { <span class="text-gray-200">—</span> }
                    </td>
                    <td class="px-3 py-2 align-top text-gray-200">—</td>
                    <td class="px-2 py-2 text-center align-top">
                        <button @onclick="() => DeleteEvent(a.Id)" class="text-gray-200 hover:text-red-400 text-base leading-none">×</button>
                    </td>
                </tr>
            }

            <!-- ── Activités sportives entre jalons ───────────────────── -->
            @foreach (var act in GetActivitiesAfterSlot(slotIdx))
            {
                var a = act;
                <tr class="text-xs border-t border-emerald-100 @(expandedActivity == a.Id ? "bg-emerald-100/60" : "bg-emerald-50/70 hover:bg-emerald-50")">
                    <td class="px-4 py-2 align-top border-l-[6px] border-l-emerald-500 bg-emerald-50/80">
                        <div class="flex items-center gap-2">
                            <span class="text-base">🏃</span>
                            <div>
                                <span class="text-[9px] font-bold uppercase tracking-widest text-emerald-500 leading-none">Sport</span>
                                <p class="font-semibold text-emerald-900 text-sm leading-tight">@a.Label</p>
                                @if (a.Time.HasValue) { <p class="text-emerald-500 font-mono text-xs mt-0.5">@a.Time.Value.ToString("HH:mm")</p> }
                            </div>
                        </div>
                    </td>
                    <td class="px-2 py-2 text-center text-gray-200 align-top">—</td>
                    <td class="px-4 py-2 align-top">@FoodList(a.FoodEntries)</td>
                    <td class="px-4 py-2 align-top">
                        @if (a.DrinkEntries.Count > 0)
                        {
                            <div class="flex flex-wrap gap-1">
                                @foreach (var (dn, dc) in DrinkGroups(a.DrinkEntries))
                                { <span class="bg-blue-50 text-blue-600 text-xs px-1.5 py-0.5 rounded-full">@(dc > 1 ? $"{dc}× " : "")@dn</span> }
                            </div>
                        }
                        else { <span class="text-gray-200">—</span> }
                    </td>
                    <td class="px-2 py-2 align-top text-center">
                        @if (a.DurationMinutes.HasValue || !string.IsNullOrEmpty(a.Intensity))
                        {
                            <div class="text-xs">
                                @if (a.DurationMinutes.HasValue) { <p class="font-semibold text-green-700">@a.DurationMinutes min</p> }
                                @if (!string.IsNullOrEmpty(a.Intensity)) { <span class="inline-block mt-0.5 px-1 py-0.5 rounded @IntensityClass(a.Intensity)">@a.Intensity</span> }
                            </div>
                        }
                        else { <span class="text-gray-200">—</span> }
                    </td>
                    <td class="px-4 py-2 align-top">
                        @if (!string.IsNullOrEmpty(a.ActivityNotes))
                        { <p class="text-xs text-gray-600 leading-snug">@a.ActivityNotes</p> }
                        else { <span class="text-gray-200">—</span> }
                    </td>
                    <td class="px-3 py-2 align-top text-gray-200">—</td>
                    <td class="px-2 py-2 text-center align-top">
                        <div class="flex flex-col gap-1 items-center">
                            <button @onclick="() => ToggleActivity(a.Id)" class="text-gray-300 hover:text-green-600 text-sm" title="Modifier">▼</button>
                            <button @onclick="() => DeleteEvent(a.Id)" class="text-gray-200 hover:text-red-400 text-base leading-none">×</button>
                        </div>
                    </td>
                </tr>
                @if (expandedActivity == a.Id)
                {
                    <tr class="bg-emerald-50/50">
                        <td colspan="8" class="px-6 py-4 border-l-[6px] border-l-emerald-500">
                            <EventCard Event="a" OnChanged="Reload" OnDelete="DeleteEvent" />
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</table>
</div>
</div>

@code {
    [Parameter, EditorRequired] public DailyLog? DailyLog { get; set; }
    [Parameter, EditorRequired] public int DiaryId { get; set; }
    [Parameter, EditorRequired] public DateOnly Date { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    int? expandedSlot;
    int? expandedActivity;
    string? lightboxUrl;

    void ToggleExpand(int slotIdx)
    {
        expandedSlot = expandedSlot == slotIdx ? null : slotIdx;
        expandedActivity = null;
    }

    void ToggleActivity(int actId)
    {
        expandedActivity = expandedActivity == actId ? null : actId;
        expandedSlot = null;
    }

    async Task StartMealSlot(int slotIdx)
    {
        var log = DailyLog ?? await DiaryService.GetOrCreateDailyLogAsync(DiaryId, Date);
        await DiaryService.GetOrCreateMealSlotEventAsync(log.Id, slotIdx);
        await OnChanged.InvokeAsync();
    }

    async Task AddActivity(int afterSlot)
    {
        var log = DailyLog ?? await DiaryService.GetOrCreateDailyLogAsync(DiaryId, Date);
        var act = await DiaryService.AddActivityAfterSlotAsync(log.Id, afterSlot);
        expandedActivity = act.Id;
        expandedSlot = null;
        await OnChanged.InvokeAsync();
    }

    async Task DeleteEvent(int eventId)
    {
        await DiaryService.DeleteEventAsync(eventId);
        expandedActivity = null;
        expandedSlot = null;
        await OnChanged.InvokeAsync();
    }

    async Task Reload() => await OnChanged.InvokeAsync();

    DayEvent? GetMealSlotEvent(int slotIndex)
        => DailyLog?.Events.FirstOrDefault(e => e.MealSlot == slotIndex);

    IEnumerable<DayEvent> GetActivitiesAfterSlot(int afterSlot)
        => (DailyLog?.Events ?? [])
            .Where(e => e.EventType == DayEventType.Activity
                     && e.ActivityAfterSlot == afterSlot
                     && !e.ConcurrentWithMealSlot.HasValue)
            .OrderBy(e => e.Time).ThenBy(e => e.CreatedAt);

    IReadOnlyList<DayEvent> GetConcurrentActivities(int slotIdx)
        => (DailyLog?.Events ?? [])
            .Where(e => e.EventType == DayEventType.Activity && e.ConcurrentWithMealSlot == slotIdx)
            .OrderBy(e => e.Time).ThenBy(e => e.CreatedAt)
            .ToList();

    RenderFragment FoodList(ICollection<FoodEntry> entries) => @<div>
        @{
            var ungrouped = entries.Where(f => string.IsNullOrEmpty(f.GroupName)).OrderBy(f => f.CreatedAt);
            var groups = entries.Where(f => !string.IsNullOrEmpty(f.GroupName))
                .GroupBy(f => f.GroupName!).OrderBy(g => g.Key);
        }
        @if (!entries.Any())
        {
            <span class="text-gray-200 text-xs">—</span>
        }
        else
        {
            <ul class="space-y-0.5">
                @foreach (var f in ungrouped)
                {
                    <li class="flex items-baseline gap-1.5 text-xs text-gray-700 leading-snug">
                        <span class="text-gray-300 flex-shrink-0">•</span>
                        <span class="font-medium">@f.FoodName</span>
                        @if (!string.IsNullOrEmpty(f.Quantity)) { <span class="text-gray-400">@f.Quantity</span> }
                        @if (!string.IsNullOrEmpty(f.PreparationMethod)) { <span class="text-gray-300 italic">@f.PreparationMethod</span> }
                    </li>
                }
            </ul>
            @foreach (var grp in groups)
            {
                <div class="mt-1">
                    <p class="text-xs font-semibold text-gray-500">🍽 @grp.Key</p>
                    <ul class="ml-3 space-y-0.5">
                        @foreach (var f in grp.OrderBy(x => x.CreatedAt))
                        {
                            <li class="flex items-baseline gap-1.5 text-xs text-gray-600 leading-snug">
                                <span class="text-gray-200 flex-shrink-0">└</span>
                                <span>@f.FoodName</span>
                                @if (!string.IsNullOrEmpty(f.Quantity)) { <span class="text-gray-400">@f.Quantity</span> }
                            </li>
                        }
                    </ul>
                </div>
            }
        }
    </div>;

    static IEnumerable<(string Name, int Count)> DrinkGroups(ICollection<DrinkEntry> entries) =>
        entries.GroupBy(d => d.DrinkName).Select(g => (g.Key, g.Count()));

    string MealRowBg(bool isMain, int slotIdx) => isMain
        ? (expandedSlot == slotIdx ? "bg-indigo-50" : "bg-white hover:bg-indigo-50/40")
        : (expandedSlot == slotIdx ? "bg-orange-100/60" : "bg-orange-50/70 hover:bg-orange-100/50");

    static string ConcurrentRowBg(bool isMain)  => isMain ? "bg-indigo-50/60"    : "bg-orange-50/80";
    static string ConcurrentBorder(bool isMain) => isMain ? "border-l-indigo-300" : "border-l-orange-300";

    static string ScoreBg(int s) => s switch
    {
        0     => "bg-gray-100 text-gray-600",
        <= 3  => "bg-green-100 text-green-700",
        <= 6  => "bg-amber-100 text-amber-700",
        _     => "bg-red-100 text-red-600"
    };

    static string IntensityClass(string s) => s switch
    {
        "Légère"  => "bg-green-100 text-green-700",
        "Modérée" => "bg-amber-100 text-amber-700",
        "Intense" => "bg-red-100 text-red-700",
        _         => "bg-gray-100 text-gray-600"
    };
}
