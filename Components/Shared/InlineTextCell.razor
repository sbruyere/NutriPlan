@rendermode InteractiveServer

<textarea @bind="current"
          @onblur="Save"
          rows="3"
          placeholder="@Placeholder"
          class="w-full text-xs text-gray-600 placeholder-gray-300 bg-transparent border-0 focus:outline-none focus:ring-1 focus:ring-primary-200 rounded-lg p-1 resize-none transition-all">
</textarea>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public EventCallback<string> OnSave { get; set; }

    string current = "";

    protected override void OnParametersSet() => current = Value;

    async Task Save() => await OnSave.InvokeAsync(current);
}
