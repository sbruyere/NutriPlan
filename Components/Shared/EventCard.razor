    async Task DropFoodOnFood(int targetFoodId)
    {
        if (pendingDragFoodId == 0 || pendingDragFoodId == targetFoodId) { pendingDragFoodId = 0; return; }
        var draggedId = pendingDragFoodId;
        pendingDragFoodId = 0;
        try { await DiaryService.MoveFoodBeforeAsync(draggedId, targetFoodId); await OnChanged.InvokeAsync(); }
        catch { Toast.ShowError(SaveErrorMessage); }
    }

