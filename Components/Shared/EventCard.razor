    // Teinte des chips par famille — repère visuel rapide dans le panneau
    static string DrinkChipClass(string group) => group switch
    {
        "Eaux"             => "bg-sky-50 text-sky-700 hover:bg-sky-100",
        "Cafés & chocolat" => "bg-amber-50 text-amber-800 hover:bg-amber-100",
        "Infusions"        => "bg-emerald-50 text-emerald-700 hover:bg-emerald-100",
        "Jus & sodas"      => "bg-orange-50 text-orange-700 hover:bg-orange-100",
        "Fermentés"        => "bg-purple-50 text-purple-700 hover:bg-purple-100",
        "Healthy"          => "bg-teal-50 text-teal-700 hover:bg-teal-100",
        "Alcool"           => "bg-rose-50 text-rose-700 hover:bg-rose-100",
        _                  => "bg-blue-50 text-blue-600 hover:bg-blue-100",
    };

    static readonly string[] PhysicalSensationChips =
    [
        "Aucune gêne", "Ballonnement", "Lourdeur", "Brûlures d'estomac",
        "Nausée", "Fatigue", "Énergie", "Légèreté", "Crampes",
    ];

    static readonly string[] EmotionChips =
    [
        "Bien", "Serein(e)", "Neutre", "Heureux/se",
        "Anxieux/se", "Stressé(e)", "Triste", "Coupable", "Frustré(e)",
    ];

    // Propositions : aliments favoris du carnet, SOUS la zone de saisie (ajout en un tap)
    RenderFragment? QuickFoodChips => QuickFoods.Count == 0 ? null : @<div class="mt-2">
        <p class="text-[9px] font-extrabold uppercase tracking-[.12em] text-gray-400 mb-1">Suggestions</p>
        <div class="flex flex-wrap gap-1">
            @foreach (var qf in QuickFoods) { var f = qf;
                <button type="button" @onclick="async () => await AddQuickFood(f)"
                        title="@($"Ajouter {f.FoodName} (utilisé {f.UseCount}×)")"
                        class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-primary-50 text-primary-700 text-[11px] font-medium hover:bg-primary-100 transition-colors">
                    <Icon Name="plus" Class="w-2.5 h-2.5" /><span>@f.FoodName</span>
                    @if (!string.IsNullOrEmpty(f.Quantity)) { <span class="text-primary-400">@f.Quantity @f.QuantityUnit</span> }
                </button>
            }
        </div>
    </div>;

    // Photos : vignettes réorganisables + upload + lightbox — partagé repas/activités.
    RenderFragment PhotosEditor => @<div class="mt-2 pt-2 border-t border-slate-50">
        @if (photos.Count > 0)
        {
            <div class="flex flex-wrap gap-1.5 mb-1.5">
                @foreach (var photo in photos) { var ph = photo;
                    <div class="relative" @key="ph.Id">
                        <button type="button" @onclick="() => lightboxUrl = ph.FilePath" aria-label="Agrandir la photo" class="block rounded-lg">
                            <img src="@ph.FilePath" alt="Photo"
                                 class="w-16 h-16 object-cover rounded-lg cursor-pointer hover:opacity-90 transition-opacity" />
                        </button>
                        <button @onclick="() => DeletePhoto(ph.Id)" aria-label="Supprimer la photo"
                                class="absolute -top-1.5 -right-1.5 bg-red-500 hover:bg-red-600 text-snow rounded-full w-5 h-5 text-[11px] leading-none flex items-center justify-center">×</button>
                        <button @onclick="async () => await MovePhoto(ph.Id, -1)" aria-label="Avancer la photo"
                                class="absolute bottom-0.5 left-0.5 bg-black/50 hover:bg-black/75 text-snow rounded w-4 h-4 text-[10px] leading-none flex items-center justify-center">‹</button>
                        <button @onclick="async () => await MovePhoto(ph.Id, 1)" aria-label="Reculer la photo"
                                class="absolute bottom-0.5 right-0.5 bg-black/50 hover:bg-black/75 text-snow rounded w-4 h-4 text-[10px] leading-none flex items-center justify-center">›</button>
                    </div>
                }
            </div>
        }
        @if (lightboxUrl != null)
        {
            <div class="fixed inset-0 z-50 bg-black/85 flex items-center justify-center cursor-zoom-out"
                 @onclick="() => lightboxUrl = null">
                <img src="@lightboxUrl" class="max-w-[92vw] max-h-[90vh] object-contain rounded-xl shadow-2xl" />
                <button class="absolute top-4 right-5 text-snow text-3xl leading-none opacity-70 hover:opacity-100 transition-opacity p-2 -m-2"
                        aria-label="Fermer l'aperçu de la photo"
                        @onclick="() => lightboxUrl = null">✕</button>
            </div>
        }
        @if (uploadError != null) { <p role="alert" class="text-red-500 text-[11px] mb-1">@uploadError</p> }
        <label class="inline-flex items-center gap-1.5 cursor-pointer px-3 py-1.5 bg-gray-50 hover:bg-gray-100 rounded-full text-xs font-medium text-gray-500 hover:text-gray-700 transition-colors">
            <Icon Name="camera" Class="w-3.5 h-3.5" /> Photo
            <InputFile OnChange="UploadPhoto" accept="image/*" multiple class="hidden" />
        </label>
    </div>;

    // Options d'unité (partagé entre les formulaires)
    static RenderFragment UnitOptions => @<text>
        <option value="">u.</option>
        <option value="g">g</option><option value="kg">kg</option>
        <option value="ml">ml</option><option value="cl">cl</option><option value="L">L</option>
        <option value="pièce(s)">pc</option><option value="tranche(s)">tr.</option>
        <option value="poignée">poignée</option><option value="pot">pot</option>
        <option value="portion">port.</option><option value="bol">bol</option>
        <option value="verre">verre</option><option value="tasse">tasse</option>
        <option value="c. à café">c.c.</option><option value="c. à soupe">c.s.</option>
        <option value="pincée">pincée</option>
    </text>;

    // ── État local commun ────────────────────────────────────────────────────
    string labelEdit = "";
    string timeEdit = "";
    List<FoodEntry> foods = [];
    string newFoodName = "", newFoodQtyVal = "", newFoodQtyUnit = "g", newFoodPrep = "";

    bool showAddFoodForm;
    bool showAddCompoForm;
    string? addingToCompoName;
    string? pendingCompoName;
    string newCompoName = "";

    List<DrinkEntry> drinks = [];
    string customDrinkName = "";

    // ── Panneaux contextuels (un seul ouvert à la fois) ─────────────────────
    const string PanelEmotions = "emotions", PanelSensations = "sensations",
                 PanelDrinks = "drinks", PanelSport = "sport";
    string? openPanel;

    // Confirmation en deux étapes avant la suppression du jalon
    bool confirmingDelete;

    // Message affiché lorsqu'une sauvegarde échoue
    const string SaveErrorMessage = "Enregistrement impossible — vérifiez votre connexion.";

    // ── État local repas ─────────────────────────────────────────────────────
    int? hungerBefore;
    int? satietyAfter;
    string? sensations;
    string? emotions;
    List<MealPhoto> photos = [];
    string? uploadError;
    string? lightboxUrl;

    // ── État local activité ──────────────────────────────────────────────────
    int? durationMinutes;
    string? intensity;
    int? caloriesBurned;
    double? distanceKm;
    int? elevationM;
    string? activityNotes;
    string customSportName = "";

    // ── Édition inline d'aliments ────────────────────────────────────────────
    int? editingFoodId;
    string editFoodName  = "";
    string editFoodQtyVal = "";
    string editFoodUnit  = "";
    string editFoodGroup = "";  // "" = aucune composition

    // ── Drag & drop aliments (état non rendu → pas de re-render visuel) ──────
    int pendingDragFoodId; // 0 = aucun

    // ── Propriétés calculées ─────────────────────────────────────────────────
    // `foods` est déjà trié (SortOrder) : Where/GroupBy préservent l'ordre,
    // et les préparations apparaissent à la position de leur premier aliment.
    IEnumerable<FoodEntry> UngroupedFoods =>
        foods.Where(f => string.IsNullOrEmpty(f.GroupName));
    IEnumerable<IGrouping<string, FoodEntry>> GroupedFoods =>
        foods.Where(f => !string.IsNullOrEmpty(f.GroupName)).GroupBy(f => f.GroupName!);
    IEnumerable<(string Name, int Count, List<DrinkEntry> Entries)> DrinkGroups =>
        drinks.GroupBy(d => d.DrinkName)
              .Select(g => (g.Key, g.Count(), g.OrderBy(d => d.CreatedAt).ToList()));

    // Compositions proposées dans le sélecteur d'édition : groupes existants
    // + groupe actuel de l'aliment édité (par sécurité s'il n'apparaît plus).
    List<string> EditGroupOptions()
    {
        var names = GroupedFoods.Select(g => g.Key).ToList();
        var current = foods.FirstOrDefault(f => f.Id == editingFoodId)?.GroupName;
        if (!string.IsNullOrEmpty(current) && !names.Contains(current)) names.Add(current);
        return names;
    }

    int IntensityTicks => intensity switch { "Légère" => 1, "Modérée" => 2, "Intense" => 3, _ => 0 };

    string SensationSummary => ChipSummary(sensations);
    string EmotionSummary   => ChipSummary(emotions);

    static string ChipSummary(string? val)
    {
        var items = (val ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return items.Length switch { 0 => "—", 1 => items[0], _ => $"{items[0]} +{items.Length - 1}" };
    }

    static string FormatQty(FoodEntry f)
    {
        // Nouvelle donnée : qty + unit séparés
        if (!string.IsNullOrEmpty(f.QuantityUnit))
            return string.Join(" ", new[] { f.Quantity, f.QuantityUnit }.Where(s => !string.IsNullOrEmpty(s)));
        // Ancienne donnée : qty stockée comme "150 g" ou "2 pièce(s)"
        return f.Quantity ?? "";
    }

    protected override void OnParametersSet()
    {
        labelEdit = Event.Label;
        timeEdit = Event.Time?.ToString("HH:mm") ?? "";
        hungerBefore = Event.HungerBefore;
        satietyAfter = Event.SatietyAfter;
        sensations = Event.Sensations;
        emotions = Event.Emotions;
        durationMinutes = Event.DurationMinutes;
        intensity = Event.Intensity;
        caloriesBurned = Event.CaloriesBurned;
        distanceKm = Event.DistanceKm;
        elevationM = Event.ElevationM;
        activityNotes = Event.ActivityNotes;
        foods = Event.FoodEntries.OrderBy(f => f.SortOrder).ThenBy(f => f.CreatedAt).ThenBy(f => f.Id).ToList();
        drinks = Event.DrinkEntries.OrderBy(d => d.SortOrder).ThenBy(d => d.CreatedAt).ThenBy(d => d.Id).ToList();
        photos = Event.Photos.OrderBy(p => p.SortOrder).ThenBy(p => p.CreatedAt).ThenBy(p => p.Id).ToList();
    }

    // ── Sauvegardes ──────────────────────────────────────────────────────────

    async Task SaveLabel()
    {
        if (string.IsNullOrWhiteSpace(labelEdit)) labelEdit = Event.Label;
        await Save();
    }

    async Task SaveTime(ChangeEventArgs e)
    {
        timeEdit = e.Value?.ToString() ?? "";
        await Save();
        await OnChanged.InvokeAsync();
    }

    async Task SetHunger(int? score) { hungerBefore = score; await Save(); }
    async Task SetSatiety(int? score) { satietyAfter = score; await Save(); }

    // Sliders : @oninput met à jour l'affichage pendant le glissement,
    // @onchange (relâchement) persiste la valeur.
    void PreviewHunger(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) hungerBefore = v; }
    async Task CommitHunger(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) await SetHunger(v); }
    void PreviewSatiety(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) satietyAfter = v; }
    async Task CommitSatiety(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out var v)) await SetSatiety(v); }
    async Task SetIntensity(string opt) { intensity = intensity == opt ? null : opt; await Save(); }
    async Task SaveActivityFields() => await Save();
    async Task SelectSport(string sport) { labelEdit = sport; await Save(); }
    async Task SelectCustomSport() { if (!string.IsNullOrWhiteSpace(customSportName)) { labelEdit = customSportName.Trim(); customSportName = ""; await Save(); } }

    // ── Panneaux contextuels (ouverture au clic, un seul à la fois) ──────────
    void TogglePanel(string panel) => openPanel = openPanel == panel ? null : panel;
    void ClosePanel() => openPanel = null;

    async Task Save()
    {
        try
        {
            await DiaryService.UpdateEventAsync(Event.Id, labelEdit, ParseTime(timeEdit),
                hungerBefore, satietyAfter, sensations, emotions,
                durationMinutes, intensity, activityNotes, caloriesBurned, distanceKm, elevationM);
            Event.Label = labelEdit; Event.Time = ParseTime(timeEdit);
            Event.HungerBefore = hungerBefore; Event.SatietyAfter = satietyAfter;
            Event.Sensations = sensations; Event.Emotions = emotions;
            Event.DurationMinutes = durationMinutes; Event.Intensity = intensity; Event.ActivityNotes = activityNotes;
            Event.CaloriesBurned = caloriesBurned; Event.DistanceKm = distanceKm; Event.ElevationM = elevationM;
            Toast.ShowSaved();
        }
        catch { Toast.ShowError(SaveErrorMessage); }
    }

    // ── Handle de drag (jalon) ────────────────────────────────────────────────
    async Task HandleCardDragStart() { if (OnCardDragStart.HasDelegate) await OnCardDragStart.InvokeAsync(); }
    async Task HandleCardDragEnd()   { if (OnCardDragEnd.HasDelegate)   await OnCardDragEnd.InvokeAsync(); }

    // ── Aliments — ajout ─────────────────────────────────────────────────────

    async Task AddFood()
    {
        if (string.IsNullOrWhiteSpace(newFoodName)) return;
        var groupName = addingToCompoName ?? pendingCompoName;
        var qty = string.IsNullOrWhiteSpace(newFoodQtyVal) ? null : newFoodQtyVal.Trim();
        try
        {
            var entry = await DiaryService.AddFoodEntryAsync(Event.Id, newFoodName.Trim(),
                qty,
                // Pas d'unité orpheline : l'unité n'est enregistrée qu'avec une quantité.
                qty == null || string.IsNullOrWhiteSpace(newFoodQtyUnit) ? null : newFoodQtyUnit.Trim(),
                string.IsNullOrWhiteSpace(newFoodPrep) ? null : newFoodPrep.Trim(),
                groupName,
                FindCatalogByName(newFoodName)?.Id);
            foods.Add(entry);
            Event.FoodEntries.Add(entry); // garde le graphe parent cohérent (OnParametersSet relit Event)
            if (pendingCompoName != null) { addingToCompoName = pendingCompoName; pendingCompoName = null; }
            newFoodName = newFoodQtyVal = newFoodPrep = "";
            newFoodQtyUnit = "g";
            // Le formulaire reste ouvert : saisie en chaîne (nom, Entrée, nom, Entrée…).
            Toast.ShowSaved();
        }
        catch { Toast.ShowError(SaveErrorMessage); }
    }

    // Ajout en un tap d'un aliment favori (avec sa dernière quantité/préparation).
    async Task AddQuickFood(DiaryService.FrequentFood f)
    {
        var groupName = addingToCompoName ?? pendingCompoName;
        try
        {
            var entry = await DiaryService.AddFoodEntryAsync(Event.Id, f.FoodName,
                f.Quantity, f.QuantityUnit, f.PreparationMethod, groupName,
                FindCatalogByName(f.FoodName)?.Id);
            foods.Add(entry);
            Event.FoodEntries.Add(entry);
            if (pendingCompoName != null) { addingToCompoName = pendingCompoName; pendingCompoName = null; }
            Toast.ShowSaved();
        }
        catch { Toast.ShowError(SaveErrorMessage); }
    }

    // Ajout en un tap d'une composition favorite, avec toutes ses composantes.
    async Task AddQuickComposition(DiaryService.FrequentComposition compo)
    {
        try
        {
            var entries = await DiaryService.AddCompositionAsync(Event.Id, compo.Name, compo.Items);
            foods.AddRange(entries);
            foreach (var entry in entries) Event.FoodEntries.Add(entry);
            showAddCompoForm = false;
            Toast.ShowSaved();
        }
        catch { Toast.ShowError(SaveErrorMessage); }
    }

    void CreateComposition()
    {
        if (string.IsNullOrWhiteSpace(newCompoName)) return;
        pendingCompoName = newCompoName.Trim();
        newCompoName = "";
        showAddCompoForm = false;
        addingToCompoName = null;
    }

    void StartAddFoodToCompo(string compoName)
    {
        addingToCompoName = compoName;
        showAddFoodForm = false;
        showAddCompoForm = false;
        pendingCompoName = null;
        editingFoodId = null;
        newFoodName = newFoodQtyVal = newFoodPrep = "";
        newFoodQtyUnit = "g";
    }

    void CancelAddCompo() { showAddCompoForm = false; pendingCompoName = null; newCompoName = ""; }
    void OnCompoKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") CreateComposition(); }

    async Task DeleteFood(int id)
    {
        try
        {
            await DiaryService.DeleteFoodEntryAsync(id);
            foods.RemoveAll(f => f.Id == id);
            if (Event.FoodEntries.FirstOrDefault(f => f.Id == id) is { } fe) Event.FoodEntries.Remove(fe);
            if (editingFoodId == id) editingFoodId = null;
            Toast.ShowSaved();
        }
        catch { Toast.ShowError(SaveErrorMessage); }
    }

    async Task DeleteGroup(string groupName)
    {
        try
        {
            var toDelete = foods.Where(f => f.GroupName == groupName).ToList();
            foreach (var food in toDelete)
            {
                await DiaryService.DeleteFoodEntryAsync(food.Id);
                foods.Remove(food);
                Event.FoodEntries.Remove(food);
            }
            if (addingToCompoName == groupName) addingToCompoName = null;
            Toast.ShowSaved();
        }
        catch { Toast.ShowError(SaveErrorMessage); }
    }


    // ── Aliments — édition inline ─────────────────────────────────────────────

    void StartEditFood(FoodEntry f)
    {
        editingFoodId = f.Id;
        editFoodName  = f.FoodName;
        editFoodGroup = f.GroupName ?? "";
        // Précharger la quantité et l'unité
        if (!string.IsNullOrEmpty(f.QuantityUnit))
        {
            editFoodQtyVal = f.Quantity ?? "";
            editFoodUnit   = f.QuantityUnit;
        }
        else
        {
            // ancienne donnée combinée "150 g" → séparer
            var parts = (f.Quantity ?? "").Trim().Split(' ', 2);
            editFoodQtyVal = parts.Length >= 1 ? parts[0] : "";
            editFoodUnit   = parts.Length == 2 ? parts[1] : "";
        }
        addingToCompoName = null;
        showAddFoodForm = false;
        showAddCompoForm = false;
    }

    async Task SaveFoodEdit()
    {
        if (editingFoodId == null) return;
        var food = foods.FirstOrDefault(f => f.Id == editingFoodId);
        if (food == null) { editingFoodId = null; return; }
        var name  = string.IsNullOrWhiteSpace(editFoodName) ? food.FoodName : editFoodName.Trim();
        var qty   = string.IsNullOrWhiteSpace(editFoodQtyVal) ? null : editFoodQtyVal.Trim();
        // Pas d'unité orpheline : l'unité n'est conservée qu'avec une quantité.
        var unit  = qty == null || string.IsNullOrWhiteSpace(editFoodUnit) ? null : editFoodUnit.Trim();
        var group = string.IsNullOrWhiteSpace(editFoodGroup)  ? null : editFoodGroup;
        try
        {
            await DiaryService.UpdateFoodEntryAsync(food.Id, name, qty, unit, group);
            food.FoodName = name;
            food.Quantity = qty;
            food.QuantityUnit = unit;
            food.GroupName = group;
            editingFoodId = null;
            Toast.ShowSaved();
        }
        catch { Toast.ShowError(SaveErrorMessage); }
    }

    void CancelFoodEdit() { editingFoodId = null; }

    async Task OnEditFoodKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveFoodEdit();
        else if (e.Key == "Escape") CancelFoodEdit();
    }

