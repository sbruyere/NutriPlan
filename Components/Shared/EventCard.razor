    // Boissons proposées, groupées par famille (libellé affiché en tête de groupe)
    static readonly (string Group, string[] Drinks)[] QuickDrinkGroups =
    [
        ("Eaux",              ["Eau (1 verre)", "Eau (75cl)", "Eau (1,5L)", "Eau gazeuse"]),
        ("Cafés & chocolat",  ["Café expresso", "Café allongé", "Chocolat chaud"]),
        ("Infusions",         ["Thé (grande tasse)", "Infusion", "Matcha"]),
        ("Jus & sodas",       ["Jus de fruit", "Sirop", "Coca-Cola"]),
        ("Fermentés",         ["Kéfir", "Kombucha"]),
        ("Healthy",           ["Lait", "Smoothie", "Boisson isotonique", "Électrolytes"]),
        ("Alcool",            ["Bière", "Vin rouge", "Vin rosé", "Vin blanc"]),
