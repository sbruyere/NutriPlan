    async Task DropFoodOnGroup(string? groupName)
    {
        if (pendingDragFoodId == 0) return;
        var food = foods.FirstOrDefault(f => f.Id == pendingDragFoodId);
        pendingDragFoodId = 0;
        if (food == null || food.GroupName == groupName) return;
        try
        {
            await DiaryService.UpdateFoodEntryAsync(food.Id, food.FoodName, food.Quantity, food.QuantityUnit, groupName);
            food.GroupName = groupName;
            Toast.ShowSaved();
        }
        catch { Toast.ShowError(SaveErrorMessage); }
    }

