    static TimeOnly? ParseTime(string val) =>
        string.IsNullOrEmpty(val) ? null : TimeOnly.TryParse(val, out var t) ? t : null;

    static string ScorePillClass(int s) => s switch
    {
        0    => "bg-gray-100 text-gray-600",
        <= 3 => "bg-green-100 text-green-700",
        <= 6 => "bg-amber-100 text-amber-700",
        _    => "bg-red-100 text-red-600"
    };

    static string IntensityActive(string s) => s switch
    {
        "Légère"  => "bg-green-100 text-green-700",
        "Modérée" => "bg-amber-100 text-amber-700",
        "Intense" => "bg-red-100 text-red-700",
        _         => "bg-gray-100 text-gray-700"
    };
