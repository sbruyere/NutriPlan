@rendermode InteractiveServer

@if (!isOpen)
{
    <button @onclick="() => isOpen = true"
            class="@(Value.HasValue ? ScoreColor(Value.Value) : "text-gray-300 hover:text-gray-500") text-sm font-semibold w-full h-full min-h-[2rem] rounded-lg transition-colors">
        @(Value.HasValue ? Value.Value.ToString() : "—")
    </button>
}
else
{
    <div class="flex flex-wrap gap-1 justify-center">
        @for (int i = 1; i <= 10; i++)
        {
            var score = i;
            <button @onclick="() => Select(score)"
                    class="w-6 h-6 rounded text-xs font-semibold transition-colors @(Value == score ? ActiveColor(score) : "bg-gray-100 text-gray-500 hover:bg-gray-200")">
                @score
            </button>
        }
        <button @onclick="Clear" class="text-xs text-gray-300 hover:text-red-400 transition-colors mt-0.5 w-full">
            effacer
        </button>
    </div>
}

@code {
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> OnChange { get; set; }

    bool isOpen;

    async Task Select(int v)
    {
        Value = v;
        isOpen = false;
        await OnChange.InvokeAsync(v);
    }

    async Task Clear()
    {
        Value = null;
        isOpen = false;
        await OnChange.InvokeAsync(null);
    }

    string ScoreColor(int v) => v switch
    {
        <= 3 => "text-green-600 bg-green-50 rounded-lg",
        <= 6 => "text-amber-600 bg-amber-50 rounded-lg",
        _ => "text-red-500 bg-red-50 rounded-lg"
    };

    string ActiveColor(int v) => v switch
    {
        <= 3 => "bg-green-500 text-white",
        <= 6 => "bg-amber-400 text-white",
        _ => "bg-red-400 text-white"
    };
}
