@rendermode InteractiveServer
@inject DiaryService DiaryService

@if (logs == null)
{
    <div class="text-gray-400 text-center py-8">Chargement de l'historique…</div>
}
else if (logs.Count == 0)
{
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 text-center">
        <div class="text-4xl mb-3">📅</div>
        <p class="text-gray-400">Aucune entrée dans votre historique pour le moment.</p>
    </div>
}
else
{
    <div class="space-y-3">
        @foreach (var log in logs)
        {
            var entryCount = log.MealLogs.Sum(m => m.FoodEntries.Count);
            var mealsWithFood = log.MealLogs.Where(m => m.FoodEntries.Count > 0).ToList();
            var allFoods = log.MealLogs.SelectMany(m => m.FoodEntries).ToList();

            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden cursor-pointer hover:border-primary-200 transition-colors"
                 @onclick="() => OnDateSelected.InvokeAsync(log.Date)">
                <div class="px-4 py-3 flex items-center justify-between">
                    <div>
                        <p class="font-medium text-gray-800 capitalize">
                            @log.Date.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))
                        </p>
                        <p class="text-xs text-gray-400 mt-0.5">
                            @entryCount aliment(s) · @mealsWithFood.Count repas
                        </p>
                    </div>
                    <div class="flex flex-wrap gap-1 justify-end max-w-[160px]">
                        @foreach (var meal in mealsWithFood)
                        {
                            <span class="text-base" title="@MealLabel(meal.MealType)">@MealIcon(meal.MealType)</span>
                        }
                    </div>
                </div>
                @if (allFoods.Count > 0)
                {
                    <div class="px-4 pb-3">
                        <p class="text-xs text-gray-400 truncate">
                            @string.Join(", ", allFoods.Take(6).Select(e => e.FoodName))
                            @(allFoods.Count > 6 ? $" +{allFoods.Count - 6}" : "")
                        </p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(log.Hydration) || !string.IsNullOrEmpty(log.Emotions) || !string.IsNullOrEmpty(log.PhysicalActivity))
                {
                    <div class="px-4 pb-3 flex flex-wrap gap-2">
                        @if (!string.IsNullOrEmpty(log.Hydration))
                        {
                            <span class="text-xs bg-blue-50 text-blue-500 px-2 py-0.5 rounded-full">💧 @log.Hydration</span>
                        }
                        @if (!string.IsNullOrEmpty(log.PhysicalActivity))
                        {
                            <span class="text-xs bg-green-50 text-green-600 px-2 py-0.5 rounded-full">🏃 @log.PhysicalActivity</span>
                        }
                        @if (!string.IsNullOrEmpty(log.Emotions))
                        {
                            <span class="text-xs bg-purple-50 text-purple-500 px-2 py-0.5 rounded-full">🧘 @log.Emotions</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public int DiaryId { get; set; }
    [Parameter] public EventCallback<DateOnly> OnDateSelected { get; set; }

    List<DailyLog>? logs;

    protected override async Task OnParametersSetAsync() =>
        logs = await DiaryService.GetAllDailyLogsAsync(DiaryId);

    static string MealLabel(MealType m) => m switch
    {
        MealType.PetitDejeuner      => "Petit-déjeuner",
        MealType.CollationMatin     => "Collation matin",
        MealType.Dejeuner           => "Déjeuner",
        MealType.CollationApresMidi => "Collation après-midi",
        MealType.Diner              => "Dîner",
        MealType.CollationSoir      => "Collation soir",
        _ => "Autre"
    };
    static string MealIcon(MealType m) => m switch
    {
        MealType.PetitDejeuner      => "☕",
        MealType.CollationMatin     => "🍎",
        MealType.Dejeuner           => "🍽️",
        MealType.CollationApresMidi => "🫐",
        MealType.Diner              => "🌙",
        MealType.CollationSoir      => "🌛",
        _ => "🍴"
    };
}
