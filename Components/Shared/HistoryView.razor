@inject DiaryService DiaryService

@if (logs == null)
{
    <div class="text-gray-400 text-center py-8">Chargement de l'historique…</div>
}
else if (logs.Count == 0)
{
    <div class="bg-white rounded-lg shadow-[0_1px_0_rgba(20,26,31,.06),0_10px_18px_-12px_rgba(20,26,31,.35)] p-8 text-center">
        <div class="text-4xl mb-3">📅</div>
        <p class="text-gray-400">Aucune entrée dans votre historique pour le moment.</p>
    </div>
}
else
{
    <div class="space-y-3">
        @foreach (var log in logs)
        {
            var mealCount = log.Events.Count(e => e.EventType == DayEventType.Meal);
            var activityCount = log.Events.Count(e => e.EventType == DayEventType.Activity);
            var foodCount = log.Events.SelectMany(e => e.FoodEntries).Count();
            var allFoods = log.Events.SelectMany(e => e.FoodEntries).ToList();

            <button type="button"
                    class="w-full text-left bg-white rounded-lg shadow-[0_1px_0_rgba(20,26,31,.06),0_10px_18px_-12px_rgba(20,26,31,.35)] overflow-hidden cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-300 transition-colors"
                    aria-label="@($"Ouvrir la journée du {log.Date.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))}")"
                    @onclick="() => OnDateSelected.InvokeAsync(log.Date)">
                <div class="px-4 py-3 flex items-center justify-between">
                    <div>
                        <p class="font-display font-bold text-carbon">
                            <span class="capitalize">@log.Date.ToString("dddd", new System.Globalization.CultureInfo("fr-FR"))</span> @log.Date.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))
                        </p>
                        <p class="text-xs text-gray-400 mt-0.5">
                            @foodCount aliment(s)
                            @if (mealCount > 0) { <span> · @mealCount repas</span> }
                            @if (activityCount > 0) { <span> · @activityCount activité(s)</span> }
                        </p>
                    </div>
                    <div class="flex flex-wrap gap-1 justify-end">
                        @if (mealCount > 0) { <span class="text-base" title="@mealCount repas">🍽️</span> }
                        @if (activityCount > 0) { <span class="text-base" title="@activityCount activité(s)">🏃</span> }
                    </div>
                </div>
                @if (allFoods.Count > 0)
                {
                    <div class="px-4 pb-3">
                        <p class="text-xs text-gray-400 truncate">
                            @string.Join(", ", allFoods.Take(6).Select(e => e.FoodName))
                            @(allFoods.Count > 6 ? $" +{allFoods.Count - 6}" : "")
                        </p>
                    </div>
                }
                @if (!string.IsNullOrEmpty(log.Hydration) || !string.IsNullOrEmpty(log.Emotions))
                {
                    <div class="px-4 pb-3 flex flex-wrap gap-2">
                        @if (!string.IsNullOrEmpty(log.Hydration))
                        {
                            <span class="text-xs bg-blue-50 text-blue-500 px-2 py-0.5 rounded-full">💧 @log.Hydration</span>
                        }
                        @if (!string.IsNullOrEmpty(log.Emotions))
                        {
                            <span class="text-xs bg-purple-50 text-purple-500 px-2 py-0.5 rounded-full">🧘 @log.Emotions</span>
                        }
                    </div>
                }
            </button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public int DiaryId { get; set; }
    [Parameter] public EventCallback<DateOnly> OnDateSelected { get; set; }

    List<DailyLog>? logs;

    protected override async Task OnParametersSetAsync() =>
        logs = await DiaryService.GetAllDailyLogsAsync(DiaryId);
}
