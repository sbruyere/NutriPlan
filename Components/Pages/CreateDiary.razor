@page "/creer-carnet"
@inject DiaryService DiaryService
@inject NavigationManager Nav

<PageTitle>Créer un carnet — NutriPlan</PageTitle>

<div class="max-w-sm mx-auto py-6">
    <div class="mb-4">
        <a href="/" class="text-primary-600 hover:underline text-xs flex items-center gap-1 text-gray-400 hover:text-primary-600 transition-colors">
            ← Retour
        </a>
    </div>

    @if (createdDiary == null)
    {
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5">
            <div class="text-center mb-5">
                <div class="text-3xl mb-1.5">📓</div>
                <h1 class="text-lg font-bold text-gray-800">Nouveau carnet alimentaire</h1>
                <p class="text-gray-400 text-xs mt-1">Aucun compte requis — totalement anonyme</p>
            </div>

            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-medium text-gray-500 mb-1">
                        Code PIN <span class="text-gray-300 font-normal">(optionnel)</span>
                    </label>
                    <input @bind="pin" type="password" placeholder="4 à 8 chiffres pour protéger votre carnet"
                           class="w-full bg-slate-50 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 border-0 placeholder-gray-300"
                           maxlength="8" />
                    <p class="text-gray-400 text-[10px] mt-1">Laissez vide pour un accès sans protection.</p>
                </div>

                @if (!string.IsNullOrEmpty(pin))
                {
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1">
                            Confirmer le PIN
                        </label>
                        <input @bind="pinConfirm" type="password" placeholder="Répétez votre PIN"
                               class="w-full bg-slate-50 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 border-0 placeholder-gray-300"
                               maxlength="8" />
                    </div>
                }

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="bg-red-50 text-red-600 text-xs rounded-lg px-3 py-2">
                        @errorMessage
                    </div>
                }

                <button @onclick="Create" disabled="@isLoading"
                        class="w-full bg-primary-600 hover:bg-primary-700 disabled:opacity-60 text-white py-2 rounded-lg text-sm font-medium transition-colors">
                    @(isLoading ? "Création en cours…" : "Créer mon carnet")
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5 text-center">
            <div class="text-4xl mb-3">🎉</div>
            <h2 class="text-base font-bold text-gray-800 mb-1.5">Votre carnet est prêt !</h2>
            <p class="text-gray-400 text-xs mb-5">
                Notez ce code — c'est votre seul moyen d'accéder à votre carnet.
            </p>

            <div class="bg-primary-50 border border-primary-200 rounded-xl px-5 py-3 mb-4 inline-block">
                <p class="text-[10px] text-primary-400 font-medium mb-1 tracking-widest">VOTRE CODE D'ACCÈS</p>
                <p class="text-2xl font-bold text-primary-700 tracking-widest">@createdDiary.AccessCode</p>
            </div>

            @if (createdDiary.PinHash != null)
            {
                <div class="bg-amber-50 border border-amber-200 rounded-lg px-3 py-2 text-xs text-amber-700 mb-4">
                    🔒 Votre carnet est protégé par un code PIN.
                </div>
            }

            <button @onclick="GoToDiary"
                    class="w-full bg-primary-600 hover:bg-primary-700 text-white py-2 rounded-lg text-sm font-medium transition-colors">
                Ouvrir mon carnet →
            </button>
        </div>
    }
</div>

@code {
    string pin = "";
    string pinConfirm = "";
    string errorMessage = "";
    bool isLoading = false;
    FoodDiary? createdDiary;

    async Task Create()
    {
        errorMessage = "";

        if (!string.IsNullOrEmpty(pin))
        {
            if (pin.Length < 4) { errorMessage = "Le PIN doit comporter au moins 4 chiffres."; return; }
            if (pin != pinConfirm) { errorMessage = "Les codes PIN ne correspondent pas."; return; }
        }

        isLoading = true;
        createdDiary = await DiaryService.CreateAnonymousDiaryAsync(string.IsNullOrEmpty(pin) ? null : pin);
        isLoading = false;
    }

    void GoToDiary()
    {
        Nav.NavigateTo($"/carnet/{createdDiary!.AccessCode}/journal");
    }
}
