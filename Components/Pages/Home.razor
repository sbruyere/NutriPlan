@page "/"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>NutriPlan — Cahier de suivi alimentaire</PageTitle>

<div class="flex flex-col items-center justify-center min-h-[60vh] gap-8 py-8">
    <div class="text-center">
        <div class="text-6xl mb-4">🥗</div>
        <h1 class="text-3xl sm:text-4xl font-bold text-gray-800 mb-2">Bienvenue sur NutriPlan</h1>
        <p class="text-gray-500 text-lg max-w-md">
            Votre cahier de suivi alimentaire simple et confidentiel.
        </p>
    </div>

    <div class="w-full max-w-md grid grid-cols-1 gap-4">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-4">Accéder à mon carnet</h2>
            <div class="flex gap-2">
                <input @bind="accessCode"
                       @bind:event="oninput"
                       @onkeyup="OnKeyUp"
                       type="text"
                       placeholder="Code d'accès (ex: AB3K7XPQ)"
                       class="flex-1 border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 uppercase tracking-widest"
                       maxlength="8" />
                <button @onclick="AccessDiary"
                        disabled="@(string.IsNullOrWhiteSpace(accessCode))"
                        class="bg-primary-600 hover:bg-primary-700 disabled:opacity-40 disabled:cursor-not-allowed text-white px-4 py-2.5 rounded-xl text-sm font-medium transition-colors">
                    Ouvrir
                </button>
            </div>
            @if (notFound)
            {
                <p class="text-red-500 text-sm mt-2">Code introuvable. Vérifiez votre code d'accès.</p>
            }
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
            <h2 class="text-lg font-semibold text-gray-700 mb-2">Créer un nouveau carnet</h2>
            <p class="text-gray-400 text-sm mb-4">Aucun compte requis. Un code unique vous sera attribué.</p>
            <a href="/creer-carnet"
               class="block text-center bg-accent-500 hover:bg-accent-600 text-white px-4 py-2.5 rounded-xl text-sm font-medium transition-colors">
                Créer mon carnet alimentaire
            </a>
        </div>
    </div>

    <div class="text-center text-sm text-gray-400 max-w-sm">
        Nutritionniste ?
        <a href="/nutritionniste/connexion" class="text-primary-600 hover:underline font-medium">
            Accédez à votre espace professionnel
        </a>
    </div>
</div>

@code {
    string accessCode = "";
    bool notFound = false;

    @inject DiaryService DiaryService

    async Task AccessDiary()
    {
        notFound = false;
        var code = accessCode.Trim().ToUpperInvariant();
        var diary = await DiaryService.GetDiaryByCodeAsync(code);
        if (diary == null)
        {
            notFound = true;
            return;
        }
        Nav.NavigateTo($"/carnet/{code}");
    }

    void OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = AccessDiary();
    }
}
