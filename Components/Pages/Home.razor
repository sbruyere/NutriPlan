@page "/"
@inject NavigationManager Nav

<PageTitle>NutriPlan — Cahier de suivi alimentaire</PageTitle>

<div class="flex flex-col items-center justify-center min-h-[55vh] gap-6 py-6">
    <div class="text-center">
        <div class="text-5xl mb-3">🥗</div>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-800 mb-1.5">Bienvenue sur NutriPlan</h1>
        <p class="text-gray-400 text-sm max-w-xs mx-auto">
            Votre cahier de suivi alimentaire simple et confidentiel.
        </p>
    </div>

    <div class="w-full max-w-sm grid grid-cols-1 gap-3">
        <!-- Accès existant -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-4">
            <h2 class="text-sm font-semibold text-gray-700 mb-3">Accéder à mon carnet</h2>
            <div class="flex gap-2">
                <input @bind="accessCode"
                       @bind:event="oninput"
                       @onkeyup="OnKeyUp"
                       type="text"
                       placeholder="Code d'accès (ex: AB3K7XPQ)"
                       class="flex-1 bg-slate-50 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 uppercase tracking-widest border-0 placeholder-gray-300"
                       maxlength="8" />
                <button @onclick="AccessDiary"
                        disabled="@(string.IsNullOrWhiteSpace(accessCode))"
                        class="bg-primary-600 hover:bg-primary-700 disabled:opacity-40 disabled:cursor-not-allowed text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors flex-shrink-0">
                    Ouvrir
                </button>
            </div>
            @if (notFound)
            {
                <p class="text-red-500 text-xs mt-2">Code introuvable. Vérifiez votre code d'accès.</p>
            }
        </div>

        <!-- Nouveau carnet -->
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-4">
            <div class="flex items-center justify-between gap-3">
                <div class="min-w-0">
                    <h2 class="text-sm font-semibold text-gray-700 mb-0.5">Créer un nouveau carnet</h2>
                    <p class="text-gray-400 text-xs">Aucun compte requis — totalement anonyme.</p>
                </div>
                <a href="/creer-carnet"
                   class="flex-shrink-0 bg-accent-500 hover:bg-accent-600 text-white px-3.5 py-2 rounded-lg text-xs font-medium transition-colors whitespace-nowrap">
                    Créer →
                </a>
            </div>
        </div>
    </div>

    <p class="text-xs text-gray-400">
        Nutritionniste ?
        <a href="/nutritionniste/connexion" class="text-primary-600 hover:underline font-medium">
            Espace professionnel
        </a>
    </p>
</div>

@code {
    string accessCode = "";
    bool notFound = false;

    @inject DiaryService DiaryService

    async Task AccessDiary()
    {
        notFound = false;
        var code = accessCode.Trim().ToUpperInvariant();
        var diary = await DiaryService.GetDiaryByCodeAsync(code);
        if (diary == null)
        {
            notFound = true;
            return;
        }
        Nav.NavigateTo($"/carnet/{code}/journal");
    }

    void OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = AccessDiary();
    }
}
