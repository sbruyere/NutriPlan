@page "/"
@inject NavigationManager Nav
@inject DiaryService DiaryService
@inject StravaService Strava

<PageTitle>NutriPlan — Cahier de suivi alimentaire</PageTitle>

<div class="flex flex-col items-center justify-center min-h-[55vh] gap-6 py-6">
    <div class="text-center">
        <div class="w-14 h-14 rounded-xl bg-carbon flex items-center justify-center mx-auto mb-4 shadow-[0_16px_28px_-16px_rgba(8,12,16,.6)]">
            <Icon Name="leaf" Class="w-7 h-7 text-volt" StrokeWidth="2" />
        </div>
        <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-carbon mb-3 tracking-tight leading-tight">
            Votre journée,<br />
            <span class="inline-block bg-carbon text-volt px-2.5 rounded-[6px]">repas & énergie.</span>
        </h1>
        <p class="text-gray-500 text-sm max-w-sm mx-auto leading-relaxed">
            Repas, hydratation, activité : suivez votre journée en quelques taps
            et partagez-la avec votre nutritionniste quand vous le décidez.
        </p>
    </div>

    <div class="w-full max-w-sm grid grid-cols-1 gap-3">
        <!-- Accès existant -->
        <div class="bg-white rounded-2xl shadow-sm p-4">
            <h2 class="font-display text-[15px] font-semibold text-slate-900 mb-3">Ouvrir mon carnet</h2>
            <div class="flex gap-2">
                <input @bind="accessCode"
                       @bind:event="oninput"
                       @onkeyup="OnKeyUp"
                       type="text"
                       aria-label="Code d'accès du carnet"
                       autocapitalize="characters"
                       autocomplete="off"
                       spellcheck="false"
                       autofocus
                       placeholder="Code d'accès (ex: AB3K7XPQ)"
                       class="flex-1 bg-slate-50 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 uppercase tracking-widest border-0 placeholder-gray-400"
                       maxlength="8" />
                <button @onclick="AccessDiary"
                        disabled="@(string.IsNullOrWhiteSpace(accessCode) || isOpening)"
                        class="bg-volt hover:bg-volt-dark disabled:opacity-40 disabled:cursor-not-allowed text-carbon px-4 py-2 rounded-lg text-sm font-medium transition-colors flex-shrink-0">
                    @(isOpening ? "Ouverture…" : "Ouvrir")
                </button>
            </div>
            @if (notFound)
            {
                <p class="text-red-500 text-xs mt-2" role="alert">Code introuvable. Vérifiez votre code d'accès.</p>
            }
            @if (Strava.IsConfigured)
            {
                @* Scope minimal « read » : couvert par toute autorisation existante →
                   redirection silencieuse, pas de reconsentement à chaque connexion *@
                <a href="@Strava.GetAuthorizeUrl($"{Nav.BaseUri}strava/callback", "login", "read")"
                   class="inline-flex items-center gap-1 text-xs font-bold text-[#fc4c02] hover:underline mt-2.5">
                    Ou continuer avec Strava →
                </a>
            }
            @if (stravaUnknown)
            {
                <p class="text-red-500 text-xs mt-2" role="alert">
                    Aucun carnet n'est lié à ce compte Strava. Ouvrez votre carnet avec son code,
                    puis connectez Strava dans le panneau Profil — la prochaine fois, un clic suffira.
                </p>
            }
        </div>

        <!-- Nouveau carnet -->
        <a href="/creer-carnet"
           class="block bg-carbon hover:bg-[#181d22] rounded-xl shadow-[0_16px_28px_-16px_rgba(8,12,16,.65)] p-4 transition-colors group">
            <div class="flex items-center justify-between gap-3">
                <div class="min-w-0">
                    <h2 class="font-display text-[15px] font-bold text-snow mb-0.5">Commencer un nouveau carnet</h2>
                    <p class="text-[#79838c] text-xs">Aucun compte requis — totalement anonyme.</p>
                </div>
                <span class="flex-shrink-0 bg-volt text-carbon px-3.5 py-2 rounded-lg text-[10px] font-extrabold uppercase tracking-[.08em] whitespace-nowrap shadow-[0_2px_0_rgba(14,17,20,.25)] group-hover:translate-x-0.5 transition-transform">
                    Créer →
                </span>
            </div>
        </a>
    </div>

    <p class="text-xs text-gray-400">
        Nutritionniste ?
        <a href="/nutritionniste/connexion" class="text-primary-600 hover:underline font-medium">
            Espace professionnel
        </a>
    </p>
</div>

@code {
    string accessCode = "";
    bool notFound = false;
    bool isOpening = false;
    bool stravaUnknown;

    protected override void OnInitialized() =>
        stravaUnknown = Nav.Uri.Contains("strava=unknown");

    async Task AccessDiary()
    {
        if (isOpening || string.IsNullOrWhiteSpace(accessCode)) return;

        notFound = false;
        isOpening = true;
        try
        {
            var code = accessCode.Trim().ToUpperInvariant();
            var diary = await DiaryService.GetDiaryByCodeAsync(code);
            if (diary == null)
            {
                notFound = true;
            }
            else
            {
                Nav.NavigateTo($"/carnet/{code}/journal");
            }
        }
        finally
        {
            isOpening = false;
        }
    }

    async Task OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AccessDiary();
    }
}
