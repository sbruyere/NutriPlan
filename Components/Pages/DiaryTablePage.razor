@page "/carnet/{AccessCode}/tableau"
@page "/carnet/{AccessCode}/tableau/{DateParam}"
@inject DiaryService DiaryService
@inject DiarySessionService Session
@inject NavigationManager Nav
@inject BrowserTimeService Time
@inject IJSRuntime JS

@* Vue tableau de la journée en écran dédié, pleine largeur — pensée pour les
   grands affichages (le lien d'entrée n'apparaît qu'en lg:). L'accès exige un
   carnet déjà déverrouillé en session : sinon, retour au journal qui porte
   les gardes PIN/Strava. *@
<PageTitle>Tableau de la journée — NutriPlan</PageTitle>

@if (loading)
{
    <div class="text-center text-gray-400 py-12">Chargement…</div>
}
else if (diary != null)
{
    <div style="width:100vw;margin-left:calc(50% - 50vw);padding:0 1.5rem;box-sizing:border-box;">
        <div class="flex items-center justify-between gap-3 flex-wrap mb-4 print:hidden">
            <div class="flex items-center gap-3 min-w-0">
                <a href="@($"/carnet/{AccessCode}/journal")"
                   class="inline-flex items-center gap-1.5 text-xs font-semibold bg-primary-50 text-primary-700 hover:bg-primary-100 px-3 py-1.5 rounded-full transition-colors flex-shrink-0">
                    <Icon Name="arrow-left" Class="w-3 h-3" />
                    <span>Journal</span>
                </a>
                <div class="min-w-0">
                    <p class="text-[9px] font-extrabold uppercase tracking-[.16em] text-gray-400 leading-none">Vue tableau</p>
                    <p class="font-display text-xl font-extrabold tracking-tight text-carbon leading-tight">
                        <span class="capitalize">@selectedDate.ToString("dddd", Fr)</span> @selectedDate.ToString("d MMMM yyyy", Fr)
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-1.5 flex-shrink-0">
                <button @onclick="PreviousDay" aria-label="Jour précédent"
                        class="p-2 rounded-full hover:bg-gray-100 text-gray-400 hover:text-gray-600 transition-colors">
                    <Icon Name="chevron-left" Class="w-5 h-5" />
                </button>
                <button @onclick="NextDay" disabled="@(selectedDate >= Time.Today)" aria-label="Jour suivant"
                        class="p-2 rounded-full hover:bg-gray-100 disabled:opacity-30 text-gray-400 hover:text-gray-600 transition-colors">
                    <Icon Name="chevron-right" Class="w-5 h-5" />
                </button>
                <button @onclick="Print" aria-label="Imprimer la journée" title="Imprimer la journée"
                        class="inline-flex items-center gap-1.5 text-[11px] font-semibold bg-gray-100 hover:bg-gray-200 text-gray-600 px-3 py-1.5 rounded-full transition-colors">
                    <Icon Name="printer" Class="w-3.5 h-3.5" />
                    <span>Imprimer</span>
                </button>
            </div>
        </div>

        <DiaryTableView DailyLog="@currentLog" DiaryId="@diary.Id" Date="@selectedDate" OnChanged="@LoadDay" />
    </div>
}

@code {
    [Parameter] public string AccessCode { get; set; } = "";
    [Parameter] public string? DateParam { get; set; }

    static readonly System.Globalization.CultureInfo Fr = new("fr-FR");

    NutriPlan.Data.Models.FoodDiary? diary;
    NutriPlan.Data.Models.DailyLog? currentLog;
    DateOnly selectedDate;
    bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        selectedDate = DateOnly.TryParseExact(DateParam, "yyyy-MM-dd", out var d) ? d : await Time.TodayAsync();
        if (selectedDate > Time.Today) selectedDate = Time.Today;

        var code = AccessCode.ToUpperInvariant();
        diary = await DiaryService.GetDiaryByCodeAsync(code);
        if (diary == null || !Session.IsUnlocked(code, DiarySessionService.AccessStamp(diary.PinHash, diary.StravaAthleteId)))
        {
            // Pas déverrouillé ici : le journal porte les gardes PIN/Strava.
            Nav.NavigateTo($"/carnet/{AccessCode}/journal");
            return;
        }
        await LoadDay();
        loading = false;
    }

    async Task LoadDay() => currentLog = await DiaryService.GetDailyLogFullAsync(diary!.Id, selectedDate);

    async Task PreviousDay() { selectedDate = selectedDate.AddDays(-1); await LoadDay(); }

    async Task NextDay()
    {
        if (selectedDate >= Time.Today) return;
        selectedDate = selectedDate.AddDays(1);
        await LoadDay();
    }

    async Task Print() => await JS.InvokeVoidAsync("nutriplan.print");
}
