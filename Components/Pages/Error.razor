@page "/Error"
@using System.Diagnostics
@layout MainLayout

<PageTitle>Erreur — NutriPlan</PageTitle>

<div class="flex flex-col items-center justify-center min-h-[50vh] text-center py-12">
    <div class="text-6xl mb-4">⚠️</div>
    <h1 class="text-2xl font-bold text-gray-800 mb-2">Une erreur est survenue</h1>
    <p class="text-gray-400 mb-2">Une erreur inattendue s'est produite lors du traitement de votre demande.</p>
    @if (ShowRequestId)
    {
        <p class="text-xs text-gray-300 mb-6 font-mono">ID : @RequestId</p>
    }
    <a href="/" class="bg-volt hover:bg-volt-dark text-carbon px-6 py-2.5 rounded-xl font-medium transition-colors">
        Retour à l'accueil
    </a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
