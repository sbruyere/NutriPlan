@page "/carnet/{AccessCode}/journal"
@rendermode InteractiveServer
@inject DiaryService DiaryService
@inject DiarySessionService Session
@inject NavigationManager Nav

<PageTitle>Mon carnet — NutriPlan</PageTitle>

@if (!isAuthorized)
{
    <div class="text-center text-gray-400 py-12">Redirection…</div>
    return;
}
@if (diary == null)
{
    <div class="text-center text-gray-400 py-12">Chargement…</div>
    return;
}

<div class="space-y-4">

    <!-- En-tête + navigation -->
    <div class="flex items-center justify-between flex-wrap gap-2">
        <div>
            <h1 class="text-lg font-bold text-gray-800">Mon carnet alimentaire</h1>
            <p class="text-xs text-gray-400 font-mono">@AccessCode</p>
        </div>
        <div class="flex items-center gap-2">
            @if (!showHistory)
            {
                <!-- Bascule vue carte / tableau -->
                <div class="flex bg-gray-100 rounded-lg p-0.5 text-xs font-medium">
                    <button @onclick="() => tableView = false"
                            class="px-3 py-1.5 rounded-md transition-colors @(tableView ? "text-gray-500" : "bg-white shadow text-gray-800")">
                        ☰ Cartes
                    </button>
                    <button @onclick="() => tableView = true"
                            class="px-3 py-1.5 rounded-md transition-colors @(tableView ? "bg-white shadow text-gray-800" : "text-gray-500")">
                        ⊞ Tableau
                    </button>
                </div>
            }
            <button @onclick="() => showHistory = !showHistory"
                    class="text-sm text-primary-600 border border-primary-200 hover:border-primary-400 px-3 py-1.5 rounded-lg transition-colors">
                @(showHistory ? "← Journée" : "Historique")
            </button>
        </div>
    </div>

    @if (showHistory)
    {
        <HistoryView DiaryId="@diary.Id" OnDateSelected="SelectDate" />
    }
    else
    {
        <!-- Sélecteur de date -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-3 flex items-center justify-between">
            <button @onclick="PreviousDay" class="p-2 rounded-lg hover:bg-gray-100 text-gray-500 transition-colors">←</button>
            <div class="text-center">
                <p class="font-semibold text-gray-800 capitalize">
                    @selectedDate.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))
                </p>
                @if (selectedDate == DateOnly.FromDateTime(DateTime.Today))
                {
                    <span class="text-xs bg-primary-100 text-primary-600 px-2 py-0.5 rounded-full">Aujourd'hui</span>
                }
            </div>
            <button @onclick="NextDay" disabled="@(selectedDate >= DateOnly.FromDateTime(DateTime.Today))"
                    class="p-2 rounded-lg hover:bg-gray-100 disabled:opacity-30 text-gray-500 transition-colors">→</button>
        </div>

        @if (tableView)
        {
            <!-- Vue tableau -->
            <DiaryTableView
                DailyLog="@currentLog"
                DiaryId="@diary.Id"
                Date="@selectedDate"
                OnChanged="@LoadDay" />

            <!-- Notes générales (hors tableau) -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
                <label class="block text-xs font-medium text-gray-500 mb-1.5">📝 Notes générales</label>
                <textarea @bind="generalNotes" @onblur="SaveDaySummary" rows="2"
                          placeholder="Observations, remarques…"
                          class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 resize-none"></textarea>
            </div>
        }
        else
        {
            <!-- Vue cartes -->
            @foreach (var mealDef in MealDefinitions)
            {
                var mealLog = currentLog?.MealLogs.FirstOrDefault(m => m.MealType == mealDef.Type);
                <MealSection
                    MealType="@mealDef.Type"
                    MealLabel="@mealDef.Label"
                    MealIcon="@mealDef.Icon"
                    MealLog="@mealLog"
                    OnSave="@(async (args) => await SaveMealSection(mealDef.Type, args))"
                    OnAddFood="@(async (entry) => await AddFoodEntry(mealDef.Type, entry))"
                    OnDeleteFood="@(async (id) => await DeleteFoodEntry(id))" />
            }

            <!-- Résumé de la journée -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4">
                <h3 class="font-semibold text-gray-700 mb-4 flex items-center gap-2">
                    <span>📊</span> Bilan de la journée
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1.5">💧 Hydratation</label>
                        <input @bind="hydration" @onblur="SaveDaySummary" type="text"
                               placeholder="ex: 6 verres, 1,5L d'eau, 2 cafés…"
                               class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" />
                        <p class="text-xs text-gray-300 mt-1">Eau, thé, tisanes, café, autre</p>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1.5">🧘 Émotions / Stress</label>
                        <textarea @bind="emotions" @onblur="SaveDaySummary" rows="2"
                                  placeholder="Comment vous sentez-vous ?"
                                  class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 resize-none"></textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-500 mb-1.5">🏃 Sport / Activité physique</label>
                        <textarea @bind="physicalActivity" @onblur="SaveDaySummary" rows="2"
                                  placeholder="Type, durée, intensité…"
                                  class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 resize-none"></textarea>
                    </div>
                </div>
                <div class="mt-3">
                    <label class="block text-xs font-medium text-gray-500 mb-1.5">📝 Notes générales</label>
                    <textarea @bind="generalNotes" @onblur="SaveDaySummary" rows="2"
                              placeholder="Observations, remarques…"
                              class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 resize-none"></textarea>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string AccessCode { get; set; } = "";

    FoodDiary? diary;
    DailyLog? currentLog;
    DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    bool isAuthorized;
    bool showHistory;
    bool tableView;

    string hydration = "", emotions = "", physicalActivity = "", generalNotes = "";

    static readonly (MealType Type, string Label, string Icon)[] MealDefinitions =
    [
        (MealType.PetitDejeuner,      "Petit-déjeuner",    "☕"),
        (MealType.CollationMatin,     "Collation matin",   "🍎"),
        (MealType.Dejeuner,           "Déjeuner",          "🍽️"),
        (MealType.CollationApresMidi, "Collation après-midi", "🫐"),
        (MealType.Diner,              "Dîner",             "🌙"),
        (MealType.CollationSoir,      "Collation soir",    "🌛"),
    ];

    protected override async Task OnParametersSetAsync()
    {
        var code = AccessCode.ToUpperInvariant();
        if (!Session.IsUnlocked(code))
        {
            Nav.NavigateTo($"/carnet/{code}", replace: true);
            return;
        }
        isAuthorized = true;
        diary = await DiaryService.GetDiaryByCodeAsync(code);
        if (diary != null) await LoadDay();
    }

    async Task LoadDay()
    {
        currentLog = await DiaryService.GetDailyLogFullAsync(diary!.Id, selectedDate);
        hydration = currentLog?.Hydration ?? "";
        emotions = currentLog?.Emotions ?? "";
        physicalActivity = currentLog?.PhysicalActivity ?? "";
        generalNotes = currentLog?.GeneralNotes ?? "";
    }

    async Task PreviousDay()
    {
        selectedDate = selectedDate.AddDays(-1);
        await LoadDay();
    }

    async Task NextDay()
    {
        if (selectedDate < DateOnly.FromDateTime(DateTime.Today))
        {
            selectedDate = selectedDate.AddDays(1);
            await LoadDay();
        }
    }

    void SelectDate(DateOnly date)
    {
        selectedDate = date;
        showHistory = false;
        _ = LoadDay();
    }

    async Task SaveMealSection(MealType mealType, (int? Hunger, int? Satiety, string? Sensations) args)
    {
        currentLog ??= await DiaryService.GetOrCreateDailyLogAsync(diary!.Id, selectedDate);
        var meal = await DiaryService.GetOrCreateMealLogAsync(currentLog.Id, mealType);
        await DiaryService.UpdateMealLogAsync(meal.Id, args.Hunger, args.Satiety, args.Sensations);
        await LoadDay();
    }

    async Task AddFoodEntry(MealType mealType, FoodEntry entry)
    {
        currentLog ??= await DiaryService.GetOrCreateDailyLogAsync(diary!.Id, selectedDate);
        var meal = await DiaryService.GetOrCreateMealLogAsync(currentLog.Id, mealType);
        await DiaryService.AddFoodEntryAsync(meal.Id, entry);
        await LoadDay();
    }

    async Task DeleteFoodEntry(int entryId)
    {
        await DiaryService.DeleteFoodEntryAsync(entryId);
        await LoadDay();
    }

    async Task SaveDaySummary()
    {
        currentLog ??= await DiaryService.GetOrCreateDailyLogAsync(diary!.Id, selectedDate);
        await DiaryService.UpdateDailyLogSummaryAsync(currentLog.Id, hydration, emotions, physicalActivity, generalNotes);
    }
}
