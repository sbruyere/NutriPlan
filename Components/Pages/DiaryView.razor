    // ── Stats calculées ──────────────────────────────────────────────────────

    int EstimatedHydrationMl => DiaryService.EstimateHydrationMl(
        (currentLog?.Events ?? []).SelectMany(e => e.DrinkEntries));

    int TotalDrinksCount => (currentLog?.Events ?? [])
        .Sum(e => e.DrinkEntries.Count);

    int FilledMealsCount => (currentLog?.Events ?? [])
        .Count(e => e.EventType == DayEventType.Meal);

    int TotalActivityMinutes => (currentLog?.Events ?? [])
        .Where(e => e.EventType == DayEventType.Activity && e.DurationMinutes.HasValue)
        .Sum(e => e.DurationMinutes!.Value);

    int TotalActivityCount => (currentLog?.Events ?? [])
        .Count(e => e.EventType == DayEventType.Activity);

    // Total kcal estimé de la journée (aliments des repas reliés au référentiel Ciqual).
    double DayKcalTotal => (currentLog?.Events ?? [])
        .Where(e => e.EventType == DayEventType.Meal)
        .SelectMany(e => e.FoodEntries)
        .Select(f => DiaryService.EstimateKcal(f))
        .Where(k => k != null)
        .Sum(k => k!.Value);

    static string FormatDayKcal(double kcal) =>
        kcal <= 0 ? "—" : $"≈ {kcal:0}";

    // kcal dépensées : somme des saisies utilisateur sur les activités du jour.
    int TotalBurnedKcal => (currentLog?.Events ?? [])
        .Where(e => e.EventType == DayEventType.Activity && e.CaloriesBurned.HasValue)
        .Sum(e => e.CaloriesBurned!.Value);

    // Bilan = ingérées − sport − métabolisme de base (MB seul, pas MB×activité :
    // le sport saisi est déjà compté, le facteur d'activité le compterait en double).
    string FormatKcalBalance()
    {
        var eaten = DayKcalTotal;
        var burned = TotalBurnedKcal;
        if (eaten <= 0 && burned <= 0) return "—";
        var diff = eaten - burned - (ProfileBmr ?? 0);
        return $"{(diff >= 0 ? "+" : "−")}{Math.Abs(diff):0}";
    }

    static string FormatHydration(int ml) =>
        ml == 0 ? "—" : ml >= 1000 ? $"≈ {ml / 1000.0:0.#} L" : $"≈ {ml} ml";

    static string FormatActivity(int minutes) =>
        minutes == 0 ? "—" :
        minutes >= 60 ? $"{minutes / 60}h{(minutes % 60 > 0 ? $" {minutes % 60}min" : "")}" :
        $"{minutes} min";

    IReadOnlyList<DayEvent> GetConcurrentActivities(int slotIdx)
        => (currentLog?.Events ?? [])
            .Where(e => e.EventType == DayEventType.Activity && e.ConcurrentWithMealSlot == slotIdx)
            .OrderBy(e => e.Time).ThenBy(e => e.CreatedAt)
            .ToList();

    static readonly IReadOnlyList<DayEvent> EmptyActivities = [];

    record FriseRow(DayEvent? Event, int? EmptySlot);

    IEnumerable<FriseRow> GetFriseRows()
    {
        var rows = new List<(TimeOnly sortTime, FriseRow row)>();

        for (int i = 0; i < DiaryService.MealSlots.Length; i++)
        {
            var slot = DiaryService.MealSlots[i];
            var mealEvent = currentLog?.Events.FirstOrDefault(e => e.MealSlot == i);
            var sortTime = mealEvent?.Time ?? slot.DefaultTime;
            rows.Add((sortTime, new FriseRow(mealEvent, mealEvent == null ? i : null)));
        }

        foreach (var act in (currentLog?.Events ?? [])
            .Where(e => e.EventType == DayEventType.Activity && !e.ConcurrentWithMealSlot.HasValue))
        {
            rows.Add((act.Time ?? TimeOnly.MinValue, new FriseRow(act, null)));
        }

        return rows.OrderBy(r => r.sortTime).Select(r => r.row);
    }

    async Task UpdateEventTime(DayEvent evt, ChangeEventArgs e)
    {
        if (TimeOnly.TryParse(e.Value?.ToString(), out var time))
        {
            try
            {
                await DiaryService.UpdateEventTimeAsync(evt.Id, time);
                await LoadDay();
                Toast.ShowSaved();
            }
            catch
            {
                Toast.ShowError("Enregistrement impossible — vérifiez votre connexion.");
            }
        }
    }

    // ── Jalons vides ───────────────────────────────────────────────────────────
    // Un clic crée l'événement et ouvre directement l'éditeur standard (plus de
    // formulaire intermédiaire ni d'expansion au survol). Un jalon refermé sans
    // aucune saisie est supprimé par le balayage de LoadDay et redevient fantôme.

    async Task OpenSlot(int slotIdx)
    {
        currentLog ??= await DiaryService.GetOrCreateDailyLogAsync(diary!.Id, selectedDate);
        var evt = await DiaryService.GetOrCreateMealSlotEventAsync(currentLog.Id, slotIdx);
        editingEventId = evt.Id;
        await LoadDay();
    }

    // Vierge = aucune saisie ET libellé/heure d'origine ET aucune activité simultanée.
    bool IsUntouchedSlotEvent(DayEvent evt)
    {
        if (evt is not { EventType: DayEventType.Meal, MealSlot: not null }) return false;
        var slot = DiaryService.MealSlots[evt.MealSlot.Value];
        return evt.FoodEntries.Count == 0 && evt.DrinkEntries.Count == 0 && evt.Photos.Count == 0
            && evt.HungerBefore == null && evt.SatietyAfter == null
            && string.IsNullOrWhiteSpace(evt.Emotions) && string.IsNullOrWhiteSpace(evt.Sensations)
            && (string.IsNullOrWhiteSpace(evt.Label) || evt.Label == slot.Label)
            && (evt.Time == null || evt.Time == slot.DefaultTime)
            && GetConcurrentActivities(evt.MealSlot.Value).Count == 0;
    }

    TimeOnly GetRowTime(FriseRow row)
    {
        if (row.Event?.Time != null) return row.Event.Time.Value;
        if (row.Event?.MealSlot != null) return DiaryService.MealSlots[row.Event.MealSlot.Value].DefaultTime;
        return row.EmptySlot.HasValue ? DiaryService.MealSlots[row.EmptySlot.Value].DefaultTime : TimeOnly.MinValue;
    }

    TimeOnly CalcInsertTime(FriseRow? prev, FriseRow? next)
    {
        var p = prev != null ? GetRowTime(prev) : (TimeOnly?)null;
        var n = next != null ? GetRowTime(next) : (TimeOnly?)null;
        if (p == null && n == null) return new TimeOnly(12, 0);
        if (p == null) return n!.Value.AddMinutes(-30);
        if (n == null) return p.Value.AddMinutes(30);
        var mid = (p.Value.ToTimeSpan().TotalMinutes + n.Value.ToTimeSpan().TotalMinutes) / 2.0;
        return new TimeOnly((int)(mid / 60) % 24, (int)mid % 60);
    }

    async Task InsertActivity(TimeOnly betweenTime)
    {
        currentLog ??= await DiaryService.GetOrCreateDailyLogAsync(diary!.Id, selectedDate);
        var act = await DiaryService.AddActivityAfterSlotAsync(currentLog.Id, null);
        await DiaryService.UpdateEventTimeAsync(act.Id, betweenTime);
        editingEventId = act.Id;
        await LoadDay();
    }

