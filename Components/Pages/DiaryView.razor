@page "/carnet/{AccessCode}/journal"
@inject DiaryService DiaryService
@inject DiarySessionService Session

<PageTitle>Mon carnet — NutriPlan</PageTitle>

@if (diary == null && !isLoading)
{
    <div class="max-w-sm mx-auto py-8">
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5 text-center">
            <div class="text-3xl mb-2">🔍</div>
            <h2 class="text-base font-semibold text-gray-700 mb-3">Carnet introuvable</h2>
            <a href="/" class="inline-block bg-primary-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-primary-700 transition-colors">
                Retour à l'accueil
            </a>
        </div>
    </div>
}
else if (isLoading)
{
    <div class="text-center text-gray-400 py-12">Chargement…</div>
}
else if (showPinForm)
{
    <div class="max-w-sm mx-auto py-8">
        <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-5">
            <div class="text-center mb-4">
                <div class="text-3xl mb-1.5">🔒</div>
                <h2 class="text-base font-bold text-gray-800">Carnet protégé</h2>
                <p class="text-gray-400 text-xs mt-1">Saisissez votre code PIN pour accéder à votre carnet.</p>
            </div>
            <div class="space-y-3">
                <input @bind="pinInput" @bind:event="oninput" @onkeyup="OnPinKeyUp"
                       type="password" placeholder="Code PIN"
                       class="w-full bg-slate-50 rounded-lg px-4 py-2 text-sm text-center tracking-widest focus:outline-none focus:ring-2 focus:ring-primary-300 border-0"
                       maxlength="8" />
                @if (pinError)
                {
                    <p class="text-red-500 text-xs text-center">Code PIN incorrect.</p>
                }
                <button @onclick="ValidatePin"
                        class="w-full bg-primary-600 hover:bg-primary-700 text-white py-2 rounded-lg text-sm font-medium transition-colors">
                    Accéder à mon carnet
                </button>
            </div>
        </div>
    </div>
}
else
{
    <div class="space-y-3">
        <!-- En-tête compact -->
        <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
                <h1 class="text-sm font-semibold text-gray-700 truncate">Mon carnet</h1>
                <span class="text-[10px] text-gray-400 font-mono bg-slate-100 px-1.5 py-0.5 rounded">@AccessCode</span>
            </div>
            <div class="flex items-center gap-1.5 flex-shrink-0">
                @if (!showHistory)
                {
                    <div class="flex bg-slate-100 rounded-md p-0.5 text-[11px] font-medium">
                        <button @onclick="() => tableView = false"
                                class="px-2.5 py-1 rounded transition-colors @(!tableView ? "bg-white shadow-sm text-gray-700" : "text-gray-400")">
                            Frise
                        </button>
                        <button @onclick="() => tableView = true"
                                class="px-2.5 py-1 rounded transition-colors @(tableView ? "bg-white shadow-sm text-gray-700" : "text-gray-400")">
                            Tableau
                        </button>
                    </div>
                }
                <button @onclick="() => showHistory = !showHistory"
                        class="text-xs text-primary-600 border border-primary-200 hover:border-primary-400 px-2.5 py-1 rounded-lg transition-colors">
                    @(showHistory ? "← Journée" : "Historique")
                </button>
            </div>
        </div>

        @if (showHistory)
        {
            <HistoryView DiaryId="@diary!.Id" OnDateSelected="SelectDate" />
        }
        else
        {
            <!-- Navigation date -->
            <div class="bg-white rounded-xl border border-slate-100 shadow-sm px-2 py-1.5 flex items-center gap-2">
                <button @onclick="PreviousDay" class="p-1.5 rounded-lg hover:bg-slate-50 text-gray-400 transition-colors text-sm leading-none">←</button>
                <div class="text-center flex-1 flex items-center justify-center gap-2">
                    <p class="font-semibold text-gray-700 capitalize text-sm">
                        @selectedDate.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))
                    </p>
                    @if (selectedDate == DateOnly.FromDateTime(DateTime.Today))
                    {
                        <span class="text-[10px] bg-primary-100 text-primary-600 px-1.5 py-0.5 rounded-full flex-shrink-0">Auj.</span>
                    }
                </div>
                <button @onclick="NextDay" disabled="@(selectedDate >= DateOnly.FromDateTime(DateTime.Today))"
                        class="p-1.5 rounded-lg hover:bg-slate-50 disabled:opacity-30 text-gray-400 transition-colors text-sm leading-none">→</button>
            </div>

            @if (tableView)
            {
                <DiaryTableView
                    DailyLog="@currentLog"
                    DiaryId="@diary!.Id"
                    Date="@selectedDate"
                    OnChanged="@LoadDay" />
            }
            else
            {
                <!-- Frise verticale -->
                <div class="relative">
                    <div class="absolute left-4 top-4 bottom-4 w-px bg-slate-200 z-0"></div>

                    <div class="space-y-1">
                        @for (int si = 0; si < DiaryService.MealSlots.Length; si++)
                        {
                            int slotIdx = si;
                            var slot = DiaryService.MealSlots[slotIdx];
                            var mealEvent = GetMealSlotEvent(slotIdx);

                            <!-- Activités + zone de dépôt AVANT le premier jalon -->
                            @if (slotIdx == 0)
                            {
                                var before = GetActivitiesBeforeAll();
                                @foreach (var act in before)
                                {
                                    var a = act;
                                    <div class="pl-10 mb-1" draggable="true"
                                         @ondragstart="() => StartDrag(a)" @ondragend="EndDrag"
                                         style="@DragStyle(a.Id)">
                                        <EventCard Event="a" OnChanged="LoadDay" OnDelete="DeleteEvent" />
                                    </div>
                                }
                                <div class="pl-10 mb-1">
                                    <!-- zone dépôt activité avant slot 0 (index -1) -->
                                    @if (draggedEvent?.EventType == DayEventType.Activity)
                                    {
                                        <div class="@ActDropZoneClass(-1) mb-1 rounded-lg transition-all duration-150 text-center text-[10px] text-primary-400"
                                             @ondragover:preventDefault="true"
                                             @ondragover="() => actDropTarget = -1"
                                             @ondragleave="() => ClearActDrop(-1)"
                                             @ondrop="async () => await HandleActivityDrop(null)">
                                            @if (actDropTarget == -1) { <span>Déposer ici</span> }
                                        </div>
                                    }
                                    <button @onclick="() => AddActivity(null)" class="@AddActivityBtnClass">+ Activité</button>
                                </div>
                            }

                            <!-- Nœud du jalon alimentaire -->
                            <div class="flex gap-2.5 items-start relative z-10 mb-0.5"
                                 @ondragover:preventDefault="true"
                                 @ondragover="() => OnMealSlotDragOver(slotIdx)"
                                 @ondragleave="() => OnMealSlotDragLeave(slotIdx)"
                                 @ondrop="async () => await HandleMealDrop(slotIdx)">
                                <!-- Icône -->
                                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-white border-2 @SlotBorderClass(slotIdx) flex items-center justify-center text-sm shadow-sm z-10 transition-all @(mealDropTarget == slotIdx ? "ring-2 ring-primary-400 scale-110" : "")">
                                    @slot.Icon
                                </div>
                                <!-- Contenu -->
                                <div class="flex-1 min-w-0">
                                    @if (mealEvent == null)
                                    {
                                        <div class="bg-white rounded-xl border @(mealDropTarget == slotIdx ? "border-primary-300 bg-primary-50/40" : "border-dashed border-slate-200") px-3 py-2 flex items-center gap-2 transition-colors">
                                            <div class="flex-1 min-w-0">
                                                <p class="font-medium text-gray-400 text-sm">@slot.Label</p>
                                                <p class="text-[10px] text-gray-300 font-mono">@slot.DefaultTime.ToString("HH:mm")</p>
                                            </div>
                                            <button @onclick="() => StartMealSlot(slotIdx)"
                                                    class="flex-shrink-0 bg-primary-50 hover:bg-primary-100 text-primary-600 border border-primary-200 px-2.5 py-1 rounded-lg text-xs font-medium transition-colors">
                                                + Saisir
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div draggable="true"
                                             @ondragstart="() => StartDrag(mealEvent)"
                                             @ondragend="EndDrag"
                                             style="@DragStyle(mealEvent.Id) cursor:grab">
                                            <EventCard Event="mealEvent"
                                                       ConcurrentActivities="@GetConcurrentActivities(slotIdx)"
                                                       OnChanged="LoadDay" OnDelete="DeleteEvent" />
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Zone inter-jalons : activités draggables + zone de dépôt -->
                            <div class="pl-10 py-0.5 space-y-1.5">
                                @foreach (var act in GetActivitiesAfterSlot(slotIdx))
                                {
                                    var a = act;
                                    <div draggable="true"
                                         @ondragstart="() => StartDrag(a)" @ondragend="EndDrag"
                                         style="@DragStyle(a.Id) cursor:grab">
                                        <EventCard Event="a" OnChanged="LoadDay" OnDelete="DeleteEvent" />
                                    </div>
                                }
                                @if (draggedEvent?.EventType == DayEventType.Activity)
                                {
                                    <div class="@ActDropZoneClass(slotIdx) rounded-lg transition-all duration-150 text-center text-[10px] text-primary-400"
                                         @ondragover:preventDefault="true"
                                         @ondragover="() => actDropTarget = slotIdx"
                                         @ondragleave="() => ClearActDrop(slotIdx)"
                                         @ondrop="async () => await HandleActivityDrop(slotIdx)">
                                        @if (actDropTarget == slotIdx) { <span>Déposer ici</span> }
                                    </div>
                                }
                                <button @onclick="() => AddActivity(slotIdx)" class="@AddActivityBtnClass">+ Activité sportive</button>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Bilan journée -->
            <div class="bg-white rounded-xl border border-slate-100 shadow-sm p-3">
                <h3 class="font-semibold text-gray-600 mb-3 flex items-center gap-1.5 text-sm"><span>📊</span> Bilan de la journée</h3>

                <!-- Stats calculées automatiquement -->
                <div class="grid grid-cols-2 gap-2 mb-3">
                    <div class="bg-blue-50 rounded-lg px-3 py-2">
                        <p class="text-[10px] text-blue-400 font-medium mb-0.5">💧 Hydratation</p>
                        <p class="text-base font-bold text-blue-700 leading-tight">@FormatHydration(EstimatedHydrationMl)</p>
                        <p class="text-[10px] text-blue-300">@TotalDrinksCount prise(s)</p>
                    </div>
                    <div class="bg-emerald-50 rounded-lg px-3 py-2">
                        <p class="text-[10px] text-emerald-400 font-medium mb-0.5">🏃 Activité</p>
                        <p class="text-base font-bold text-emerald-700 leading-tight">@FormatActivity(TotalActivityMinutes)</p>
                        <p class="text-[10px] text-emerald-300">@TotalActivityCount activité(s)</p>
                    </div>
                </div>

                <div class="space-y-2">
                    <div>
                        <label class="block text-[11px] font-medium text-gray-400 mb-1">🧘 Émotions / Stress (journée)</label>
                        <textarea @bind="emotions" @onblur="SaveDaySummary" rows="2" placeholder="Comment vous sentez-vous globalement aujourd'hui ?"
                                  class="w-full bg-slate-50 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-300 resize-none border-0 placeholder-gray-300"></textarea>
                    </div>
                    <div>
                        <label class="block text-[11px] font-medium text-gray-400 mb-1">📝 Notes générales</label>
                        <textarea @bind="generalNotes" @onblur="SaveDaySummary" rows="2" placeholder="Observations, remarques…"
                                  class="w-full bg-slate-50 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-300 resize-none border-0 placeholder-gray-300"></textarea>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string AccessCode { get; set; } = "";

    FoodDiary? diary;
    DailyLog? currentLog;
    DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    bool isLoading = true;
    bool showPinForm;
    bool pinError;
    string pinInput = "";
    bool showHistory;
    bool tableView;
    string emotions = "", generalNotes = "";

    const string AddActivityBtnClass =
        "w-full border border-dashed border-gray-200 hover:border-green-300 text-gray-300 hover:text-green-500 rounded-xl py-1.5 text-xs font-medium transition-colors";

    // ── Drag & drop ──────────────────────────────────────────────────────────
    DayEvent? draggedEvent;
    int? actDropTarget;   // -1 = avant slot 0 ; 0-5 = après slot n
    int? mealDropTarget;  // slot cible pour un jalon repas

    void StartDrag(DayEvent evt) { draggedEvent = evt; actDropTarget = null; mealDropTarget = null; }
    void EndDrag() { draggedEvent = null; actDropTarget = null; mealDropTarget = null; }

    void OnMealSlotDragOver(int slotIdx)  { if (draggedEvent?.EventType == DayEventType.Meal)     mealDropTarget = slotIdx; }
    void OnMealSlotDragLeave(int slotIdx) { if (mealDropTarget == slotIdx) mealDropTarget = null; }
    void ClearActDrop(int zoneId)         { if (actDropTarget == zoneId)   actDropTarget  = null; }

    string DragStyle(int id) => draggedEvent?.Id == id ? "opacity:0.35;" : "";
    string ActDropZoneClass(int zoneId) => actDropTarget == zoneId
        ? "border border-dashed border-primary-300 bg-primary-50/50 py-2"
        : "border border-dashed border-transparent py-0.5";

    async Task HandleActivityDrop(int? afterSlot)
    {
        if (draggedEvent == null || draggedEvent.EventType != DayEventType.Activity) return;
        actDropTarget = null;
        await DiaryService.MoveActivityAsync(draggedEvent.Id, afterSlot);
        draggedEvent = null;
        await LoadDay();
    }

    async Task HandleMealDrop(int targetSlot)
    {
        if (draggedEvent == null || draggedEvent.EventType != DayEventType.Meal) return;
        if (draggedEvent.MealSlot == targetSlot) { mealDropTarget = null; return; }
        mealDropTarget = null;
        await DiaryService.SwapOrMoveMealSlotAsync(draggedEvent.Id, targetSlot);
        draggedEvent = null;
        await LoadDay();
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true; showPinForm = false; pinError = false;
        var code = AccessCode.ToUpperInvariant();
        diary = await DiaryService.GetDiaryByCodeAsync(code);
        if (diary == null) { isLoading = false; return; }
        if (diary.PinHash != null && !Session.IsUnlocked(code)) { showPinForm = true; isLoading = false; return; }
        Session.Unlock(code); isLoading = false;
        await LoadDay();
    }

    async Task ValidatePin()
    {
        pinError = false;
        var valid = await DiaryService.ValidatePinAsync(diary!.AccessCode, pinInput);
        if (valid) { Session.Unlock(diary.AccessCode); showPinForm = false; await LoadDay(); }
        else { pinError = true; }
    }

    void OnPinKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") _ = ValidatePin(); }

    async Task LoadDay()
    {
        currentLog = await DiaryService.GetDailyLogFullAsync(diary!.Id, selectedDate);
        emotions = currentLog?.Emotions ?? "";
        generalNotes = currentLog?.GeneralNotes ?? "";
    }

    async Task PreviousDay() { selectedDate = selectedDate.AddDays(-1); await LoadDay(); }

    async Task NextDay()
    {
        if (selectedDate < DateOnly.FromDateTime(DateTime.Today)) { selectedDate = selectedDate.AddDays(1); await LoadDay(); }
    }

    void SelectDate(DateOnly date) { selectedDate = date; showHistory = false; _ = LoadDay(); }

    async Task StartMealSlot(int slotIndex)
    {
        currentLog ??= await DiaryService.GetOrCreateDailyLogAsync(diary!.Id, selectedDate);
        await DiaryService.GetOrCreateMealSlotEventAsync(currentLog.Id, slotIndex);
        await LoadDay();
    }

    async Task AddActivity(int? afterSlot)
    {
        currentLog ??= await DiaryService.GetOrCreateDailyLogAsync(diary!.Id, selectedDate);
        await DiaryService.AddActivityAfterSlotAsync(currentLog.Id, afterSlot);
        await LoadDay();
    }

    async Task DeleteEvent(int eventId)
    {
        await DiaryService.DeleteEventAsync(eventId);
        await LoadDay();
    }

    async Task SaveDaySummary()
    {
        currentLog ??= await DiaryService.GetOrCreateDailyLogAsync(diary!.Id, selectedDate);
        await DiaryService.UpdateDailyLogSummaryAsync(currentLog.Id, null, emotions, generalNotes);
    }

    // ── Stats calculées ──────────────────────────────────────────────────────

    static readonly Dictionary<string, int> DrinkVolumes = new()
    {
        { "Eau (1 verre)",      250 }, { "Eau (75cl)",        750 }, { "Eau (1,5L)",       1500 },
        { "Eau gazeuse",        250 }, { "Café expresso",      30 }, { "Café allongé",      120 },
        { "Thé (grande tasse)", 350 }, { "Boisson isotonique", 500 }, { "Électrolytes",      500 },
        { "Sirop",              200 }, { "Jus de fruit",       200 },
    };

    int EstimatedHydrationMl => (currentLog?.Events ?? [])
        .SelectMany(e => e.DrinkEntries)
        .Sum(d => DrinkVolumes.TryGetValue(d.DrinkName, out var v) ? v : 200);

    int TotalDrinksCount => (currentLog?.Events ?? [])
        .Sum(e => e.DrinkEntries.Count);

    int TotalActivityMinutes => (currentLog?.Events ?? [])
        .Where(e => e.EventType == DayEventType.Activity && e.DurationMinutes.HasValue)
        .Sum(e => e.DurationMinutes!.Value);

    int TotalActivityCount => (currentLog?.Events ?? [])
        .Count(e => e.EventType == DayEventType.Activity);

    static string FormatHydration(int ml) =>
        ml == 0 ? "—" : ml >= 1000 ? $"≈ {ml / 1000.0:0.#} L" : $"≈ {ml} ml";

    static string FormatActivity(int minutes) =>
        minutes == 0 ? "—" :
        minutes >= 60 ? $"{minutes / 60}h{(minutes % 60 > 0 ? $" {minutes % 60}min" : "")}" :
        $"{minutes} min";

    DayEvent? GetMealSlotEvent(int slotIndex)
        => currentLog?.Events.FirstOrDefault(e => e.MealSlot == slotIndex);

    IEnumerable<DayEvent> GetActivitiesBeforeAll()
        => (currentLog?.Events ?? [])
            .Where(e => e.EventType == DayEventType.Activity
                     && e.ActivityAfterSlot == null
                     && !e.ConcurrentWithMealSlot.HasValue)
            .OrderBy(e => e.Time).ThenBy(e => e.CreatedAt);

    IEnumerable<DayEvent> GetActivitiesAfterSlot(int? afterSlot)
        => (currentLog?.Events ?? [])
            .Where(e => e.EventType == DayEventType.Activity
                     && e.ActivityAfterSlot == afterSlot
                     && !e.ConcurrentWithMealSlot.HasValue)
            .OrderBy(e => e.Time).ThenBy(e => e.CreatedAt);

    IReadOnlyList<DayEvent> GetConcurrentActivities(int slotIdx)
        => (currentLog?.Events ?? [])
            .Where(e => e.EventType == DayEventType.Activity && e.ConcurrentWithMealSlot == slotIdx)
            .OrderBy(e => e.Time).ThenBy(e => e.CreatedAt)
            .ToList();

    static string SlotBorderClass(int idx) => idx switch
    {
        0 => "border-amber-300",
        1 => "border-green-300",
        2 => "border-blue-300",
        3 => "border-purple-300",
        4 => "border-indigo-300",
        5 => "border-slate-300",
        _ => "border-gray-200"
    };
}
