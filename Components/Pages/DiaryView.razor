    // ── Gestion du PIN ────────────────────────────────────────────────────

    async Task SetOrChangePin()
    {
        pinFormError = null;
        if (!System.Text.RegularExpressions.Regex.IsMatch(pinNew, @"^\d{4,8}$"))
        {
            pinFormError = "Le nouveau PIN doit comporter 4 à 8 chiffres.";
            return;
        }
        var ok = await DiaryService.UpdatePinAsync(diary!.Id,
            string.IsNullOrEmpty(pinCurrent) ? null : pinCurrent, pinNew);
        if (!ok) { pinFormError = "PIN actuel incorrect."; return; }
        await ReloadDiaryAfterPinChange();
        Toast.ShowSuccess("PIN mis à jour.");
    }

    async Task DeletePin()
    {
        pinFormError = null;
        var ok = await DiaryService.UpdatePinAsync(diary!.Id,
            string.IsNullOrEmpty(pinCurrent) ? null : pinCurrent, null);
        if (!ok) { pinFormError = "PIN actuel incorrect."; return; }
        await ReloadDiaryAfterPinChange();
        Toast.ShowSuccess("PIN supprimé.");
    }

    // Recharge le carnet après modification du PIN, sans repasser par le
    // formulaire de déverrouillage : la session courante est re-déverrouillée
    // avec l'empreinte du NOUVEAU PIN (les autres navigateurs, eux, devront le saisir).
    async Task ReloadDiaryAfterPinChange()
    {
        var code = AccessCode.ToUpperInvariant();
        diary = await DiaryService.GetDiaryByCodeAsync(code);
        pinCurrent = ""; pinNew = "";
        await Session.UnlockAsync(code, DiarySessionService.PinStamp(diary!.PinHash));
    }

    async Task PrintDay() => await JS.InvokeVoidAsync("nutriplan.print");

    // ── Drag & drop ──────────────────────────────────────────────────────────
    DayEvent? draggedEvent;
    int? actDropTarget;   // index de la zone d'insertion survolée pendant le drag d'une activité
    int? armedInsert;     // couture « ouverte » par un premier appui (tactile : appui 1 = révéler, appui 2 = créer)
    int? mealDropTarget;  // slot cible pour un jalon repas

    void StartDrag(DayEvent evt) { draggedEvent = evt; actDropTarget = null; mealDropTarget = null; }
    void EndDrag() { draggedEvent = null; actDropTarget = null; mealDropTarget = null; }

    void OnMealSlotDragOver(int slotIdx)  { if (draggedEvent?.EventType == DayEventType.Meal)     mealDropTarget = slotIdx; }
    void OnMealSlotDragLeave(int slotIdx) { if (mealDropTarget == slotIdx) mealDropTarget = null; }

    void OnInsertDragOver(int zoneId)  { if (draggedEvent?.EventType == DayEventType.Activity) actDropTarget = zoneId; }
    void OnInsertDragLeave(int zoneId) { if (actDropTarget == zoneId) actDropTarget = null; }

    string DragStyle(int id) => draggedEvent?.Id == id ? "opacity:0.35;" : "";

    // Dépôt d'une activité sur une zone d'insertion : elle prend l'heure de la zone.
    async Task HandleActivityDropAt(TimeOnly time, int zoneId)
    {
        if (draggedEvent == null || draggedEvent.EventType != DayEventType.Activity) { actDropTarget = null; return; }
        actDropTarget = null;
        var evtId = draggedEvent.Id;
        draggedEvent = null;
        try
        {
            await DiaryService.UpdateEventTimeAsync(evtId, time);
            await LoadDay();
            Toast.ShowSaved();
        }
        catch { Toast.ShowError(SaveError); }
    }

    async Task HandleMealDrop(int targetSlot)
    {
        if (draggedEvent == null || draggedEvent.EventType != DayEventType.Meal) return;
        if (draggedEvent.MealSlot == targetSlot) { mealDropTarget = null; return; }
        mealDropTarget = null;
        await DiaryService.SwapOrMoveMealSlotAsync(draggedEvent.Id, targetSlot);
        draggedEvent = null;
        await LoadDay();
    }

    protected override async Task OnInitializedAsync()
    {
        // Date du jour côté client (fuseau du navigateur) — prerender désactivé,
        // le JS interop est disponible dès l'initialisation.
        selectedDate = await Time.TodayAsync();

        // Retour du callback OAuth Strava : récupérer le billet AVANT de nettoyer l'URL.
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        if (query.TryGetValue("sat", out var satValues)) pendingStravaTicket = satValues.ToString();

        if (Nav.Uri.Contains("strava=ok"))
        {
            Toast.ShowSuccess("Strava connecté ✓");
            Nav.NavigateTo($"/carnet/{AccessCode}/journal", replace: true);
        }
        else if (Nav.Uri.Contains("strava=partial"))
        {
            Toast.ShowError("Strava connecté, mais sans l'accès aux activités privées : elles ne seront pas importées. Pour tout importer, reconnectez Strava en cochant la case « activités privées ».");
            Nav.NavigateTo($"/carnet/{AccessCode}/journal", replace: true);
        }
        else if (Nav.Uri.Contains("strava=failed"))
        {
            Toast.ShowError("Connexion Strava échouée — vérifiez la configuration et réessayez.");
            Nav.NavigateTo($"/carnet/{AccessCode}/journal", replace: true);
        }
        else if (pendingStravaTicket != null)
        {
            Nav.NavigateTo($"/carnet/{AccessCode}/journal", replace: true);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await Session.EnsureLoadedAsync();
        if (IsNew) showNewBanner = true;
        isLoading = true; showPinForm = false; pinError = false; showStravaGate = false;
        var code = AccessCode.ToUpperInvariant();
        diary = await DiaryService.GetDiaryByCodeAsync(code);
        if (diary == null) { isLoading = false; return; }

        // Empreinte d'accès complète : PIN + compte Strava lié le cas échéant.
        var stamp = DiarySessionService.AccessStamp(diary.PinHash, diary.StravaAthleteId);
        if (!Session.IsUnlocked(code, stamp))
        {
            // Carnet lié à Strava : le code d'accès seul ne suffit plus — il faut la
            // preuve du compte (billet émis par le callback OAuth), puis le PIN éventuel.
            if (diary.StravaAthleteId != null && !Strava.TryConsumeLoginTicket(pendingStravaTicket, diary.Id))
            {
                pendingStravaTicket = null;
                showStravaGate = true; isLoading = false; return;
            }
            pendingStravaTicket = null;
            if (diary.PinHash != null) { showPinForm = true; isLoading = false; return; }
        }
        await Session.UnlockAsync(code, stamp); isLoading = false;
        assignedNutri = await DiaryService.GetAssignedNutritionistAsync(diary.Id);
        LoadProfileFields();
        await LoadDay();
        await AutoSyncStravaAsync();
    }

    async Task ValidatePin()
    {
        pinError = false;
        var valid = await DiaryService.ValidatePinAsync(diary!.AccessCode, pinInput);
        if (valid)
        {
            await Session.UnlockAsync(diary.AccessCode, DiarySessionService.AccessStamp(diary.PinHash, diary.StravaAthleteId));
            showPinForm = false;
            assignedNutri = await DiaryService.GetAssignedNutritionistAsync(diary.Id);
        LoadProfileFields();
            await LoadDay();
            await AutoSyncStravaAsync();
        }
        else { pinError = true; }
    }

    async Task OnPinKeyUp(KeyboardEventArgs e) { if (e.Key == "Enter") await ValidatePin(); }

    async Task LoadDay()
    {
        currentLog = await DiaryService.GetDailyLogFullAsync(diary!.Id, selectedDate);
        armedInsert = null;
        // Balayage : un jalon créé puis laissé vierge (éditeur refermé, onglet fermé,
        // déconnexion) est supprimé et redevient fantôme — sauf celui en cours d'édition.
        var untouched = (currentLog?.Events ?? []).Where(e => e.Id != editingEventId && IsUntouchedSlotEvent(e)).Select(e => e.Id).ToList();
        if (untouched.Count > 0)
        {
            foreach (var id in untouched) { try { await DiaryService.DeleteEventAsync(id); } catch { } }
            currentLog = await DiaryService.GetDailyLogFullAsync(diary.Id, selectedDate);
        }
        emotions = currentLog?.Emotions ?? "";
        generalNotes = currentLog?.GeneralNotes ?? "";
        foodSuggestions = await DiaryService.GetFoodSuggestionsAsync(diary.Id);
        topFoods = await DiaryService.GetTopFoodsAsync(diary.Id);
        topCompositions = await DiaryService.GetTopCompositionsAsync(diary.Id);
        if (catalog.Count == 0) catalog = await DiaryService.GetCatalogAsync();
    }

    // ── Changement de jour : chevrons et swipe tactile, avec animation de « page » ──

    string swipeAnim = "";                              // classe d'animation du conteneur @key
    DotNetObjectReference<DiaryView>? swipeRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Idempotent (garde côté JS) : l'élément n'existe qu'une fois le carnet
        // déverrouillé, on retente donc à chaque rendu.
        swipeRef ??= DotNetObjectReference.Create(this);
        try { await JS.InvokeVoidAsync("nutriplan.attachDaySwipe", "journal-swipe", swipeRef); }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public async Task OnDaySwipe(string direction)
    {
        // Pas de changement de jour en pleine édition ni hors de la frise.
        if (editingEventId != null || showHistory || showMoveDay || tableView) return;
        if (direction == "next") await NextDay();
        else await PreviousDay();
        StateHasChanged();
    }

    public void Dispose() => swipeRef?.Dispose();

    async Task PreviousDay() { swipeAnim = "day-slide-in-left"; editingEventId = null; selectedDate = selectedDate.AddDays(-1); await LoadDay(); }

    async Task NextDay()
    {
        if (selectedDate < Time.Today) { swipeAnim = "day-slide-in-right"; editingEventId = null; selectedDate = selectedDate.AddDays(1); await LoadDay(); }
    }

    async Task SelectDate(DateOnly date)
    {
        editingEventId = null;
        selectedDate = date;
        showHistory = false;
        await LoadDay();
    }

    // ── Déplacement d'une journée saisie sur la mauvaise date ───────────────
    bool showMoveDay;
    DateOnly moveTargetDate;
    string? moveError;

    void OpenMoveDay()
    {
        showMoveDay = !showMoveDay;
        moveError = null;
        moveTargetDate = selectedDate.AddDays(-1); // erreur typique : saisie sur le lendemain
    }

    async Task MoveDay()
    {
        moveError = null;
        if (moveTargetDate == selectedDate) { moveError = "Choisissez une autre date que la journée actuelle."; return; }
        if (moveTargetDate > Time.Today) { moveError = "Impossible de déplacer vers une date future."; return; }
        try
        {
            var moved = await DiaryService.MoveDailyLogAsync(diary!.Id, selectedDate, moveTargetDate);
            if (!moved) { moveError = "Cette date contient déjà des saisies — choisissez un jour vide."; return; }
            showMoveDay = false;
            editingEventId = null;
            selectedDate = moveTargetDate; // on suit la journée déplacée
            await LoadDay();
            Toast.ShowSuccess("Journée déplacée ✓");
        }
        catch { Toast.ShowError(SaveError); }
    }

