@page "/carnet/{AccessCode}/journal"
@inject DiaryService DiaryService
@inject DiarySessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject NutritionistService NutritionistService
@inject StravaService Strava
@inject BrowserTimeService Time
@inject ToastService Toast
@implements IDisposable

<PageTitle>Mon carnet — NutriPlan</PageTitle>

@if (diary == null && !isLoading)
{
    <div class="max-w-sm mx-auto py-8">
        <div class="bg-white rounded-xl shadow-sm p-5 text-center">
            <div class="text-3xl mb-2">🔍</div>
            <h2 class="font-display text-lg font-semibold text-gray-800 mb-3">Carnet introuvable</h2>
            <a href="/" class="inline-block bg-volt text-carbon px-4 py-2 rounded-lg text-sm font-medium hover:bg-volt-dark transition-colors">
                Retour à l'accueil
            </a>
        </div>
    </div>
}
else if (isLoading)
{
    <div class="text-center text-gray-400 py-12">Chargement…</div>
}
else if (showPinForm)
{
    <div class="max-w-sm mx-auto py-8">
        <div class="bg-white rounded-xl shadow-sm p-5">
            <div class="text-center mb-4">
                <div class="text-3xl mb-1.5">🔒</div>
                <h2 class="font-display text-lg font-semibold text-gray-800">Carnet protégé</h2>
                <p class="text-gray-400 text-xs mt-1">Saisissez votre code PIN pour accéder à votre carnet.</p>
            </div>
            <div class="space-y-3">
                <div>
                    <label for="pin-unlock" class="block text-xs font-medium text-gray-500 mb-1">Code PIN</label>
                    <input id="pin-unlock" @bind="pinInput" @bind:event="oninput" @onkeyup="OnPinKeyUp"
                           type="password" inputmode="numeric" placeholder="Code PIN"
                           class="w-full bg-slate-50 rounded-lg px-4 py-2 text-sm text-center tracking-widest focus:outline-none focus:ring-2 focus:ring-primary-300 border-0"
                           maxlength="8" />
                </div>
                @if (pinError)
                {
                    <p class="text-red-500 text-xs text-center" role="alert">Code PIN incorrect.</p>
                }
                <button @onclick="ValidatePin"
                        class="w-full bg-volt hover:bg-volt-dark text-carbon py-2 rounded-lg text-sm font-medium transition-colors">
                    Accéder à mon carnet
                </button>
            </div>
        </div>
    </div>
}
else if (showStravaGate)
{
    <!-- Carnet lié à Strava : le code d'accès seul ne suffit plus -->
    <div class="max-w-sm mx-auto py-8">
        <div class="bg-white rounded-xl shadow-sm p-5 text-center">
            <div class="text-3xl mb-1.5">🔒</div>
            <h2 class="font-display text-lg font-semibold text-gray-800">Carnet protégé par Strava</h2>
            <p class="text-gray-400 text-xs mt-1 mb-4">
                Ce carnet est lié à un compte Strava : confirmez que c'est bien vous pour y accéder.
            </p>
            <a href="@StravaLoginUrl"
               class="inline-block bg-[#fc4c02] hover:bg-[#e34402] text-snow px-4 py-2 rounded-lg text-sm font-bold transition-colors">
                Se connecter avec Strava
            </a>
        </div>
    </div>
}
else
{
    <div class="space-y-3">

        <!-- ── Bannière premier accès ──────────────────────────────────── -->
        @if (showNewBanner)
        {
            <div class="bg-carbon text-snow rounded-lg px-3 py-2.5 flex items-center gap-2.5 print:hidden">
                <div class="flex-1 min-w-0">
                    <p class="text-[10px] font-medium opacity-70 leading-tight">Carnet créé !</p>
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="font-mono font-bold text-sm tracking-widest text-volt">@AccessCode</span>
                        <span class="text-[10px] opacity-60">— notez ce code, c'est votre clé d'accès</span>
                    </div>
                </div>
                <button @onclick="() => showNewBanner = false" aria-label="Fermer la bannière"
                        class="flex-shrink-0 text-snow/70 hover:text-snow text-xl leading-none transition-colors p-1.5 -m-1">×</button>
            </div>
        }

        <!-- ── Panneau profil : morphologie, niveau d'activité, objectifs ──── -->
        @if (showProfilePanel)
        {
            <div class="bg-white rounded-xl shadow-sm p-4 space-y-3 print:hidden">
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-semibold text-gray-700">Profil &amp; objectifs</h3>
                    <button @onclick="() => showProfilePanel = false" aria-label="Fermer le panneau profil"
                            class="text-gray-400 hover:text-gray-600 text-lg leading-none p-1.5 -m-1.5 transition-colors">×</button>
                </div>

                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                    <div class="flex items-center gap-1.5">
                        <label class="text-[11px] font-medium text-gray-400">Sexe</label>
                        <div class="flex gap-1">
                            @foreach (var sexOpt in new[] { ("F", "Femme"), ("M", "Homme") }) { var so = sexOpt;
                                <button @onclick="async () => { profileSex = profileSex == so.Item1 ? null : so.Item1; await SaveProfile(); }"
                                        class="px-2.5 py-1 rounded-full text-[11px] font-semibold transition-colors @(profileSex == so.Item1 ? "bg-carbon text-volt" : "bg-gray-100 text-gray-500 hover:bg-gray-200")">@so.Item2</button>
                            }
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <label class="text-[11px] font-medium text-gray-400">Taille</label>
                        <input type="number" min="80" max="250" @bind="profileHeight" @bind:after="SaveProfile" placeholder="—"
                               class="w-16 bg-slate-50 rounded-lg px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-primary-300 border-0 text-center" />
                        <span class="text-[11px] text-gray-400">cm</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <label class="text-[11px] font-medium text-gray-400">Poids</label>
                        <input type="number" min="20" max="350" step="0.5" @bind="profileWeight" @bind:after="SaveProfile" placeholder="—"
                               class="w-16 bg-slate-50 rounded-lg px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-primary-300 border-0 text-center" />
                        <span class="text-[11px] text-gray-400">kg</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <label class="text-[11px] font-medium text-gray-400">Année de naissance</label>
                        <input type="number" min="1900" max="2030" @bind="profileBirthYear" @bind:after="SaveProfile" placeholder="—"
                               class="w-20 bg-slate-50 rounded-lg px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-primary-300 border-0 text-center" />
                    </div>
                </div>

                <div class="flex items-center gap-1.5 flex-wrap">
                    <label class="text-[11px] font-medium text-gray-400 flex-shrink-0">Niveau d'activité</label>
                    <select @bind="profileActivity" @bind:after="SaveProfile"
                            class="flex-1 min-w-[200px] bg-slate-50 rounded-lg px-2 py-1.5 text-xs text-gray-600 focus:outline-none focus:ring-1 focus:ring-primary-300 border-0">
                        <option value="">—</option>
                        @foreach (var lvl in DiaryService.ActivityLevels)
                        { <option value="@lvl.Key">@lvl.Label</option> }
                    </select>
                </div>

                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                    <div class="flex items-center gap-1.5">
                        <label class="text-[11px] font-medium text-gray-400">Plafond kcal ingérées / j</label>
                        <input type="number" min="0" step="50" @bind="profileKcalTarget" @bind:after="SaveProfile" placeholder="—"
                               class="w-20 bg-slate-50 rounded-lg px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-primary-300 border-0 text-center" />
                    </div>
                    <div class="flex items-center gap-1.5">
                        <label class="text-[11px] font-medium text-gray-400">Objectif kcal dépensées / j</label>
                        <input type="number" min="0" step="50" @bind="profileBurnTarget" @bind:after="SaveProfile" placeholder="—"
                               class="w-20 bg-slate-50 rounded-lg px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-primary-300 border-0 text-center" />
                    </div>
                </div>

                @if (ProfileBmr is double panelBmr && ProfileNeeds is double panelNeeds)
                {
                    <div class="bg-carbon rounded-lg px-3 py-2.5">
                        <p class="text-[8.5px] uppercase tracking-[.14em] text-[#79838c] font-bold">Estimation (Mifflin-St Jeor × activité)</p>
                        <p class="font-display text-sm font-extrabold text-snow mt-1 tabular-nums">
                            Métabolisme de base ≈ <span class="text-volt">@((int)panelBmr) kcal/j</span>
                            &nbsp;·&nbsp; Besoins journaliers ≈ <span class="text-volt">@((int)panelNeeds) kcal/j</span>
                        </p>
                    </div>
                }
                else
                {
                    <p class="text-[11px] text-gray-400">Renseignez sexe, taille, poids et année de naissance pour estimer votre métabolisme de base.</p>
                }

                <!-- ── Strava : import automatique des activités sportives ── -->
                <div class="pt-2.5 border-t border-slate-100">
                    <div class="flex items-center gap-2 flex-wrap">
                        <p class="text-[11px] font-medium text-gray-400">🏃 Strava</p>
                        @if (!Strava.IsConfigured)
                        {
                            <p class="text-[11px] text-gray-400">Non configuré côté serveur (paramètres Strava:ClientId / Strava:ClientSecret).</p>
                        }
                        else if (string.IsNullOrEmpty(diary!.StravaRefreshToken))
                        {
                            <a href="@StravaAuthorizeUrl"
                               class="bg-[#fc4c02] hover:bg-[#e34402] text-snow px-3 py-1.5 rounded-lg text-xs font-bold transition-colors">
                                Connecter Strava
                            </a>
                        }
                        else
                        {
                            <span class="text-[11px] text-gray-500">Connecté@(diary!.StravaLastSyncAt is DateTime lastSync ? $" · dernière synchro {lastSync.ToLocalTime():dd/MM HH:mm}" : "")</span>
                            <button @onclick="SyncStrava" disabled="@stravaSyncing"
                                    class="bg-volt hover:bg-volt-dark disabled:opacity-50 text-carbon px-3 py-1.5 rounded-lg text-[10px] font-extrabold uppercase tracking-wide transition-colors">
                                @(stravaSyncing ? "Synchro…" : "Synchroniser")
                            </button>
                            <button @onclick="DeleteStravaActivities"
                                    class="text-[11px] transition-colors @(confirmStravaDelete ? "text-red-600 font-bold" : "text-gray-400 hover:text-red-500")">
                                @(confirmStravaDelete ? "Confirmer la suppression ?" : "Supprimer mes activités Strava")
                            </button>
                            <button @onclick="DisconnectStrava"
                                    class="text-[11px] text-gray-400 hover:text-red-500 transition-colors">
                                Déconnecter
                            </button>
                        }
                    </div>
                    <p class="text-[10px] text-gray-400 mt-1">Importe vos activités (titre, durée, distance, dénivelé, kcal) directement dans la frise.</p>
                </div>
            </div>
        }

        <!-- ── Panneau de partage (indépendant du bandeau) ──────────── -->
        @if (showSharePanel)
        {
            <div class="bg-white rounded-xl shadow-sm p-4 space-y-4 print:hidden">
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-semibold text-gray-700">Partager votre carnet</h3>
                    <button @onclick="CloseSharePanel" aria-label="Fermer le panneau de partage"
                            class="text-gray-400 hover:text-gray-600 text-lg leading-none p-1.5 -m-1.5 transition-colors">×</button>
                </div>

                <!-- WhatsApp + Email -->
                <div class="flex gap-2">
                    <a href="@WhatsAppShareUrl" target="_blank" rel="noopener"
                       class="flex-1 flex items-center justify-center gap-1.5 bg-green-50 hover:bg-green-100 text-green-700 text-xs font-medium px-3 py-2 rounded-xl transition-colors">
                        📲 WhatsApp
                    </a>
                    <a href="@EmailShareUrl" target="_blank"
                       class="flex-1 flex items-center justify-center gap-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-medium px-3 py-2 rounded-xl transition-colors">
                        ✉️ Email
                    </a>
                </div>

                <!-- Lien direct -->
                <div>
                    <p class="text-[11px] font-medium text-gray-400 mb-1.5">🔗 Lien direct</p>
                    <div class="flex gap-1.5">
                        <input readonly value="@DiaryShareUrl"
                               class="flex-1 min-w-0 bg-slate-50 rounded-lg px-2.5 py-1.5 text-[11px] font-mono text-gray-600 border-0 focus:outline-none" />
                        <button @onclick="CopyUrl"
                                class="flex-shrink-0 @(copiedUrl ? "bg-green-100 border-green-300 text-green-700" : "bg-slate-100 hover:bg-slate-200 border-slate-200 text-gray-600") border text-xs px-3 py-1.5 rounded-lg transition-colors whitespace-nowrap">
                            @(copiedUrl ? "✓ Copié !" : "Copier")
                        </button>
                    </div>
                </div>

                <!-- Nutritionniste -->
                <div>
                    <p class="text-[11px] font-medium text-gray-400 mb-1.5">👩‍⚕️ Partager avec mon nutritionniste</p>
                    @if (assignedNutri != null)
                    {
                        <div class="border border-slate-100 rounded-xl px-3 py-2 space-y-2">
                            <div class="flex items-center gap-2">
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-medium text-gray-700 truncate">@assignedNutri.Name</p>
                                    <p class="text-[10px] text-gray-400 truncate">@assignedNutri.Email</p>
                                </div>
                                <span class="flex-shrink-0 text-[11px] text-green-700 font-medium bg-green-50 px-2 py-0.5 rounded-full">✓ Accès actif</span>
                            </div>
                            @if (confirmRevoke)
                            {
                                <div class="flex items-center gap-1.5 justify-end flex-wrap">
                                    <button @onclick="RevokeNutritionist"
                                            class="bg-red-50 hover:bg-red-100 text-red-600 text-[11px] font-medium px-2.5 py-1.5 rounded-lg transition-colors">
                                        Confirmer la révocation ?
                                    </button>
                                    <button @onclick="() => confirmRevoke = false"
                                            class="text-gray-500 hover:text-gray-700 text-[11px] font-medium px-2.5 py-1.5 rounded-lg transition-colors">
                                        Annuler
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="flex justify-end">
                                    <button @onclick="() => confirmRevoke = true"
                                            class="text-red-500 hover:text-red-700 text-[11px] font-medium px-2.5 py-1.5 rounded-lg transition-colors">
                                        Révoquer l'accès
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <input value="@nutriSearch"
                               @oninput="OnNutriSearchInput"
                               type="text" placeholder="Rechercher par nom ou email…"
                               class="w-full bg-slate-50 rounded-lg px-2.5 py-1.5 text-sm border-0 focus:outline-none focus:ring-1 focus:ring-primary-300 placeholder-gray-400 mb-1.5" />
                        @if (nutriResults.Count > 0)
                        {
                            <div class="divide-y divide-slate-50 rounded-xl overflow-hidden">
                                @foreach (var n in nutriResults)
                                {
                                    var nutri = n;
                                    <div class="flex items-center gap-2 px-3 py-2 bg-white hover:bg-slate-50 transition-colors">
                                        <div class="flex-1 min-w-0">
                                            <p class="text-sm font-medium text-gray-700 truncate">@nutri.Name</p>
                                            <p class="text-[10px] text-gray-400 truncate">@nutri.Email</p>
                                        </div>
                                        @if (nutriAssignedId == nutri.Id)
                                        {
                                            <span class="text-[11px] text-green-600 font-medium flex-shrink-0">✓ Invité(e)</span>
                                        }
                                        else
                                        {
                                            <button @onclick="async () => await AssignNutritionist(nutri.Id)"
                                                    class="flex-shrink-0 bg-primary-50 hover:bg-primary-100 text-primary-600 text-[11px] font-medium px-2.5 py-1 rounded-lg transition-colors">
                                                + Inviter
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (nutriSearchDone && nutriResults.Count == 0)
                        {
                            <p class="text-[11px] text-gray-400 text-center py-2">Aucun résultat.</p>
                        }
                    }
                </div>

                <!-- Code PIN -->
                <div>
                    <p class="text-[11px] font-medium text-gray-400 mb-1.5 flex items-center gap-1">
                        <Icon Name="lock" Class="w-3 h-3" /> Code PIN
                    </p>
                    @if (diary!.PinHash == null)
                    {
                        <div class="flex gap-1.5">
                            <input @bind="pinNew" type="password" inputmode="numeric" maxlength="8"
                                   placeholder="Nouveau PIN (4 à 8 chiffres)" aria-label="Nouveau PIN (4 à 8 chiffres)"
                                   class="flex-1 min-w-0 bg-slate-50 rounded-lg px-2.5 py-1.5 text-sm border-0 focus:outline-none focus:ring-1 focus:ring-primary-300 placeholder-gray-400" />
                            <button @onclick="SetOrChangePin"
                                    class="flex-shrink-0 bg-volt hover:bg-volt-dark text-carbon text-xs font-medium px-3 py-1.5 rounded-lg transition-colors">
                                Définir le PIN
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-1.5">
                            <div class="flex gap-1.5 flex-wrap">
                                <input @bind="pinCurrent" type="password" inputmode="numeric" maxlength="8"
                                       placeholder="PIN actuel" aria-label="PIN actuel"
                                       class="flex-1 min-w-[110px] bg-slate-50 rounded-lg px-2.5 py-1.5 text-sm border-0 focus:outline-none focus:ring-1 focus:ring-primary-300 placeholder-gray-400" />
                                <input @bind="pinNew" type="password" inputmode="numeric" maxlength="8"
                                       placeholder="Nouveau PIN" aria-label="Nouveau PIN"
                                       class="flex-1 min-w-[110px] bg-slate-50 rounded-lg px-2.5 py-1.5 text-sm border-0 focus:outline-none focus:ring-1 focus:ring-primary-300 placeholder-gray-400" />
                            </div>
                            <div class="flex gap-1.5">
                                <button @onclick="SetOrChangePin"
                                        class="bg-volt hover:bg-volt-dark text-carbon text-xs font-medium px-3 py-1.5 rounded-lg transition-colors">
                                    Changer
                                </button>
                                <button @onclick="DeletePin"
                                        class="text-red-500 hover:text-red-700 text-xs font-medium px-3 py-1.5 rounded-lg transition-colors">
                                    Supprimer le PIN
                                </button>
                            </div>
                        </div>
                    }
                    @if (pinFormError != null)
                    {
                        <p role="alert" class="text-red-500 text-xs mt-1.5">@pinFormError</p>
                    }
                </div>
            </div>
        }

        <!-- En-tête compact -->
        <div class="flex items-center justify-between gap-2 print:hidden">
            <div class="flex items-center gap-2 min-w-0">
                <h1 class="font-display text-base font-semibold text-gray-800 truncate">Mon carnet</h1>
                <span class="text-[10px] text-gray-400 font-mono bg-slate-100 px-1.5 py-0.5 rounded">@AccessCode</span>
            </div>
            <div class="flex items-center gap-1.5 flex-shrink-0">
                @if (!showHistory)
                {
                    <div class="flex bg-gray-100 rounded-full p-0.5 text-[11px] font-semibold">
                        <button @onclick="() => tableView = false"
                                class="px-3 py-1 rounded-full transition-colors @(!tableView ? "bg-white shadow-sm text-gray-800" : "text-gray-400")">
                            Frise
                        </button>
                        <button @onclick="() => tableView = true"
                                class="px-3 py-1 rounded-full transition-colors @(tableView ? "bg-white shadow-sm text-gray-800" : "text-gray-400")">
                            Tableau
                        </button>
                    </div>
                    @if (tableView)
                    {
                        <button @onclick="PrintDay" aria-label="Imprimer la journée" title="Imprimer la journée"
                                class="p-2 rounded-full text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition-colors">
                            <Icon Name="printer" Class="w-3.5 h-3.5" />
                        </button>
                    }
                }
                <button @onclick="ToggleSharePanel"
                        title="Partager" aria-label="Partager le carnet"
                        class="p-2 rounded-full transition-colors @(showSharePanel ? "bg-primary-100 text-primary-700" : "text-gray-400 hover:bg-gray-100 hover:text-gray-600")">
                    <Icon Name="share-2" Class="w-3.5 h-3.5" />
                </button>
                <button @onclick="() => showProfilePanel = !showProfilePanel"
                        title="Profil" aria-label="Profil et objectifs"
                        class="p-2 rounded-full transition-colors @(showProfilePanel ? "bg-primary-100 text-primary-700" : "text-gray-400 hover:bg-gray-100 hover:text-gray-600")">
                    <Icon Name="user" Class="w-3.5 h-3.5" />
                </button>
                <button @onclick="() => showHistory = !showHistory"
                        class="text-xs font-semibold bg-primary-50 text-primary-700 hover:bg-primary-100 px-3 py-1.5 rounded-full transition-colors flex items-center gap-1">
                    @if (showHistory)
                    {
                        <Icon Name="arrow-left" Class="w-3 h-3" /><span>Journée</span>
                    }
                    else
                    {
                        <Icon Name="history" Class="w-3 h-3" /><span>Historique</span>
                    }
                </button>
            </div>
        </div>

        @if (showHistory)
        {
            <HistoryView DiaryId="@diary!.Id" OnDateSelected="SelectDate" />
        }
        else
        {
            @* Conteneur stable pour les écouteurs tactiles (swipe gauche/droite = jour
               suivant/précédent) ; le div interne, re-créé à chaque changement de date
               (@key), rejoue l'animation de « page » qui glisse depuis le bon côté. *@
            <div id="journal-swipe">
            <div @key="selectedDate" class="@swipeAnim">
            <!-- Navigation date -->
            <div class="flex items-end justify-between gap-2 pt-1">
                <div class="min-w-0">
                    <p class="font-display text-2xl font-extrabold tracking-tight leading-none text-carbon">
                        <span class="capitalize">@selectedDate.ToString("dddd", new System.Globalization.CultureInfo("fr-FR"))</span>
                        @selectedDate.ToString("d MMMM", new System.Globalization.CultureInfo("fr-FR"))
                    </p>
                    @if (selectedDate == Time.Today)
                    {
                        <p class="inline-block text-[9px] font-extrabold uppercase tracking-[.14em] bg-carbon text-volt px-2 py-1 rounded-[4px] mt-1.5">Aujourd'hui</p>
                    }
                    @if ((currentLog?.Events.Count ?? 0) > 0)
                    {
                        <button @onclick="OpenMoveDay"
                                class="block text-[10px] font-semibold text-gray-400 hover:text-gray-600 mt-1.5 transition-colors print:hidden">
                            ⇄ Déplacer cette journée…
                        </button>
                    }
                </div>
                <div class="flex items-center flex-shrink-0 print:hidden">
                    <button @onclick="PreviousDay" aria-label="Jour précédent"
                            class="p-2 rounded-full hover:bg-gray-100 text-gray-400 hover:text-gray-600 transition-colors">
                        <Icon Name="chevron-left" Class="w-5 h-5" />
                    </button>
                    <button @onclick="NextDay" disabled="@(selectedDate >= Time.Today)" aria-label="Jour suivant"
                            class="p-2 rounded-full hover:bg-gray-100 disabled:opacity-30 text-gray-400 hover:text-gray-600 transition-colors">
                        <Icon Name="chevron-right" Class="w-5 h-5" />
                    </button>
                </div>
            </div>

            <!-- ── Déplacement d'une journée saisie sur la mauvaise date ──────── -->
            @if (showMoveDay)
            {
                <div class="bg-white rounded-xl shadow-sm p-4 space-y-2.5 print:hidden">
                    <div class="flex items-center justify-between">
                        <h3 class="text-sm font-semibold text-gray-700">Déplacer la journée</h3>
                        <button @onclick="() => showMoveDay = false" aria-label="Fermer le panneau de déplacement"
                                class="text-gray-400 hover:text-gray-600 text-lg leading-none p-1.5 -m-1.5 transition-colors">×</button>
                    </div>
                    <p class="text-[11px] text-gray-400 leading-relaxed">
                        Tout le contenu du <b class="text-gray-600">@selectedDate.ToString("d MMMM", new System.Globalization.CultureInfo("fr-FR"))</b>
                        (repas, activités, photos, notes) sera déplacé vers la date choisie.
                        La date cible doit être un jour sans aucune saisie.
                    </p>
                    <div class="flex items-center gap-2 flex-wrap">
                        <input type="date" @bind="moveTargetDate" max="@Time.Today.ToString("yyyy-MM-dd")"
                               aria-label="Date de destination"
                               class="bg-slate-50 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-primary-300 border-0" />
                        <button @onclick="MoveDay"
                                class="bg-volt hover:bg-volt-dark text-carbon px-3.5 py-1.5 rounded-lg text-[10px] font-extrabold uppercase tracking-wide transition-colors">
                            Déplacer
                        </button>
                    </div>
                    @if (moveError != null) { <p role="alert" class="text-red-500 text-xs">@moveError</p> }
                </div>
            }

            <!-- Bilan du jour — bloc charbon signature VOLT : chiffres volt, jauge 6 segments -->
            <div class="bg-carbon rounded-xl p-4 pb-3.5 shadow-[0_14px_24px_-14px_rgba(8,12,16,.55)]">
                <div class="flex items-center gap-1.5 mb-3">
                    <span class="w-1.5 h-1.5 bg-volt" aria-hidden="true"></span>
                    <span class="text-[9px] font-extrabold tracking-[.18em] uppercase text-[#7e8890]">Bilan du jour</span>
                </div>
                <div class="grid grid-cols-3 gap-2">
                    <div class="min-w-0">
                        <p class="font-display text-2xl font-extrabold text-volt leading-none tabular-nums">@FilledMealsCount<span class="text-[11px] font-extrabold text-snow ml-0.5">/@DiaryService.MealSlots.Length</span></p>
                        <p class="text-[8.5px] uppercase tracking-[.14em] text-[#79838c] font-bold mt-1.5">Repas</p>
                    </div>
                    <div class="min-w-0">
                        <p class="font-display text-2xl font-extrabold text-volt leading-none tabular-nums">@FormatHydration(EstimatedHydrationMl)</p>
                        <p class="text-[8.5px] uppercase tracking-[.14em] text-[#79838c] font-bold mt-1.5">Hydratation</p>
                    </div>
                    <div class="min-w-0">
                        <p class="font-display text-2xl font-extrabold text-volt leading-none tabular-nums">@FormatActivity(TotalActivityMinutes)</p>
                        <p class="text-[8.5px] uppercase tracking-[.14em] text-[#79838c] font-bold mt-1.5">Activité</p>
                    </div>
                </div>
                <!-- Balance énergétique : kcal ingérées (repas) vs dépensées (activités), avec seuils du profil -->
                <div class="grid grid-cols-3 gap-2 mt-3">
                    <div class="min-w-0">
                        <p class="font-display text-lg font-extrabold leading-none tabular-nums @(IntakeExceeded ? "text-[#ff8a75]" : "text-snow")">@FormatDayKcal(DayKcalTotal)@if (diary!.DailyKcalTarget is int intakeTarget && intakeTarget > 0) { <span class="text-[10px] font-bold text-[#79838c]">/@intakeTarget</span> }</p>
                        <p class="text-[8.5px] uppercase tracking-[.14em] text-[#79838c] font-bold mt-1">Kcal ingérées</p>
                    </div>
                    <div class="min-w-0">
                        <p class="font-display text-lg font-extrabold leading-none tabular-nums @(BurnReached ? "text-volt" : "text-snow")">@FormatDayKcal(TotalBurnedKcal)@if (diary!.DailyBurnTarget is int burnTarget && burnTarget > 0) { <span class="text-[10px] font-bold text-[#79838c]">/@burnTarget</span> }</p>
                        <p class="text-[8.5px] uppercase tracking-[.14em] text-[#79838c] font-bold mt-1">Kcal dépensées</p>
                    </div>
                    <div class="min-w-0">
                        <p class="font-display text-lg font-extrabold text-volt leading-none tabular-nums">@FormatKcalBalance()</p>
                        <p class="text-[8.5px] uppercase tracking-[.14em] text-[#79838c] font-bold mt-1">Bilan@(ProfileBmr != null ? " (MB inclus)" : "")</p>
                    </div>
                </div>
                @if (ProfileBmr is double bilanBmr && ProfileNeeds is double bilanNeeds)
                {
                    <!-- Seuils du profil : métabolisme, besoins, état des objectifs -->
                    <p class="text-[8.5px] uppercase tracking-[.12em] text-[#79838c] font-bold mt-2.5 leading-relaxed">
                        MB ≈ @((int)bilanBmr) kcal · Besoins ≈ @((int)bilanNeeds) kcal/j
                        @if (diary!.DailyKcalTarget is int limitK && limitK > 0)
                        {
                            <span class="@(IntakeExceeded ? "text-[#ff8a75]" : "text-volt")"> · Plafond @(IntakeExceeded ? $"dépassé de {(int)(DayKcalTotal - limitK)}" : "respecté")</span>
                        }
                        @if (diary!.DailyBurnTarget is int goalB && goalB > 0)
                        {
                            <span class="@(BurnReached ? "text-volt" : "")"> · Dépense @(BurnReached ? "objectif atteint" : $"reste {goalB - TotalBurnedKcal}")</span>
                        }
                    </p>
                }
                <div class="flex gap-1 mt-3" aria-hidden="true">
                    @for (var seg = 0; seg < DiaryService.MealSlots.Length; seg++)
                    {
                        <span class="flex-1 h-1 rounded-sm @(seg < FilledMealsCount ? "bg-volt" : "bg-carbon-2")"></span>
                    }
                </div>
            </div>

            @if (tableView)
            {
                <div style="width:100vw;margin-left:calc(50% - 50vw);margin-top:1.25rem;padding:0 1rem;box-sizing:border-box;">
                    <DiaryTableView
                        DailyLog="@currentLog"
                        DiaryId="@diary!.Id"
                        Date="@selectedDate"
                        OnChanged="@LoadDay" />
                </div>
            }
            else
            {
                <!-- Journée — sections plates, timeline fine : heures en marge, pastilles sur rail dégradé -->
                <div class="relative pl-[60px]">
                    <div class="absolute left-[50px] top-2 bottom-2 w-[2px] bg-[#cbd3da]" aria-hidden="true"></div>
                    @{
                        var friseRows = GetFriseRows().ToList();
                    }
                    <div>
                        @for (int ri = 0; ri <= friseRows.Count; ri++)
                        {
                            int insertIdx = ri;
                            var prevRow = ri > 0 ? friseRows[ri - 1] : null;
                            var nextRow = ri < friseRows.Count ? friseRows[ri] : null;
                            var bTime = CalcInsertTime(prevRow, nextRow);
                            <!-- ╌ Couture d'insertion : au repos un pointillé pâle + losange creux sur le rail
                                 (le vocabulaire de la timeline : losange vide = un événement peut naître ici).
                                 Au survol — ou après un premier appui au tactile — la couture s'ouvre en bande
                                 hachurée « Activité sportive », même langage que les jalons fantômes de repas.
                                 Sert aussi de cible de dépôt pour le drag d'une activité. ╌ -->
                            <div class="group/insert relative h-7 z-10 print:hidden"
                                 @onclick="() => armedInsert = insertIdx"
                                 @ondragover:preventDefault="true"
                                 @ondragover="() => OnInsertDragOver(insertIdx)"
                                 @ondragleave="() => OnInsertDragLeave(insertIdx)"
                                 @ondrop="async () => await HandleActivityDropAt(bTime, insertIdx)">
                                @{ bool insertActive = armedInsert == insertIdx || actDropTarget == insertIdx; }
                                <div class="absolute inset-x-0 top-1/2 border-t border-dashed border-[#d3dae0] transition-opacity duration-150 pointer-fine:group-hover/insert:opacity-0 @(insertActive ? "opacity-0" : "")" aria-hidden="true"></div>
                                <span class="absolute -left-[13px] top-1/2 -mt-1 w-2 h-2 rotate-45 shadow-[0_0_0_3px_#e9edf1] border-[1.5px] transition-colors duration-150 pointer-fine:group-hover/insert:bg-volt pointer-fine:group-hover/insert:border-volt @(insertActive ? "bg-volt border-volt" : "bg-canvas border-[#aeb8c0]")" aria-hidden="true"></span>
                                <button type="button"
                                        @onclick="async () => await InsertActivity(bTime)"
                                        @onclick:stopPropagation="true"
                                        class="absolute inset-x-0 inset-y-0.5 flex items-center gap-2 px-3 rounded-[7px] text-left cursor-pointer
                                               bg-[repeating-linear-gradient(135deg,#dde3e9_0_7px,#e4e9ee_7px_14px)]
                                               opacity-0 pointer-events-none transition-opacity duration-150
                                               pointer-fine:group-hover/insert:opacity-100 pointer-fine:group-hover/insert:pointer-events-auto
                                               focus-visible:opacity-100 focus-visible:pointer-events-auto
                                               @(insertActive ? "!opacity-100 !pointer-events-auto" : "")">
                                    @* Toute la bande est le bouton : pas de chip interne, juste le libellé *@
                                    <span class="flex-1 min-w-0 truncate font-display text-[11.5px] font-extrabold text-[#69737d]">
                                        @(actDropTarget == insertIdx ? "Déposer ici" : "+ Activité sportive")
                                    </span>
                                </button>
                            </div>

                            @if (ri < friseRows.Count)
                            {
                                var row = friseRows[ri];
                                var rowEvent = row.Event;
                                bool isEmptySlot = rowEvent == null;
                                bool isMeal = rowEvent?.EventType == DayEventType.Meal;
                                int? slotIdx = rowEvent?.MealSlot ?? row.EmptySlot;

                                if (isMeal || isEmptySlot)
                                {
                                    var slotInfo = slotIdx.HasValue ? DiaryService.MealSlots[slotIdx.Value] : DiaryService.MealSlots[0];
                                    @* Pas de z-index ici : un contexte d'empilement piégerait les popovers
                                       (z-30) de l'EventCard sous les lignes suivantes de la frise. *@
                                    @* mb-1 seulement : la couture d'insertion (h-7) fournit déjà l'espacement vertical *@
                                    <div @key="@($"slot-{slotIdx}")" class="relative mb-1"
                                         @ondragover:preventDefault="true"
                                         @ondragover="() => OnMealSlotDragOver(slotIdx ?? -1)"
                                         @ondragleave="() => OnMealSlotDragLeave(slotIdx ?? -1)"
                                         @ondrop="async () => await HandleMealDrop(slotIdx ?? -1)">
                                        @if (isEmptySlot)
                                        {
                                            <span class="absolute -left-[60px] top-[13px] w-[42px] font-display text-[10.5px] font-extrabold tabular-nums text-[#9aa4ad] select-none" aria-hidden="true">@slotInfo.DefaultTime.ToString(@"HH\:mm")</span>
                                        }
                                        else
                                        {
                                            @* Heure éditable directement sur la frise : input time nu (pas de @bind sur type=time) *@
                                            <input type="time"
                                                   value="@((rowEvent!.Time ?? slotInfo.DefaultTime).ToString(@"HH\:mm"))"
                                                   @onchange="async e => await UpdateEventTime(rowEvent!, e)"
                                                   aria-label="@($"Heure — {rowEvent!.Label}")"
                                                   class="absolute -left-[60px] top-[9px] w-[42px] font-display text-[10.5px] font-extrabold tabular-nums text-[#2a3138] bg-transparent p-0 border-0 rounded-[3px] cursor-pointer appearance-none [&::-webkit-calendar-picker-indicator]:hidden focus:outline-none focus:ring-2 focus:ring-volt" />
                                        }
                                        <span class="absolute -left-[13px] top-4 w-2 h-2 rotate-45 shadow-[0_0_0_3px_#e9edf1] @(isEmptySlot ? "bg-[#aeb8c0]" : "bg-volt")" aria-hidden="true"></span>
                                        <div class="min-w-0 @(mealDropTarget == slotIdx ? "ring-2 ring-primary-300 rounded-xl" : "")">
                                            @if (isEmptySlot)
                                            {
                                                <!-- Jalon vide : hachures + AJOUTER. Un clic crée la carte en édition ;
                                                     refermée sans aucune saisie, elle est supprimée (balayage LoadDay)
                                                     et le jalon redevient fantôme. -->
                                                <button type="button"
                                                        @onclick="async () => await OpenSlot(slotIdx!.Value)"
                                                        class="group/ghost w-full text-left flex items-center gap-2 px-3 py-2 rounded-lg bg-[repeating-linear-gradient(135deg,#dde3e9_0_7px,#e4e9ee_7px_14px)]">
                                                    <span class="flex-1 min-w-0 font-display text-[13px] font-extrabold text-[#69737d] pointer-fine:group-hover/ghost:text-[#4a545e] transition-colors duration-150">@slotInfo.Label</span>
                                                    <span class="bg-volt text-carbon rounded-[5px] px-2.5 py-1.5 text-[9px] font-extrabold uppercase tracking-[.1em] shadow-[0_2px_0_rgba(14,17,20,.18)] flex-shrink-0 select-none">+ Ajouter</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <div @key="@($"evt-{rowEvent!.Id}")" style="@DragStyle(rowEvent!.Id)">
                                                    <EventCard Event="rowEvent!"
                                                               ConcurrentActivities="@(slotIdx.HasValue ? GetConcurrentActivities(slotIdx.Value) : EmptyActivities)"
                                                               QuickFoods="@topFoods" QuickCompositions="@topCompositions" FoodSuggestions="@foodSuggestions" Catalog="@catalog"
                                                               IsEditing="@(editingEventId == rowEvent!.Id)" OnToggleEdit="() => ToggleEdit(rowEvent!.Id)"
                                                               OnChanged="LoadDay" OnDelete="DeleteEvent"
                                                               OnCardDragStart="() => StartDrag(rowEvent!)"
                                                               OnCardDragEnd="EndDrag" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div @key="@($"evt-{rowEvent!.Id}")" class="relative mb-1"
                                         style="@DragStyle(rowEvent!.Id)">
                                        <input type="time"
                                               value="@(rowEvent!.Time?.ToString(@"HH\:mm") ?? "")"
                                               @onchange="async e => await UpdateEventTime(rowEvent!, e)"
                                               aria-label="@($"Heure — {rowEvent!.Label}")"
                                               class="absolute -left-[60px] top-[9px] w-[42px] font-display text-[10.5px] font-extrabold tabular-nums text-[#2a3138] bg-transparent p-0 border-0 rounded-[3px] cursor-pointer appearance-none [&::-webkit-calendar-picker-indicator]:hidden focus:outline-none focus:ring-2 focus:ring-volt" />
                                        <span class="absolute -left-[13px] top-4 w-2 h-2 rotate-45 bg-carbon shadow-[0_0_0_3px_#e9edf1]" aria-hidden="true"></span>
                                        <div class="min-w-0">
                                            <EventCard Event="rowEvent!" ConcurrentActivities="@EmptyActivities"
                                                       QuickFoods="@topFoods" QuickCompositions="@topCompositions" FoodSuggestions="@foodSuggestions" Catalog="@catalog"
                                                       IsEditing="@(editingEventId == rowEvent!.Id)" OnToggleEdit="() => ToggleEdit(rowEvent!.Id)"
                                                       OnChanged="LoadDay" OnDelete="DeleteEvent"
                                                       OnCardDragStart="() => StartDrag(rowEvent!)"
                                                       OnCardDragEnd="EndDrag" />
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            }

            <!-- Notes de la journée — section plate -->
            <div class="border-t border-gray-100 pt-4 print:hidden">
                <h3 class="font-display font-bold text-gray-900 mb-3 text-lg">Notes de la journée</h3>

                <div class="space-y-2">
                    <div>
                        <label class="block text-[11px] font-medium text-gray-400 mb-1">🧘 Émotions / Stress (journée)</label>
                        <textarea @bind="emotions" @onblur="SaveDaySummary" rows="2" placeholder="Comment vous sentez-vous globalement aujourd'hui ?"
                                  class="w-full bg-slate-50 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-300 resize-none border-0 placeholder-gray-400"></textarea>
                    </div>
                    <div>
                        <label class="block text-[11px] font-medium text-gray-400 mb-1">📝 Notes générales</label>
                        <textarea @bind="generalNotes" @onblur="SaveDaySummary" rows="2" placeholder="Observations, remarques…"
                                  class="w-full bg-slate-50 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-primary-300 resize-none border-0 placeholder-gray-400"></textarea>
                    </div>
                </div>
            </div>
            </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public string AccessCode { get; set; } = "";

    [SupplyParameterFromQuery(Name = "nouveau")]
    [Parameter] public bool IsNew { get; set; }

    FoodDiary? diary;
    DailyLog? currentLog;
    DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    bool isLoading = true;
    bool showPinForm;
    bool pinError;
    string pinInput = "";
    bool showHistory;
    bool tableView;
    string emotions = "", generalNotes = "";

    // ── Bannière nouveau carnet ──────────────────────────────────────────
    bool showNewBanner;
    bool showSharePanel;
    bool copiedUrl;
    string nutriSearch = "";
    List<NutriPlan.Data.Models.Nutritionist> nutriResults = [];
    bool nutriSearchDone;
    int? nutriAssignedId;
    NutriPlan.Data.Models.Nutritionist? assignedNutri;
    bool confirmRevoke;

    // ── Gestion du PIN (panneau de partage) ──────────────────────────────
    string pinCurrent = "", pinNew = "";
    string? pinFormError;

    // ── Autocomplétion des aliments ──────────────────────────────────────
    List<string> foodSuggestions = [];

    // ── Référentiel Ciqual (ANSES) : ~3 500 aliments génériques, cache process-wide ──
    IReadOnlyList<CatalogFood> catalog = [];

    // ── Raccourcis : aliments favoris (les plus saisis, avec leur dernière quantité) ──
    List<DiaryService.FrequentFood> topFoods = [];

    // ── Raccourcis : compositions favorites (avec toutes leurs composantes) ──
    List<DiaryService.FrequentComposition> topCompositions = [];

    const string SaveError = "Enregistrement impossible — vérifiez votre connexion.";

    // ── Profil & objectifs (métabolisme Mifflin-St Jeor, plafonds) ──────────
    bool showProfilePanel;
    string? profileSex;
    int? profileHeight;
    double? profileWeight;
    int? profileBirthYear;
    string? profileActivity;
    int? profileKcalTarget;
    int? profileBurnTarget;

    void LoadProfileFields()
    {
        if (diary == null) return;
        profileSex = diary.Sex;
        profileHeight = diary.HeightCm;
        profileWeight = diary.WeightKg;
        profileBirthYear = diary.BirthYear;
        profileActivity = diary.ActivityLevel;
        profileKcalTarget = diary.DailyKcalTarget;
        profileBurnTarget = diary.DailyBurnTarget;
    }

    async Task SaveProfile()
    {
        if (diary == null) return;
        try
        {
            await DiaryService.UpdateProfileAsync(diary.Id, profileSex, profileHeight, profileWeight,
                profileBirthYear, profileActivity, profileKcalTarget, profileBurnTarget);
            diary.Sex = profileSex; diary.HeightCm = profileHeight; diary.WeightKg = profileWeight;
            diary.BirthYear = profileBirthYear; diary.ActivityLevel = profileActivity;
            diary.DailyKcalTarget = profileKcalTarget; diary.DailyBurnTarget = profileBurnTarget;
            Toast.ShowSaved();
        }
        catch { Toast.ShowError(SaveError); }
    }

    // ── Strava ──────────────────────────────────────────────────────────────
    bool stravaSyncing;
    bool showStravaGate;
    string? pendingStravaTicket;

    string StravaAuthorizeUrl => Strava.GetAuthorizeUrl($"{Nav.BaseUri}strava/callback", AccessCode);
    // Scope minimal « read » : toujours couvert par l'autorisation existante, donc
    // Strava redirige sans rouvrir l'écran de consentement (approval_prompt=auto).
    string StravaLoginUrl => Strava.GetAuthorizeUrl($"{Nav.BaseUri}strava/callback", "login", "read");

    async Task SyncStrava()
    {
        if (stravaSyncing || diary == null) return;
        stravaSyncing = true;
        try
        {
            var (imported, error) = await Strava.SyncAsync(diary.Id);
            if (error != null) { Toast.ShowError(error); return; }
            diary.StravaLastSyncAt = DateTime.UtcNow;
            Toast.ShowSuccess(imported == 0 ? "Aucune nouvelle activité Strava" : $"{imported} activité(s) Strava importée(s) ✓");
            if (imported > 0) await LoadDay();
        }
        finally { stravaSyncing = false; }
    }

    // Synchro silencieuse à l'ouverture du carnet (au plus toutes les 12 h).
    async Task AutoSyncStravaAsync()
    {
        if (diary == null || string.IsNullOrEmpty(diary.StravaRefreshToken)) return;
        if (diary.StravaLastSyncAt is DateTime last && DateTime.UtcNow - last < TimeSpan.FromHours(12)) return;
        try
        {
            var (imported, _) = await Strava.SyncAsync(diary.Id);
            diary.StravaLastSyncAt = DateTime.UtcNow;
            if (imported > 0)
            {
                Toast.ShowSuccess($"{imported} activité(s) Strava importée(s) ✓");
                await LoadDay();
            }
        }
        catch { /* la synchro auto ne doit jamais gêner l'ouverture du carnet */ }
    }

    bool confirmStravaDelete;

    // Suppression en deux temps de toutes les activités importées de Strava.
    // La synchro est remise à zéro : « Synchroniser » ré-importe les 30 derniers jours.
    async Task DeleteStravaActivities()
    {
        if (diary == null) return;
        if (!confirmStravaDelete) { confirmStravaDelete = true; return; }
        confirmStravaDelete = false;
        try
        {
            var removed = await Strava.DeleteImportedActivitiesAsync(diary.Id);
            diary.StravaLastSyncAt = null;
            Toast.ShowSuccess($"{removed} activité(s) Strava supprimée(s)");
            await LoadDay();
        }
        catch { Toast.ShowError(SaveError); }
    }

    async Task DisconnectStrava()
    {
        if (diary == null) return;
        await Strava.DisconnectAsync(diary.Id);
        diary.StravaAthleteId = null; diary.StravaAccessToken = null;
        diary.StravaRefreshToken = null; diary.StravaTokenExpiresAt = null; diary.StravaLastSyncAt = null;
        // L'empreinte d'accès redevient PIN seul : re-déverrouiller la session en place.
        await Session.UnlockAsync(diary.AccessCode, DiarySessionService.AccessStamp(diary.PinHash, null));
        Toast.ShowSaved("Strava déconnecté");
    }

    double? ProfileBmr => diary == null ? null : DiaryService.BasalMetabolicRate(diary, selectedDate.Year);
    double? ProfileNeeds => diary == null ? null : DiaryService.DailyEnergyNeeds(diary, selectedDate.Year);
    bool IntakeExceeded => diary?.DailyKcalTarget is int intakeT && intakeT > 0 && DayKcalTotal > intakeT;
    bool BurnReached => diary?.DailyBurnTarget is int burnT && burnT > 0 && TotalBurnedKcal >= burnT;

    // ── Lecture / édition : un seul événement en édition à la fois ──────────
    int? editingEventId;

    async Task ToggleEdit(int eventId)
    {
        var closing = editingEventId;
        editingEventId = editingEventId == eventId ? null : eventId;
        // À la fermeture, le balayage de LoadDay rend le jalon fantôme s'il est resté vierge.
        if (closing.HasValue && closing != editingEventId)
            await LoadDay();
    }

    void ToggleSharePanel()
    {
        showSharePanel = !showSharePanel;
        confirmRevoke = false;
        pinFormError = null;
    }

    void CloseSharePanel()
    {
        showSharePanel = false;
        confirmRevoke = false;
        pinFormError = null;
    }

    string DiaryShareUrl => Nav.BaseUri.TrimEnd('/') + $"/carnet/{AccessCode}";
    string WhatsAppShareUrl => $"https://wa.me/?text={Uri.EscapeDataString($"Mon carnet NutriPlan\nCode : {AccessCode}\n{DiaryShareUrl}")}";
    string EmailShareUrl => $"mailto:?subject={Uri.EscapeDataString("Mon carnet NutriPlan")}&body={Uri.EscapeDataString($"Voici mon code d'accès NutriPlan : {AccessCode}\nLien direct : {DiaryShareUrl}")}";

    async Task CopyUrl()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", DiaryShareUrl);
            copiedUrl = true;
        }
        catch
        {
            // non-HTTPS ou refus navigateur — l'input reste sélectionnable
            Toast.ShowError("Copie impossible — sélectionnez le lien manuellement.");
            return;
        }
        StateHasChanged();
        await Task.Delay(2000);
        copiedUrl = false;
        StateHasChanged();
    }

