@page "/nutritionniste/nouveau-patient"
@inject DiaryService DiaryService
@inject DiarySessionService Session
@inject NavigationManager Nav

<PageTitle>Nouveau patient — NutriPlan</PageTitle>

@if (!Session.IsNutritionistLoggedIn)
{
    <div class="text-center text-gray-400 py-12">Redirection…</div>
}
else
{
    <div class="max-w-md mx-auto py-8">
        <div class="mb-6">
            <a href="/nutritionniste/tableau-de-bord" class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-gray-500 hover:text-carbon transition-colors">
                <Icon Name="arrow-left" Class="w-3.5 h-3.5" /> Retour au tableau de bord
            </a>
        </div>

        @if (createdDiary == null)
        {
            <div class="bg-white rounded-xl shadow-[0_1px_0_rgba(20,26,31,.06),0_10px_18px_-12px_rgba(20,26,31,.35)] p-6">
                <div class="text-center mb-6">
                    <div class="w-12 h-12 rounded-xl bg-carbon flex items-center justify-center mx-auto mb-3 shadow-[0_12px_20px_-12px_rgba(8,12,16,.6)]" aria-hidden="true">
                        <Icon Name="user" Class="w-6 h-6 text-volt" />
                    </div>
                    <p class="text-[10px] font-extrabold uppercase tracking-[.14em] text-gray-400">Espace pro</p>
                    <h1 class="font-display text-2xl font-extrabold text-carbon mt-1">Nouveau carnet patient</h1>
                    <p class="text-gray-400 text-sm mt-1">Le patient sera identifié par un alias anonyme.</p>
                </div>

                <div class="space-y-4">
                    <div>
                        <label for="patient-alias" class="block text-[10px] font-extrabold uppercase tracking-[.12em] text-gray-400 mb-1.5">
                            Alias patient *
                        </label>
                        <input id="patient-alias" @bind="patientAlias" type="text" placeholder="ex: Patient A, JD2024, Initiales…"
                               class="w-full bg-slate-50 border-0 rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 placeholder-gray-400"
                               maxlength="100" />
                        <p class="text-gray-400 text-xs mt-1">Seul vous verrez cet alias.</p>
                    </div>

                    <div>
                        <label for="patient-notes" class="block text-[10px] font-extrabold uppercase tracking-[.12em] text-gray-400 mb-1.5">
                            Notes (optionnel)
                        </label>
                        <textarea id="patient-notes" @bind="notes" rows="3" placeholder="Objectifs, contexte médical, instructions spéciales…"
                                  class="w-full bg-slate-50 border-0 rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 placeholder-gray-400 resize-none"
                                  maxlength="500"></textarea>
                    </div>

                    <div>
                        <label for="patient-pin" class="block text-[10px] font-extrabold uppercase tracking-[.12em] text-gray-400 mb-1.5">
                            Code PIN patient (optionnel)
                        </label>
                        <input id="patient-pin" @bind="pin" type="text" inputmode="numeric" placeholder="4 à 8 chiffres"
                               class="w-full bg-slate-50 border-0 rounded-lg px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300 placeholder-gray-400"
                               maxlength="8" />
                        <p class="text-gray-400 text-xs mt-1">
                            Partagez ce code avec votre patient pour qu'il accède à son carnet.
                        </p>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div role="alert" class="bg-red-50 text-red-600 text-sm rounded-lg px-4 py-3">@errorMessage</div>
                    }

                    <button @onclick="Create" disabled="@isLoading"
                            class="w-full bg-volt hover:bg-volt-dark disabled:opacity-60 text-carbon py-3 rounded-lg font-display font-extrabold text-sm shadow-[0_2px_0_rgba(14,17,20,.18)] transition-colors">
                        @(isLoading ? "Création en cours…" : "Créer le carnet")
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="bg-white rounded-xl shadow-[0_1px_0_rgba(20,26,31,.06),0_10px_18px_-12px_rgba(20,26,31,.35)] p-6">
                <div class="text-center mb-6">
                    <div class="w-12 h-12 rounded-xl bg-carbon flex items-center justify-center mx-auto mb-3" aria-hidden="true">
                        <Icon Name="check" Class="w-6 h-6 text-volt" StrokeWidth="2.5" />
                    </div>
                    <h2 class="font-display text-xl font-extrabold text-carbon">Carnet créé !</h2>
                    <p class="text-gray-400 text-sm mt-1">Partagez le lien et le code avec votre patient.</p>
                </div>

                <div class="space-y-3 mb-6">
                    <div class="bg-[#f7f9fb] border border-[#e2e8ee] rounded-lg p-3">
                        <p class="text-[9px] font-extrabold uppercase tracking-[.14em] text-gray-400 mb-1">Patient</p>
                        <p class="font-display font-bold text-carbon">@createdDiary.PatientAlias</p>
                    </div>

                    <div class="bg-carbon rounded-lg p-3.5">
                        <p class="text-[9px] font-extrabold uppercase tracking-[.14em] text-[#79838c] mb-1">Code d'accès</p>
                        <p class="font-display text-2xl font-extrabold text-volt tracking-[.22em]">@createdDiary.AccessCode</p>
                    </div>

                    <div class="bg-[#f7f9fb] border border-[#e2e8ee] rounded-lg p-3">
                        <p class="text-[9px] font-extrabold uppercase tracking-[.14em] text-gray-400 mb-1">Lien de partage</p>
                        <p class="text-sm text-gray-600 font-mono break-all">@shareUrl</p>
                    </div>

                    @if (!string.IsNullOrEmpty(pin))
                    {
                        <div class="bg-[#f7f9fb] border border-[#e2e8ee] rounded-lg p-3">
                            <p class="text-[9px] font-extrabold uppercase tracking-[.14em] text-gray-400 mb-1 flex items-center gap-1">
                                <Icon Name="lock" Class="w-2.5 h-2.5" /> Code PIN du patient
                            </p>
                            <p class="font-display text-xl font-extrabold text-carbon tracking-[.22em]">@pin</p>
                        </div>
                    }
                </div>

                <div class="flex gap-3">
                    <a href="/nutritionniste/patient/@createdDiary.AccessCode"
                       class="flex-1 text-center bg-volt hover:bg-volt-dark text-carbon py-2.5 rounded-lg text-[11px] font-extrabold uppercase tracking-[.08em] shadow-[0_2px_0_rgba(14,17,20,.18)] transition-colors">
                        Voir le carnet
                    </a>
                    <a href="/nutritionniste/tableau-de-bord"
                       class="flex-1 text-center border border-slate-200 bg-white hover:bg-slate-50 text-gray-600 py-2.5 rounded-lg text-[11px] font-extrabold uppercase tracking-[.08em] transition-colors">
                        Tableau de bord
                    </a>
                </div>
            </div>
        }
    </div>
}

@code {
    string patientAlias = "", notes = "", pin = "";
    string errorMessage = "";
    bool isLoading;
    FoodDiary? createdDiary;
    string shareUrl = "";

    protected override async Task OnInitializedAsync()
    {
        // Recharge la session persistée avant toute lecture de l'état de connexion.
        await Session.EnsureLoadedAsync();
        if (!Session.IsNutritionistLoggedIn)
            Nav.NavigateTo("/nutritionniste/connexion");
    }

    async Task Create()
    {
        errorMessage = "";
        if (string.IsNullOrWhiteSpace(patientAlias))
        {
            errorMessage = "L'alias patient est obligatoire.";
            return;
        }
        if (!string.IsNullOrEmpty(pin) && pin.Length < 4)
        {
            errorMessage = "Le PIN doit comporter au moins 4 chiffres.";
            return;
        }
        isLoading = true;
        createdDiary = await DiaryService.CreateNutritionistDiaryAsync(
            Session.NutritionistId!.Value,
            patientAlias,
            string.IsNullOrEmpty(pin) ? null : pin,
            string.IsNullOrEmpty(notes) ? null : notes);
        shareUrl = Nav.BaseUri.TrimEnd('/') + $"/carnet/{createdDiary.AccessCode}";
        isLoading = false;
    }
}
