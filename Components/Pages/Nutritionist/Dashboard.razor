@page "/nutritionniste/tableau-de-bord"
@inject DiaryService DiaryService
@inject DiarySessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toast

<PageTitle>Tableau de bord — NutriPlan</PageTitle>

@if (!Session.IsNutritionistLoggedIn)
{
    <div class="text-center text-gray-400 py-12">Redirection…</div>
}
else
{
    <div class="space-y-6">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="font-display text-2xl font-extrabold text-carbon">Tableau de bord</h1>
                <p class="text-gray-400 text-sm">Bonjour, @Session.NutritionistName</p>
            </div>
            <a href="/nutritionniste/nouveau-patient"
               class="bg-volt hover:bg-volt-dark text-carbon px-4 py-2.5 rounded-xl text-sm font-medium transition-colors flex items-center gap-2">
                <span aria-hidden="true">+</span> Nouveau patient
            </a>
        </div>

        @if (isLoading)
        {
            <div class="text-gray-400 text-center py-12">Chargement…</div>
        }
        else if (diaries.Count == 0)
        {
            <div class="bg-white rounded-lg shadow-[0_1px_0_rgba(20,26,31,.06),0_10px_18px_-12px_rgba(20,26,31,.35)] p-8 text-center">
                <div class="text-5xl mb-4" aria-hidden="true">👤</div>
                <h2 class="font-display text-lg font-extrabold text-carbon mb-2">Aucun patient pour l'instant</h2>
                <p class="text-gray-400 text-sm mb-4">Créez un carnet alimentaire pour votre premier patient.</p>
                <a href="/nutritionniste/nouveau-patient"
                   class="inline-block bg-volt hover:bg-volt-dark text-carbon px-5 py-2.5 rounded-xl text-sm font-medium transition-colors">
                    Créer un carnet patient
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                @foreach (var diary in diaries)
                {
                    <div class="bg-white rounded-lg shadow-[0_1px_0_rgba(20,26,31,.06),0_10px_18px_-12px_rgba(20,26,31,.35)] overflow-hidden transition-colors">
                        <div class="p-4">
                            <div class="flex items-start justify-between mb-3">
                                <div>
                                    <p class="font-display font-bold text-carbon">@(diary.PatientAlias ?? "Patient anonyme")</p>
                                    <p class="text-xs font-mono text-gray-400 mt-0.5">@diary.AccessCode</p>
                                </div>
                                <div class="flex items-center gap-1">
                                    @if (diary.PinHash != null)
                                    {
                                        <span class="text-xs bg-amber-100 text-amber-600 px-2 py-0.5 rounded-full">🔒 PIN</span>
                                    }
                                </div>
                            </div>

                            <div class="text-xs text-gray-400 mb-3">
                                <span>@diary.DailyLogs.Count jour(s) de suivi</span>
                                <span class="mx-1" aria-hidden="true">·</span>
                                <span>Créé le @diary.CreatedAt.ToString("d MMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</span>
                            </div>

                            @if (!string.IsNullOrEmpty(diary.Notes))
                            {
                                <p class="text-xs text-gray-400 italic mb-3 truncate">@diary.Notes</p>
                            }

                            <div class="flex gap-2">
                                <a href="/nutritionniste/patient/@diary.AccessCode"
                                   class="flex-1 text-center bg-primary-50 hover:bg-primary-100 text-primary-700 px-3 py-2 rounded-lg text-xs font-medium transition-colors">
                                    Voir le carnet
                                </a>
                                <button @onclick="() => CopyLink(diary.AccessCode)"
                                        aria-label="Copier le lien du carnet de @(diary.PatientAlias ?? "ce patient")"
                                        class="flex-1 text-center bg-gray-50 hover:bg-gray-100 text-gray-600 px-3 py-2 rounded-lg text-xs font-medium transition-colors">
                                    @(copiedCode == diary.AccessCode ? "✓ Copié !" : "Copier le lien")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    List<FoodDiary> diaries = [];
    bool isLoading = true;
    string copiedCode = "";

    protected override async Task OnInitializedAsync()
    {
        // Recharge la session persistée avant toute lecture de l'état de connexion.
        await Session.EnsureLoadedAsync();
        if (!Session.IsNutritionistLoggedIn)
        {
            Nav.NavigateTo("/nutritionniste/connexion");
            return;
        }
        await LoadDiaries();
    }

    async Task LoadDiaries()
    {
        isLoading = true;
        diaries = await DiaryService.GetNutritionistDiariesAsync(Session.NutritionistId!.Value);
        isLoading = false;
    }

    async Task CopyLink(string code)
    {
        var url = Nav.BaseUri.TrimEnd('/') + $"/carnet/{code}";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
        }
        catch
        {
            // API presse-papiers indisponible (contexte non-HTTPS ou refus navigateur) :
            // ne pas afficher « Copié ! » alors que rien n'a été copié.
            Toast.ShowError("Copie impossible — copiez le lien manuellement.");
            return;
        }
        copiedCode = code;
        StateHasChanged();
        await Task.Delay(2000);
        copiedCode = "";
        StateHasChanged();
    }
}
