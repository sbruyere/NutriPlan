@page "/nutritionniste/tableau-de-bord"
@inject DiaryService DiaryService
@inject DiarySessionService Session
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toast

<PageTitle>Tableau de bord — NutriPlan</PageTitle>

@if (!Session.IsNutritionistLoggedIn)
{
    <div class="text-center text-gray-400 py-12">Redirection…</div>
}
else
{
    <div class="space-y-5">
        <div class="flex items-end justify-between gap-3">
            <div class="min-w-0">
                <p class="text-[10px] font-extrabold uppercase tracking-[.14em] text-gray-400">Espace pro</p>
                <h1 class="font-display text-2xl font-extrabold text-carbon tracking-tight mt-0.5">Tableau de bord</h1>
                <p class="text-gray-400 text-sm mt-0.5">Bonjour, @Session.NutritionistName</p>
            </div>
            <a href="/nutritionniste/nouveau-patient"
               class="flex-shrink-0 bg-volt hover:bg-volt-dark text-carbon px-4 py-2.5 rounded-lg text-[11px] font-extrabold uppercase tracking-[.08em] shadow-[0_2px_0_rgba(14,17,20,.18)] transition-colors whitespace-nowrap">
                + Nouveau patient
            </a>
        </div>

        @if (isLoading)
        {
            <div class="text-gray-400 text-center py-12">Chargement…</div>
        }
        else if (diaries.Count == 0)
        {
            <div class="bg-white rounded-xl shadow-[0_1px_0_rgba(20,26,31,.06),0_10px_18px_-12px_rgba(20,26,31,.35)] p-8 text-center">
                <div class="w-12 h-12 rounded-xl bg-carbon flex items-center justify-center mx-auto mb-4" aria-hidden="true">
                    <Icon Name="user" Class="w-6 h-6 text-volt" />
                </div>
                <h2 class="font-display text-lg font-extrabold text-carbon mb-2">Aucun patient pour l'instant</h2>
                <p class="text-gray-400 text-sm mb-4">Créez un carnet alimentaire pour votre premier patient.</p>
                <a href="/nutritionniste/nouveau-patient"
                   class="inline-block bg-volt hover:bg-volt-dark text-carbon px-5 py-2.5 rounded-lg text-[11px] font-extrabold uppercase tracking-[.08em] shadow-[0_2px_0_rgba(14,17,20,.18)] transition-colors">
                    Créer un carnet patient
                </a>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                @foreach (var diary in diaries)
                {
                    <div class="bg-white rounded-xl shadow-[0_1px_0_rgba(20,26,31,.06),0_10px_18px_-12px_rgba(20,26,31,.35)] overflow-hidden">
                        <div class="p-4">
                            <div class="flex items-start justify-between mb-3">
                                <div class="min-w-0">
                                    <p class="font-display font-extrabold text-carbon truncate">@(diary.PatientAlias ?? "Patient anonyme")</p>
                                    <p class="text-[11px] font-mono tracking-wider text-gray-400 mt-0.5">@diary.AccessCode</p>
                                </div>
                                @if (diary.PinHash != null)
                                {
                                    <span class="flex-shrink-0 inline-flex items-center gap-1 bg-carbon text-volt px-2 py-1 rounded-[5px] text-[9px] font-extrabold uppercase tracking-[.1em]">
                                        <Icon Name="lock" Class="w-2.5 h-2.5" /> PIN
                                    </span>
                                }
                            </div>

                            <div class="text-xs text-gray-400 mb-3">
                                <span class="font-bold text-gray-500">@diary.DailyLogs.Count</span>
                                <span> jour(s) de suivi</span>
                                <span class="mx-1" aria-hidden="true">·</span>
                                <span>Créé le @diary.CreatedAt.ToString("d MMM yyyy", new System.Globalization.CultureInfo("fr-FR"))</span>
                            </div>

                            @if (!string.IsNullOrEmpty(diary.Notes))
                            {
                                <p class="text-xs text-gray-400 italic mb-3 truncate">@diary.Notes</p>
                            }

                            <div class="flex gap-2">
                                <a href="/nutritionniste/patient/@diary.AccessCode"
                                   class="flex-1 text-center bg-volt hover:bg-volt-dark text-carbon px-3 py-2 rounded-lg text-[10px] font-extrabold uppercase tracking-[.08em] shadow-[0_2px_0_rgba(14,17,20,.18)] transition-colors">
                                    Voir le carnet
                                </a>
                                <button @onclick="() => CopyLink(diary.AccessCode)"
                                        aria-label="Copier le lien du carnet de @(diary.PatientAlias ?? "ce patient")"
                                        class="flex-1 text-center border border-slate-200 bg-white hover:bg-slate-50 text-gray-600 px-3 py-2 rounded-lg text-[10px] font-extrabold uppercase tracking-[.08em] transition-colors">
                                    @(copiedCode == diary.AccessCode ? "✓ Copié !" : "Copier le lien")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    List<FoodDiary> diaries = [];
    bool isLoading = true;
    string copiedCode = "";

    protected override async Task OnInitializedAsync()
    {
        // Recharge la session persistée avant toute lecture de l'état de connexion.
        await Session.EnsureLoadedAsync();
        if (!Session.IsNutritionistLoggedIn)
        {
            Nav.NavigateTo("/nutritionniste/connexion");
            return;
        }
        await LoadDiaries();
    }

    async Task LoadDiaries()
    {
        isLoading = true;
        diaries = await DiaryService.GetNutritionistDiariesAsync(Session.NutritionistId!.Value);
        isLoading = false;
    }

    async Task CopyLink(string code)
    {
        var url = Nav.BaseUri.TrimEnd('/') + $"/carnet/{code}";
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", url);
        }
        catch
        {
            // API presse-papiers indisponible (contexte non-HTTPS ou refus navigateur) :
            // ne pas afficher « Copié ! » alors que rien n'a été copié.
            Toast.ShowError("Copie impossible — copiez le lien manuellement.");
            return;
        }
        copiedCode = code;
        StateHasChanged();
        await Task.Delay(2000);
        copiedCode = "";
        StateHasChanged();
    }
}
