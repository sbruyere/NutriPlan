@page "/nutritionniste/connexion"
@inject NutritionistService NutritionistService
@inject DiarySessionService Session
@inject NavigationManager Nav

<PageTitle>Connexion nutritionniste — NutriPlan</PageTitle>

<div class="max-w-md mx-auto py-8">
    <div class="mb-6">
        <a href="/" class="text-primary-600 hover:underline text-sm flex items-center gap-1">
            ← Retour à l'accueil
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <div class="text-center mb-6">
            <div class="text-4xl mb-2">👨‍⚕️</div>
            <h1 class="text-2xl font-bold text-gray-800">Espace nutritionniste</h1>
        </div>

        @if (!showRegister)
        {
            <!-- Formulaire connexion -->
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Email</label>
                    <input @bind="email" type="email" placeholder="votre@email.com"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Mot de passe</label>
                    <input @bind="password" @onkeyup="OnLoginKeyUp" type="password" placeholder="••••••••"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" />
                </div>

                @if (!string.IsNullOrEmpty(loginError))
                {
                    <div class="bg-red-50 text-red-600 text-sm rounded-xl px-4 py-3">@loginError</div>
                }

                <button @onclick="DoLogin" disabled="@isLoading"
                        class="w-full bg-primary-600 hover:bg-primary-700 disabled:opacity-60 text-white py-3 rounded-xl font-medium transition-colors">
                    @(isLoading ? "Connexion…" : "Se connecter")
                </button>

                <p class="text-center text-sm text-gray-400">
                    Pas encore de compte ?
                    <button @onclick="() => showRegister = true" class="text-primary-600 hover:underline font-medium">
                        S'inscrire
                    </button>
                </p>
            </div>
        }
        else
        {
            <!-- Formulaire inscription -->
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Nom complet</label>
                    <input @bind="regName" type="text" placeholder="Dr. Marie Dupont"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Email professionnel</label>
                    <input @bind="regEmail" type="email" placeholder="votre@email.com"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Mot de passe</label>
                    <input @bind="regPassword" type="password" placeholder="Minimum 8 caractères"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1.5">Confirmer le mot de passe</label>
                    <input @bind="regPasswordConfirm" type="password" placeholder="••••••••"
                           class="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary-300" />
                </div>

                @if (!string.IsNullOrEmpty(regError))
                {
                    <div class="bg-red-50 text-red-600 text-sm rounded-xl px-4 py-3">@regError</div>
                }
                @if (!string.IsNullOrEmpty(regSuccess))
                {
                    <div class="bg-green-50 text-green-700 text-sm rounded-xl px-4 py-3">@regSuccess</div>
                }

                <button @onclick="Register" disabled="@isLoading"
                        class="w-full bg-primary-600 hover:bg-primary-700 disabled:opacity-60 text-white py-3 rounded-xl font-medium transition-colors">
                    @(isLoading ? "Inscription…" : "Créer mon compte")
                </button>

                <p class="text-center text-sm text-gray-400">
                    Déjà un compte ?
                    <button @onclick="() => showRegister = false" class="text-primary-600 hover:underline font-medium">
                        Se connecter
                    </button>
                </p>
            </div>
        }
    </div>
</div>

@code {
    string email = "", password = "";
    string regName = "", regEmail = "", regPassword = "", regPasswordConfirm = "";
    string loginError = "", regError = "", regSuccess = "";
    bool isLoading, showRegister;

    protected override void OnInitialized()
    {
        if (Session.IsNutritionistLoggedIn)
            Nav.NavigateTo("/nutritionniste/tableau-de-bord");
    }

    async Task DoLogin()
    {
        loginError = "";
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            loginError = "Veuillez remplir tous les champs.";
            return;
        }
        isLoading = true;
        var nutritionist = await NutritionistService.AuthenticateAsync(email, password);
        isLoading = false;
        if (nutritionist == null)
        {
            loginError = "Email ou mot de passe incorrect.";
            return;
        }
        Session.LoginNutritionist(nutritionist.Id, nutritionist.Name);
        Session.NotifyStateChanged();
        Nav.NavigateTo("/nutritionniste/tableau-de-bord");
    }

    async Task Register()
    {
        regError = "";
        regSuccess = "";
        if (string.IsNullOrWhiteSpace(regName) || string.IsNullOrWhiteSpace(regEmail) || string.IsNullOrWhiteSpace(regPassword))
        {
            regError = "Veuillez remplir tous les champs.";
            return;
        }
        if (regPassword.Length < 8)
        {
            regError = "Le mot de passe doit comporter au moins 8 caractères.";
            return;
        }
        if (regPassword != regPasswordConfirm)
        {
            regError = "Les mots de passe ne correspondent pas.";
            return;
        }
        isLoading = true;
        var (success, error) = await NutritionistService.RegisterAsync(regName, regEmail, regPassword);
        isLoading = false;
        if (!success)
        {
            regError = error!;
            return;
        }
        regSuccess = "Compte créé avec succès ! Vous pouvez maintenant vous connecter.";
        showRegister = false;
        email = regEmail;
    }

    void OnLoginKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = DoLogin();
    }
}
