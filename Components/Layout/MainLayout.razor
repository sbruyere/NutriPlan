@inherits LayoutComponentBase
@inject DiarySessionService Session
@inject NavigationManager Nav
@implements IDisposable

<div class="min-h-screen flex flex-col">
    <header class="bg-white/90 backdrop-blur-md border-b border-gray-100 sticky top-0 z-40 print:hidden">
        <div class="max-w-2xl mx-auto px-4 py-2.5 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2 group">
                <div class="w-7 h-7 rounded-lg bg-carbon flex items-center justify-center shadow-sm group-hover:bg-carbon-2 transition-colors flex-shrink-0">
                    <Icon Name="leaf" Class="w-3.5 h-3.5 text-volt" StrokeWidth="2.5" />
                </div>
                <span class="font-display text-base font-extrabold text-carbon tracking-tight">NutriPlan</span>
            </a>
            <nav class="flex items-center gap-2" aria-label="Navigation principale">
                @if (Session.IsNutritionistLoggedIn)
                {
                    <span class="hidden sm:inline text-gray-400 text-xs font-medium">@Session.NutritionistName</span>
                    <a href="/nutritionniste/tableau-de-bord"
                       class="bg-primary-50 hover:bg-primary-100 text-primary-700 px-2.5 py-1 rounded-lg transition-colors text-xs font-medium">
                        Tableau de bord
                    </a>
                    <button @onclick="Logout"
                            class="border border-slate-200 bg-white hover:bg-slate-50 text-gray-600 px-2.5 py-1 rounded-lg transition-colors text-xs font-medium">
                        Déconnexion
                    </button>
                }
                else
                {
                    <a href="/nutritionniste/connexion"
                       class="border border-slate-200 bg-white hover:bg-primary-50 text-gray-500 hover:text-primary-700 px-2.5 py-1 rounded-lg transition-colors text-xs font-medium">
                        Espace pro
                    </a>
                }
            </nav>
        </div>
    </header>

    <main class="flex-1 max-w-2xl mx-auto w-full px-4 py-4">
        @Body
    </main>

    <footer class="text-center text-[11px] text-gray-400 py-4 mt-auto print:hidden">
        NutriPlan &mdash; Cahier de suivi alimentaire<br />
        <span class="text-[10px]">Données nutritionnelles : <a href="https://ciqual.anses.fr" target="_blank" rel="noopener" class="underline hover:text-gray-600">ANSES, Table Ciqual 2025</a> &middot; <a href="https://fdc.nal.usda.gov" target="_blank" rel="noopener" class="underline hover:text-gray-600">USDA FoodData Central</a> &middot; <a href="/donnees" class="underline hover:text-gray-600">Sources des données</a></span>
    </footer>

    <Toasts />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += StateHasChanged;
        // Restaure la session (nutritionniste, carnets déverrouillés) après un rafraîchissement
        await Session.EnsureLoadedAsync();
    }

    async Task Logout()
    {
        await Session.LogoutNutritionistAsync();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }
}
