@inherits LayoutComponentBase
@inject DiarySessionService Session
@inject NavigationManager Nav
@implements IDisposable

<div class="min-h-screen flex flex-col">
    <header class="bg-primary-600 text-white shadow-sm sticky top-0 z-40" style="backdrop-filter:blur(8px)">
        <div class="max-w-4xl mx-auto px-4 py-2 flex items-center justify-between">
            <a href="/" class="flex items-center gap-1.5 font-bold tracking-tight hover:text-primary-100 transition-colors">
                <span class="text-lg">🥦</span>
                <span class="text-base">NutriPlan</span>
            </a>
            <nav class="flex items-center gap-2 text-sm">
                @if (Session.IsNutritionistLoggedIn)
                {
                    <span class="hidden sm:inline text-primary-200 text-xs">@Session.NutritionistName</span>
                    <a href="/nutritionniste/tableau-de-bord"
                       class="bg-primary-700 hover:bg-primary-800 px-2.5 py-1 rounded-lg transition-colors text-xs">
                        Tableau de bord
                    </a>
                    <button @onclick="Logout"
                            class="bg-white/10 hover:bg-white/20 px-2.5 py-1 rounded-lg transition-colors text-xs font-medium border border-white/20">
                        Déconnexion
                    </button>
                }
                else
                {
                    <a href="/nutritionniste/connexion"
                       class="bg-white/10 hover:bg-white/20 px-2.5 py-1 rounded-lg transition-colors text-xs font-medium border border-white/20">
                        Espace pro
                    </a>
                }
            </nav>
        </div>
    </header>

    <main class="flex-1 max-w-4xl mx-auto w-full px-4 py-4">
        @Body
    </main>

    <footer class="border-t border-slate-200 bg-white/60 text-center text-[11px] text-gray-400 py-2">
        NutriPlan &mdash; Cahier de suivi alimentaire
    </footer>
</div>

@code {
    protected override void OnInitialized()
    {
        Session.OnChange += StateHasChanged;
    }

    void Logout()
    {
        Session.LogoutNutritionist();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }
}
